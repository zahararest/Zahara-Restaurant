---
// /admin/colors — the palette editor.
//
// HOW IT WORKS
//   • The preview on the right is the REAL site (/, /menu/, …) in a frame,
//     loaded with ?zp=1 so analytics skip it. The palette being edited is
//     injected into that frame as the last <style> in its <head> — the same
//     :root{…} + html[data-theme="dark"]{…} shape the live site gets from the
//     middleware — so what the preview shows is exactly what visitors will see.
//   • Nothing is published until Save (⌘S). Every change is one undo step.
//   • "Show" finds every element that uses a colour by reading the frame's own
//     stylesheets (including var() chains like --button-hover-color → --accent),
//     outlines them and scrolls to them. Hover-only styles are forced on for the
//     demo. If the colour isn't on the page being viewed, the preview moves to a
//     page that has it (see `page` in src/data/admin-colors.ts).
//   • Venues: each venue saves its own overrides. The rooftop's untouched
//     colours inherit Zahara's saved palette on the live site, so the editor
//     starts the rooftop from exactly that.
//
// The preset data below is checked by scripts/validate-colors.mjs — run it after
// editing tokens, presets or PRESET_META.

import '../../styles/admin-colors.css';
import { groups, defaults, darkDefaults } from '../../data/admin-colors';
// The admin's section list, shared with the header every other /admin/* page
// renders (functions/admin/chrome.ts).
import { ADMIN_NAV } from '../../../functions/admin/chrome';

// Admin is single-rooted at /admin (the venue is chosen by the site-switch
// cookie, not the URL). The dual-base build would otherwise emit an orphan copy
// at /rooftop/admin/colors — redirect it back to the canonical one.
if (import.meta.env.BASE_URL.startsWith('/rooftop')) {
  return Astro.redirect('/admin/colors/');
}
---

<!doctype html>
<html lang="en" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Colours · Admin</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
</head>
<body>

<header class="topnav">
  <a class="topnav__brand" href="/admin/"><span class="topnav__venuename" data-venue-name>Zahara</span> · Admin</a>
  {ADMIN_NAV.map((n) => (
    <a class={`topnav__link${n.id === 'colors' ? ' is-active' : ''}`}
       href={n.href} aria-current={n.id === 'colors' ? 'page' : undefined}>{n.label}</a>
  ))}
  <span class="topnav__spacer"></span>
  <div class="topnav__venue" role="group" aria-label="Venue being edited">
    <span class="topnav__venue-label">Editing</span>
    <span class="topnav__venue-btns">
      <button type="button" data-venue-btn="zahara">Zahara</button>
      <button type="button" data-venue-btn="rooftop">Rooftop</button>
    </span>
  </div>
  <a class="topnav__site" href="/" target="_blank" rel="noopener" data-view-site>View site ↗</a>
</header>
<script is:inline>(function () {
  var m = document.cookie.match(/(?:^|;\s*)zahara_admin_site=(rooftop|zahara)/);
  var now = m ? m[1] : 'zahara';
  var name = now === 'rooftop' ? 'Nucha Rooftop' : 'Zahara';
  // Tint the whole editor for the venue being edited before anything paints.
  document.documentElement.setAttribute('data-venue', now);
  document.title = name + ' · Colours · Admin';
  var el = document.querySelector('[data-venue-name]'); if (el) el.textContent = name;
  var site = document.querySelector('[data-view-site]'); if (site) site.setAttribute('href', now === 'rooftop' ? '/rooftop/' : '/');
  document.querySelectorAll('[data-venue-btn]').forEach(function (b) {
    var v = b.getAttribute('data-venue-btn');
    b.classList.toggle('is-active', v === now);
    b.addEventListener('click', function () {
      if (v === now) return;
      if (window.__zpDirty && window.__zpDirty() &&
          !confirm('You have unsaved colour changes for ' + name + '. Switch venue and lose them?')) return;
      window.__zpLeaving = true;
      document.cookie = 'zahara_admin_site=' + v + ';path=/admin;max-age=31536000;samesite=lax';
      location.reload();
    });
  });
})();</script>

<div class="bar">
  <div class="bar__title">
    <h1>Colours</h1>
    <span class="bar__venue" data-venue-chip>Zahara</span>
  </div>
  <div class="seg" role="group" aria-label="Palette you are editing">
    <button type="button" data-mode="light" aria-pressed="true">☀︎ Light</button>
    <button type="button" data-mode="dark" aria-pressed="false">☾ Dark</button>
  </div>
  <p class="bar__hint">Visitors see <strong>dark</strong> unless they switch the site to light.</p>
  <span class="bar__spacer"></span>
  <button type="button" class="legib" data-legib hidden></button>
  <div class="bar__group">
    <button type="button" class="icon-btn" data-undo disabled title="Undo (⌘Z)" aria-label="Undo">
      <svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7.5 4.5 3.5 8.5l4 4"/><path d="M3.5 8.5h8a5 5 0 0 1 0 10h-3"/></svg>
    </button>
    <button type="button" class="icon-btn" data-redo disabled title="Redo (⇧⌘Z)" aria-label="Redo">
      <svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12.5 4.5 4 4-4 4"/><path d="M16.5 8.5h-8a5 5 0 0 0 0 10h3"/></svg>
    </button>
  </div>
  <button type="button" class="btn" data-review title="See every change before saving">
    Review changes <span class="btn__count" data-review-count hidden>0</span>
  </button>
  <button type="button" class="btn btn--primary" data-save disabled title="Publish to the live site (⌘S)">Save</button>
  <div class="menu">
    <button type="button" class="icon-btn" data-more aria-haspopup="menu" aria-expanded="false" aria-label="More" title="More">⋯</button>
    <div class="menu__list" role="menu" data-more-menu hidden>
      <button type="button" role="menuitem" data-action="legibility">Check legibility</button>
      <button type="button" role="menuitem" data-action="export">Export as CSS</button>
      <hr />
      <button type="button" role="menuitem" data-action="reset-mode">Reset <span data-mode-word>light</span> to defaults</button>
    </div>
  </div>
</div>

<main class="editor">
  <section class="panel" aria-label="Palette controls">
    <nav class="tabs" role="tablist" aria-label="Ways to change the palette">
      <button type="button" role="tab" aria-selected="true" data-tab="themes">Themes</button>
      <button type="button" role="tab" aria-selected="false" data-tab="mix">Mix</button>
      <button type="button" role="tab" aria-selected="false" data-tab="tune">Fine-tune</button>
    </nav>

    <div class="tabpanel" data-panel="themes" role="tabpanel">
      <p class="lead">Start from a theme. <strong>Hover</strong> one to try it on the preview, <strong>click</strong> to use it. Nothing goes live until you save.</p>
      <div class="chips" role="group" aria-label="Filter themes">
        <button type="button" class="chip" data-mood="all" aria-pressed="true">All</button>
        <button type="button" class="chip" data-mood="lively" aria-pressed="false">Lively</button>
        <button type="button" class="chip" data-mood="calm" aria-pressed="false">Calm</button>
      </div>
      <div class="themes" data-themes></div>
    </div>

    <div class="tabpanel tabpanel--mix" data-panel="mix" role="tabpanel" hidden>
      <p class="lead">Build a palette from parts of others. For each part, pick <strong>any colour group of any theme</strong> — a theme’s lines as your backgrounds, its accent as your text. The preview shows the result as you go.</p>
      <div class="mix" data-mix></div>
      <label class="check" style="margin-bottom:1rem">
        <input type="checkbox" data-mix-derive checked />
        Keep the page background and Events band matched
      </label>
      <div class="mixfoot" data-mix-foot hidden>
        <div class="mixfoot__top">
          <span class="mixfoot__count" data-mix-count></span>
          <span class="mixfoot__warn" data-mix-warn></span>
          <span class="bar__spacer"></span>
          <button type="button" class="btn btn--link" data-mix-diff-toggle aria-expanded="false">See what changes</button>
        </div>
        <div class="diff" data-mix-diff hidden></div>
        <div class="mixfoot__btns">
          <button type="button" class="btn btn--ghost" data-mix-clear>Clear</button>
          <button type="button" class="btn btn--primary" data-mix-apply>Apply to palette</button>
        </div>
      </div>
    </div>

    <div class="tabpanel" data-panel="tune" role="tabpanel" hidden>
      <div class="tune__tools">
        <input class="search" type="search" placeholder="Find a colour…" data-tune-search aria-label="Find a colour" />
        <label class="check"><input type="checkbox" data-tune-changed /> Changed</label>
      </div>
      <p class="lead">Click a <strong>swatch</strong> to change it. Click a <strong>name</strong> to see where it’s used.</p>
      <div data-tune></div>
    </div>
  </section>

  <section class="stage" aria-label="Live preview">
    <div class="stage__bar">
      <div class="seg" role="tablist" aria-label="Page" data-pages></div>
      <div class="seg" role="group" aria-label="Language">
        <button type="button" data-lang="he" aria-pressed="true">עב</button>
        <button type="button" data-lang="en" aria-pressed="false">EN</button>
      </div>
      <div class="seg" role="group" aria-label="Device">
        <button type="button" data-device-btn="desktop" aria-pressed="true">Desktop</button>
        <button type="button" data-device-btn="phone" aria-pressed="false">Phone</button>
      </div>
      <span class="stage__spacer"></span>
      <div class="menu">
        <button type="button" class="btn btn--small" data-overlays aria-haspopup="menu" aria-expanded="false">Show on page ▾</button>
        <div class="menu__list" role="menu" data-overlays-menu hidden>
          <p class="menu__note">Open parts of the site that normally appear on their own.</p>
          <label><input type="checkbox" data-overlay="popup" /> Entry popup</label>
          <label><input type="checkbox" data-overlay="consent" /> Cookie banner</label>
          <label><input type="checkbox" data-overlay="a11y" /> Accessibility panel</label>
          <label data-overlay-phone-only><input type="checkbox" data-overlay="menu" /> Phone menu</label>
          <label><input type="checkbox" data-overlay="status" /> Form messages</label>
        </div>
      </div>
      <button type="button" class="btn btn--small" data-compare title="Press and hold to see the colours that are live now">Hold: live colours</button>
    </div>
    <div class="stage__note" data-stage-note hidden></div>
    <div class="stage__view" data-view>
      <div class="stage__device" data-device>
        <iframe data-frame title="Site preview" tabindex="0"></iframe>
        <div class="hits" data-hits></div>
      </div>
      <div class="stage__loading" data-loading>Loading the preview…</div>
      <div class="locator" data-locator hidden>
        <span class="locator__dot"></span>
        <span class="locator__text" data-loc-text></span>
        <span class="locator__pos" data-loc-pos></span>
        <button type="button" data-loc-prev aria-label="Previous place">‹</button>
        <button type="button" data-loc-next aria-label="Next place">›</button>
        <button type="button" data-loc-close aria-label="Stop showing">×</button>
      </div>
    </div>
  </section>
</main>

<div class="scrim" data-scrim hidden></div>

<aside class="drawer" data-drawer hidden role="dialog" aria-label="Review changes" aria-modal="true">
  <header class="drawer__head">
    <h2>Review changes</h2>
    <span class="bar__spacer"></span>
    <button type="button" class="icon-btn" data-drawer-close aria-label="Close">×</button>
  </header>
  <div class="drawer__body" data-drawer-body></div>
  <footer class="drawer__foot">
    <button type="button" class="btn btn--ghost" data-discard>Discard all</button>
    <span class="bar__spacer"></span>
    <button type="button" class="btn btn--primary" data-drawer-save>Save</button>
  </footer>
</aside>

<div class="modal" data-export hidden role="dialog" aria-label="Export CSS" aria-modal="true">
  <h2>Export as CSS</h2>
  <p>Only needed to bake the palette into the code (<code>src/styles/tokens.css</code>). Saving already publishes it.</p>
  <div class="seg" role="group" aria-label="What to export">
    <button type="button" data-export-kind="full" aria-pressed="true">Whole palette</button>
    <button type="button" data-export-kind="changed" aria-pressed="false">Changed from defaults</button>
  </div>
  <textarea readonly data-export-text></textarea>
  <div class="modal__row">
    <button type="button" class="btn btn--ghost" data-export-close>Close</button>
    <button type="button" class="btn btn--primary" data-export-copy>Copy</button>
  </div>
</div>

<div class="cpop" data-cpop hidden role="dialog" aria-label="Change colour">
  <div class="cpop__head"><strong data-cpop-title></strong><code data-cpop-token></code></div>
  <p class="cpop__hint" data-cpop-hint></p>
  <div class="cpop__pick">
    <input class="cpop__color" type="color" data-cpop-color aria-label="Colour picker" />
    <input class="cpop__hex" type="text" maxlength="7" spellcheck="false" autocomplete="off" data-cpop-hex aria-label="Hex value" />
  </div>
  <p class="cpop__contrast" data-cpop-contrast></p>
  <p class="cpop__label">From this palette</p>
  <div class="cpop__swatches" data-cpop-swatches></div>
  <div class="cpop__actions">
    <button type="button" class="btn btn--small" data-cpop-locate>Show where it’s used</button>
    <button type="button" class="btn btn--small btn--ghost" data-cpop-reset>Reset</button>
  </div>
</div>

<div class="srcpick" data-srcpick hidden role="dialog" aria-label="Choose colours">
  <div class="srcpick__head">
    <p class="srcpick__title" data-srcpick-title></p>
    <p class="srcpick__sub">Pick a colour group from any theme. Adapt keeps your current brightness so text stays readable.</p>
    <div class="srcpick__tools">
      <input class="srcpick__search" type="search" placeholder="Search themes…" data-srcpick-search aria-label="Search themes" />
      <div class="seg seg--small" role="group" aria-label="Which themes">
        <button type="button" data-srcpick-scope="mode" aria-pressed="true">This mode</button>
        <button type="button" data-srcpick-scope="all" aria-pressed="false">All</button>
      </div>
    </div>
  </div>
  <div class="srcpick__list" data-srcpick-list></div>
</div>

<div class="toast" data-toast role="status" aria-live="polite"><span data-toast-text></span><button type="button" data-toast-action hidden></button></div>

<script is:inline define:vars={{ groups, defaults, darkDefaults }}>
(function () {
  'use strict';

  // ═══ TOKENS ════════════════════════════════════════════════════════════════
  const TOKENS = groups.flatMap((g) => g.tokens.map((t) => Object.assign({ group: g.group, advanced: !!g.advanced }, t)));
  const TOKEN = Object.fromEntries(TOKENS.map((t) => [t.token, t]));
  const COLOR_TOKENS = TOKENS.filter((t) => t.kind !== 'scalar').map((t) => t.token);
  const isScalar = (tk) => !!TOKEN[tk] && TOKEN[tk].kind === 'scalar';
  const labelOf = (tk) => (TOKEN[tk] ? TOKEN[tk].label : tk);

  // Below this ratio text effectively disappears — the one case worth shouting
  // about. Between here and the AA target is a quiet "check this".
  const SEVERE_BELOW = 2;

  // Every place the SITE puts one colour on another (checked against the live
  // stylesheets). big:true = large text or a graphic mark, where 3:1 is enough.
  const PAIRINGS = [
    { fg: '--ink',            bg: '--paper',            where: 'Headlines and body copy on the page' },
    { fg: '--ink-soft',       bg: '--paper',            where: 'Paragraph text on the page' },
    { fg: '--ink-muted',      bg: '--paper',            where: 'Labels above headings, captions' },
    { fg: '--ink',            bg: '--paper-card',       where: 'Dish names inside menu cards, form text' },
    { fg: '--ink-soft',       bg: '--paper-card',       where: 'Descriptions inside menu cards' },
    { fg: '--ink-muted',      bg: '--paper-card',       where: 'Form labels and wine regions on cards' },
    { fg: '--ink-muted',      bg: '--paper-deep',       where: 'Footer labels' },
    { fg: '--ink',            bg: '--paper-deep',       where: 'Footer details' },
    { fg: '--accent',         bg: '--paper',            where: 'Accent marks and links on the page', big: true },
    { fg: '--accent',         bg: '--paper-card',       where: 'Prices inside menu cards', big: true },
    { fg: '--accent-deep',    bg: '--paper',            where: 'Accent links on hover' },
    { fg: '--ok',             bg: '--paper-card',       where: 'Contact form success message' },
    { fg: '--err',            bg: '--paper-card',       where: 'Contact form error message' },
    { fg: '--ink',            bg: '--accent-soft',      where: 'Selected text' },
    { fg: '--paper',          bg: '--ink',              where: 'Label inside dark buttons' },
    { fg: '--on-accent',      bg: '--accent',           where: 'Button labels on hover, floating Reserve button' },
    { fg: '--paper-on-photo', bg: '--shadow',           where: 'Text over photos', big: true },
    { fg: '--tile-label',     bg: '--shadow',           where: 'Home menu tile names', big: true },
    { fg: '--events-band-text', bg: '--events-band-from', where: 'Events band text (top)', big: true },
    { fg: '--events-band-text', bg: '--events-band-to',   where: 'Events band text (bottom)', big: true },
    { fg: '--ink-soft',       bg: '--bg-wash-to',       where: 'Body text over the background wash' },
  ];

  // ═══ PRESETS ═══════════════════════════════════════════════════════════════
  // Each preset is a partial palette. Tokens a preset omits (the Events band,
  // the page background, text on accent, the menu tiles) are DERIVED from its
  // own colours when applied, so every theme lands complete and harmonised.
  const PRESETS = {
    // ── Lively themes — saturated, sunny, built for the rooftop but open to both venues.
    //    Generated with contrast enforced for every pairing the editor checks.

    // Sunset Terrace — peach + coral.
    'sunset-terrace': {
      '--paper': '#FFECE0', '--paper-deep': '#F9DDCA', '--paper-edge': '#E6C9B6', '--paper-card': '#FFF6F0', '--paper-on-photo': '#FDF1E9',
      '--ink': '#22110B', '--ink-soft': '#523D35', '--ink-muted': '#775D4C', '--ink-faint': '#C1A492', '--rule': '#E7C6B1',
      '--rule-soft': '#F5D7C4', '--accent': '#C63B20', '--accent-deep': '#9D2207', '--accent-soft': '#FFD2C8', '--on-accent': '#FDF1E9',
      '--gold': '#E49921', '--ok': '#21763C', '--err': '#AC312A', '--shadow': '#0B0401',
    },

    // Citrus Spritz — lemon + Aperol orange.
    'citrus-spritz': {
      '--paper': '#F8F1CF', '--paper-deep': '#ECE4BD', '--paper-edge': '#D8D0A8', '--paper-card': '#FDF9E1', '--paper-on-photo': '#F7F4E5',
      '--ink': '#201308', '--ink-soft': '#503E31', '--ink-muted': '#6B643F', '--ink-faint': '#B4AC85', '--rule': '#D8CFA1',
      '--rule-soft': '#E7DFB6', '--accent': '#D55D00', '--accent-deep': '#A94800', '--accent-soft': '#FFD3BE', '--on-accent': '#201308',
      '--gold': '#87B73A', '--ok': '#21763C', '--err': '#AC312A', '--shadow': '#080600',
    },

    // Aegean — sky + cobalt.
    'aegean': {
      '--paper': '#E0F4FF', '--paper-deep': '#CFE7F5', '--paper-edge': '#BAD4E2', '--paper-card': '#F0FAFF', '--paper-on-photo': '#EBF5FB',
      '--ink': '#0C1626', '--ink-soft': '#364357', '--ink-muted': '#4B6877', '--ink-faint': '#96AFBD', '--rule': '#B6D3E3',
      '--rule-soft': '#C9E3F1', '--accent': '#285CC2', '--accent-deep': '#134098', '--accent-soft': '#CDDFFF', '--on-accent': '#EBF5FB',
      '--gold': '#E6B816', '--ok': '#21763C', '--err': '#AC312A', '--shadow': '#02070B',
    },

    // Flamingo — blush + hot pink.
    'flamingo': {
      '--paper': '#FFEAED', '--paper-deep': '#FAD9DE', '--paper-edge': '#E7C6CA', '--paper-card': '#FFF5F6', '--paper-on-photo': '#FEEFF1',
      '--ink': '#201018', '--ink-soft': '#503B45', '--ink-muted': '#775A5F', '--ink-faint': '#C1A1A6', '--rule': '#E8C3C8',
      '--rule-soft': '#F6D4D9', '--accent': '#C72B78', '--accent-deep': '#9D0F5B', '--accent-soft': '#FFCFDF', '--on-accent': '#FEEFF1',
      '--gold': '#F68C36', '--ok': '#21763C', '--err': '#AC312A', '--shadow': '#0C0405',
    },

    // Mojito — mint + emerald.
    'mojito': {
      '--paper': '#DDF8E8', '--paper-deep': '#CDECDA', '--paper-edge': '#B9D8C6', '--paper-card': '#EAFDF2', '--paper-on-photo': '#EAF7EF',
      '--ink': '#061A14', '--ink-soft': '#304840', '--ink-muted': '#4E6B5B', '--ink-faint': '#95B3A2', '--rule': '#B4D8C3',
      '--rule-soft': '#C7E7D5', '--accent': '#007D4D', '--accent-deep': '#005D37', '--accent-soft': '#C4E8D2', '--on-accent': '#EAF7EF',
      '--gold': '#9FC93E', '--ok': '#21763C', '--err': '#AC312A', '--shadow': '#010804',
    },

    // Lagoon — aqua + turquoise.
    'lagoon': {
      '--paper': '#D8F7F8', '--paper-deep': '#C8EBEC', '--paper-edge': '#B3D8D8', '--paper-card': '#E7FDFD', '--paper-on-photo': '#E8F7F7',
      '--ink': '#011A21', '--ink-soft': '#2A4751', '--ink-muted': '#466B6C', '--ink-faint': '#8FB3B3', '--rule': '#AED7D8',
      '--rule-soft': '#C2E6E7', '--accent': '#007A7B', '--accent-deep': '#005A5B', '--accent-soft': '#BCE8E8', '--on-accent': '#E8F7F7',
      '--gold': '#F59926', '--ok': '#21763C', '--err': '#AC312A', '--shadow': '#000808',
    },

    // Berry Sorbet — lilac + berry.
    'berry-sorbet': {
      '--paper': '#FDE9FB', '--paper-deep': '#F1DBF0', '--paper-edge': '#DEC7DC', '--paper-card': '#FFF4FE', '--paper-on-photo': '#FAF0F9',
      '--ink': '#1D1120', '--ink-soft': '#4C3C4F', '--ink-muted': '#725C71', '--ink-faint': '#B9A3B7', '--rule': '#DEC4DC',
      '--rule-soft': '#EDD6EB', '--accent': '#A93085', '--accent-deep': '#831765', '--accent-soft': '#FBCFE9', '--on-accent': '#FAF0F9',
      '--gold': '#F0986F', '--ok': '#21763C', '--err': '#AC312A', '--shadow': '#090409',
    },


    { id: 'cognac-night',   mode: 'dark',  mood: 'calm', name: 'Cognac Night',       note: 'leather brown + cognac' },
    { id: 'supper-club',    mode: 'dark',  mood: 'calm', name: 'Supper Club',        note: 'forest green + brick red' },
    { id: 'default',        mode: 'dark',  mood: 'calm', name: 'Zahara default',     note: 'the house palette' },
  ];

  // The parts of a palette the mixer works with, and the colour groups a theme
  // offers as a source. `cap` limits how colourful an adapted part may get
  // (OKLCH chroma), per mode, so tinted backgrounds stay backgrounds.
  const ROLES = [
    { id: 'surfaces',  label: 'Backgrounds', hint: 'Page, bands, cards',         tokens: ['--paper', '--paper-deep', '--paper-card', '--paper-edge'], cap: { light: 0.08, dark: 0.1 } },
    { id: 'text',      label: 'Text',        hint: 'Headings down to labels',    tokens: ['--ink', '--ink-soft', '--ink-muted', '--ink-faint'],   cap: { light: 0.08, dark: 0.07 } },
    { id: 'lines',     label: 'Lines',       hint: 'Borders and dividers',       tokens: ['--rule', '--rule-soft'],                                cap: { light: 0.12, dark: 0.12 } },
    { id: 'accent',    label: 'Accent',      hint: 'Prices, links, buttons',     tokens: ['--accent', '--accent-deep', '--accent-soft'],           cap: { light: 0.35, dark: 0.35 } },
    { id: 'highlight', label: 'Highlight',   hint: 'Progress bar, photo links',  tokens: ['--gold'],                                               cap: { light: 0.35, dark: 0.35 } },
    { id: 'photos',    label: 'Over photos', hint: 'Text and shade on photos',   tokens: ['--paper-on-photo', '--shadow'],                         cap: { light: 0.04, dark: 0.04 } },
    { id: 'status',    label: 'Messages',    hint: 'Form success and error',     tokens: ['--ok', '--err'],                                        cap: { light: 0.25, dark: 0.25 } },
  ];

  // ═══ COLOUR MATHS ══════════════════════════════════════════════════════════
  function normHex(v) {
    if (v == null) return null;
    v = String(v).trim();
    if (!v.startsWith('#')) v = '#' + v;
    if (/^#[0-9a-fA-F]{3}$/.test(v)) v = '#' + v[1] + v[1] + v[2] + v[2] + v[3] + v[3];
    return /^#[0-9a-fA-F]{6}$/.test(v) ? v.toUpperCase() : null;
  }
  function normScalar(tk, v) {
    const n = Number(String(v).trim());
    if (!Number.isFinite(n)) return null;
    const t = TOKEN[tk];
    return String(Math.round(Math.min(t.max, Math.max(t.min, n))));
  }
  const norm = (tk, v) => (isScalar(tk) ? normScalar(tk, v) : normHex(v));

  function relLum(hex) {
    const n = parseInt(hex.slice(1), 16);
    return [n >> 16 & 255, n >> 8 & 255, n & 255]
      .map((c) => { c /= 255; return c <= 0.03928 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4); })
      .reduce((s, c, i) => s + c * [0.2126, 0.7152, 0.0722][i], 0);
  }
  function contrast(a, b) {
    const x = relLum(a), y = relLum(b);
    return (Math.max(x, y) + 0.05) / (Math.min(x, y) + 0.05);
  }
  const lin = (c) => { c /= 255; return c <= 0.04045 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4); };
  function toOklch(hex) {
    const n = parseInt(hex.slice(1), 16);
    const r = lin(n >> 16 & 255), g = lin(n >> 8 & 255), b = lin(n & 255);
    const l = Math.cbrt(0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b);
    const m = Math.cbrt(0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b);
    const s = Math.cbrt(0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b);
    const L = 0.2104542553 * l + 0.7936177850 * m - 0.0040720468 * s;
    const A = 1.9779984951 * l - 2.4285922050 * m + 0.4505937099 * s;
    const B = 0.0259040371 * l + 0.7827717662 * m - 0.8086757660 * s;
    let H = Math.atan2(B, A) * 180 / Math.PI; if (H < 0) H += 360;
    return { L, C: Math.hypot(A, B), H };
  }
  function oklchToLinear(L, C, H) {
    const a = C * Math.cos(H * Math.PI / 180), b = C * Math.sin(H * Math.PI / 180);
    const l = Math.pow(L + 0.3963377774 * a + 0.2158037573 * b, 3);
    const m = Math.pow(L - 0.1055613458 * a - 0.0638541728 * b, 3);
    const s = Math.pow(L - 0.0894841775 * a - 1.2914855480 * b, 3);
    return [4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s,
            -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s,
            -0.0041960863 * l - 0.7034186147 * m + 1.7076147010 * s];
  }
  function fromOklch(L, C, H) {
    const ok = (rgb) => rgb.every((v) => v >= -0.0005 && v <= 1.0005);
    let rgb = oklchToLinear(L, C, H);
    if (!ok(rgb)) {            // keep hue and lightness; give up chroma to fit sRGB
      let lo = 0, hi = C;
      for (let i = 0; i < 22; i++) { const mid = (lo + hi) / 2; if (ok(oklchToLinear(L, mid, H))) lo = mid; else hi = mid; }
      rgb = oklchToLinear(L, lo, H);
    }
    return '#' + rgb.map((v) => {
      v = Math.min(1, Math.max(0, v));
      const s = v <= 0.0031308 ? 12.92 * v : 1.055 * Math.pow(v, 1 / 2.4) - 0.055;
      return Math.round(s * 255).toString(16).padStart(2, '0');
    }).join('').toUpperCase();
  }

  // ═══ STATE ═════════════════════════════════════════════════════════════════
  const ADMIN_SITE = (document.cookie.match(/(?:^|;\s*)zahara_admin_site=(rooftop|zahara)/) || [])[1] || 'zahara';
  const IS_ROOFTOP = ADMIN_SITE === 'rooftop';
  const VENUE_NAME = IS_ROOFTOP ? 'Nucha Rooftop' : 'Zahara';
  // The public site replays this cache in the owner's browser right after a
  // save (BaseLayout pre-paint), one key per venue so they never cross.
  const CACHE_KEY = IS_ROOFTOP ? 'zahara-color-overrides:rooftop' : 'zahara-color-overrides';
  const MODES = ['light', 'dark'];

  const emptyPair = () => ({ light: {}, dark: {} });
  const clonePair = (p) => ({ light: Object.assign({}, p.light), dark: Object.assign({}, p.dark) });
  function toPair(raw) {
    const out = emptyPair();
    if (!raw || typeof raw !== 'object') return out;
    const flat = Object.keys(raw).some((k) => k.indexOf('--') === 0);
    const src = flat ? { light: raw } : raw;
    MODES.forEach((mode) => {
      const m = src[mode];
      if (!m || typeof m !== 'object') return;
      Object.keys(m).forEach((tk) => {
        if (!TOKEN[tk]) return;
        const v = norm(tk, m[tk]);
        if (v != null) out[mode][tk] = v;
      });
    });
    return out;
  }

  // What an untouched token shows, per mode: the code defaults — and for the
  // rooftop, Zahara's saved palette on top (the live site inherits it).
  const CODE = { light: {}, dark: {} };
  TOKENS.forEach((t) => {
    CODE.light[t.token] = norm(t.token, defaults[t.token]);
    CODE.dark[t.token] = norm(t.token, darkDefaults[t.token] != null ? darkDefaults[t.token] : defaults[t.token]);
  });
  let inherited = emptyPair();     // rooftop: Zahara's saved overrides
  let saved = emptyPair();         // this venue's overrides as saved
  let current = emptyPair();       // … including unsaved edits
  let draft = null;                // { mode, map, source: 'theme'|'mix', label } — preview only
  let comparing = false;           // holding "live colours"
  let activeMode = 'light';

  const base = (mode, tk) => (inherited[mode][tk] != null ? inherited[mode][tk] : CODE[mode][tk]);
  const resolved = (mode, tk) => (current[mode][tk] != null ? current[mode][tk] : base(mode, tk));
  const savedValue = (mode, tk) => (saved[mode][tk] != null ? saved[mode][tk] : base(mode, tk));
  function shown(mode, tk) {
    if (comparing) return savedValue(mode, tk);
    if (draft && draft.mode === mode && draft.map[tk] != null) return draft.map[tk];
    return resolved(mode, tk);
  }
  function setOverride(mode, tk, value) {
    if (value == null || value === base(mode, tk)) delete current[mode][tk];
    else current[mode][tk] = value;
  }
  function pendingList() {
    const out = [];
    MODES.forEach((mode) => TOKENS.forEach((t) => {
      if (resolved(mode, t.token) !== savedValue(mode, t.token)) out.push({ mode, tk: t.token });
    }));
    return out;
  }
  window.__zpDirty = () => pendingList().length > 0;

  function readCache() { try { return toPair(JSON.parse(localStorage.getItem(CACHE_KEY) || '{}')); } catch (_) { return emptyPair(); } }
  function writeCache(p) { try { localStorage.setItem(CACHE_KEY, JSON.stringify(p)); } catch (_) {} }

  // ═══ HISTORY — every user action is ONE undo step ═════════════════════════
  const undoStack = [], redoStack = [];
  /** Apply [{mode, tk, value}] as one step. `merge` folds a stream of inputs
   *  (dragging a picker or a slider) into the step it started. */
  function commit(label, changes, opts) {
    opts = opts || {};
    const top = undoStack[undoStack.length - 1];
    const merging = opts.merge && top && top.merge === opts.merge && Date.now() - top.at < 1500;
    const tx = merging ? top : { label, items: [], merge: opts.merge || null, at: Date.now() };
    let changed = false;
    changes.forEach((c) => {
      const v = norm(c.tk, c.value);
      if (v == null || v === resolved(c.mode, c.tk)) return;
      const existing = tx.items.find((i) => i.mode === c.mode && i.tk === c.tk);
      const before = current[c.mode][c.tk];
      setOverride(c.mode, c.tk, v);
      if (existing) existing.after = current[c.mode][c.tk];
      else tx.items.push({ mode: c.mode, tk: c.tk, before, after: current[c.mode][c.tk] });
      changed = true;
    });
    if (!changed) return false;
    tx.at = Date.now();
    if (!merging) { undoStack.push(tx); if (undoStack.length > 150) undoStack.shift(); }
    redoStack.length = 0;
    refresh();
    return tx;
  }
  function restore(items, key) {
    items.forEach((i) => {
      const v = i[key];
      if (v == null) delete current[i.mode][i.tk]; else current[i.mode][i.tk] = v;
    });
  }
  function undo() {
    const tx = undoStack.pop(); if (!tx) return;
    restore(tx.items.slice().reverse(), 'before'); redoStack.push(tx);
    showModeOf(tx); refresh(); toast('Undid: ' + tx.label);
  }
  function redo() {
    const tx = redoStack.pop(); if (!tx) return;
    restore(tx.items, 'after'); undoStack.push(tx);
    showModeOf(tx); refresh(); toast('Redid: ' + tx.label);
  }
  function showModeOf(tx) {
    const modes = new Set(tx.items.map((i) => i.mode));
    if (!modes.has(activeMode) && modes.size === 1) setMode([...modes][0]);
  }

  // ═══ DOM REFS ══════════════════════════════════════════════════════════════
  const $ = (s, r) => (r || document).querySelector(s);
  const $$ = (s, r) => Array.from((r || document).querySelectorAll(s));
  const el = {
    undo: $('[data-undo]'), redo: $('[data-redo]'), save: $('[data-save]'),
    review: $('[data-review]'), reviewCount: $('[data-review-count]'), legib: $('[data-legib]'),
    more: $('[data-more]'), moreMenu: $('[data-more-menu]'), modeWord: $('[data-mode-word]'),
    themes: $('[data-themes]'), mix: $('[data-mix]'), mixFoot: $('[data-mix-foot]'),
    mixCount: $('[data-mix-count]'), mixWarn: $('[data-mix-warn]'), mixDiff: $('[data-mix-diff]'),
    mixDiffToggle: $('[data-mix-diff-toggle]'), mixDerive: $('[data-mix-derive]'),
    tune: $('[data-tune]'), tuneSearch: $('[data-tune-search]'), tuneChanged: $('[data-tune-changed]'),
    pages: $('[data-pages]'), view: $('[data-view]'), device: $('[data-device]'), frame: $('[data-frame]'),
    hits: $('[data-hits]'), loading: $('[data-loading]'), note: $('[data-stage-note]'),
    locator: $('[data-locator]'), locText: $('[data-loc-text]'), locPos: $('[data-loc-pos]'),
    overlays: $('[data-overlays]'), overlaysMenu: $('[data-overlays-menu]'), compare: $('[data-compare]'),
    scrim: $('[data-scrim]'), drawer: $('[data-drawer]'), drawerBody: $('[data-drawer-body]'),
    exportModal: $('[data-export]'), exportText: $('[data-export-text]'),
    cpop: $('[data-cpop]'), srcpick: $('[data-srcpick]'), srcList: $('[data-srcpick-list]'),
    srcSearch: $('[data-srcpick-search]'), srcTitle: $('[data-srcpick-title]'),
    toast: $('[data-toast]'), toastText: $('[data-toast-text]'), toastAction: $('[data-toast-action]'),
  };
  $('[data-venue-chip]').textContent = VENUE_NAME;
  const esc = (s) => String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

  // ═══ TOAST ═════════════════════════════════════════════════════════════════
  let toastTimer = null;
  function toast(msg, action) {
    el.toastText.textContent = msg;
    if (action) {
      el.toastAction.hidden = false; el.toastAction.textContent = action.label;
      el.toastAction.onclick = () => { action.run(); el.toast.classList.remove('is-on'); };
    } else { el.toastAction.hidden = true; el.toastAction.onclick = null; }
    el.toast.classList.add('is-on');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => el.toast.classList.remove('is-on'), action ? 5000 : 2400);
  }

  // ═══ LEGIBILITY ════════════════════════════════════════════════════════════
  function failures(mode, overlay) {
    const val = (tk) => (overlay && overlay[tk] != null ? overlay[tk] : resolved(mode, tk));
    const out = [];
    PAIRINGS.forEach((p) => {
      const fg = val(p.fg), bg = val(p.bg);
      if (!fg || !bg || fg[0] !== '#' || bg[0] !== '#') return;
      const ratio = contrast(fg, bg), min = p.big ? 3 : 4.5;
      if (ratio < min) out.push({ mode, fg: p.fg, bg: p.bg, fgHex: fg, bgHex: bg, ratio, min, where: p.where, severe: ratio < SEVERE_BELOW });
    });
    return out.sort((a, b) => a.ratio - b.ratio);
  }
  /** Walk a colour towards black or white until it reads on `bg`, keeping its hue. */
  function fixToward(hex, bg, ratio) {
    const toWhite = relLum(bg) < 0.5, o = toOklch(hex);
    for (let i = 0; i <= 60; i++) {
      const L = toWhite ? o.L + (1 - o.L) * i / 60 : o.L * (1 - i / 60);
      const cand = fromOklch(L, o.C, o.H);
      if (contrast(cand, bg) >= ratio) return cand;
    }
    return toWhite ? '#FFFFFF' : '#000000';
  }
  /** The worst pairing a token takes part in, for its row. */
  function worstFor(mode, tk) {
    let worst = null;
    PAIRINGS.forEach((p) => {
      if (p.fg !== tk && p.bg !== tk) return;
      const fg = resolved(mode, p.fg), bg = resolved(mode, p.bg);
      if (!fg || !bg || fg[0] !== '#' || bg[0] !== '#') return;
      const ratio = contrast(fg, bg), min = p.big ? 3 : 4.5;
      if (!worst || ratio / min < worst.ratio / worst.min) worst = { ratio, min, other: p.fg === tk ? p.bg : p.fg };
    });
    return worst;
  }

  // ═══ REFRESH ═══════════════════════════════════════════════════════════════
  let paintRaf = 0;
  function schedulePaint() { if (!paintRaf) paintRaf = requestAnimationFrame(() => { paintRaf = 0; paintFrame(); }); }
  function refresh() {
    schedulePaint();
    const pending = pendingList();
    el.save.disabled = pending.length === 0;
    el.reviewCount.hidden = pending.length === 0;
    el.reviewCount.textContent = String(pending.length);
    el.undo.disabled = undoStack.length === 0;
    el.redo.disabled = redoStack.length === 0;
    el.undo.title = undoStack.length ? 'Undo: ' + undoStack[undoStack.length - 1].label + ' (⌘Z)' : 'Undo (⌘Z)';
    el.redo.title = redoStack.length ? 'Redo: ' + redoStack[redoStack.length - 1].label + ' (⇧⌘Z)' : 'Redo (⇧⌘Z)';
    const fails = failures(activeMode), severe = fails.filter((f) => f.severe).length;
    el.legib.hidden = fails.length === 0;
    el.legib.classList.toggle('is-severe', severe > 0);
    el.legib.textContent = severe ? severe + ' unreadable' : fails.length + ' hard to read';
    renderTune(); markCurrentTheme(); renderMix();
    if (!el.drawer.hidden) renderDrawer();
    if (!el.cpop.hidden && cpopToken) syncCpop();
  }

  // ═══ LOAD ══════════════════════════════════════════════════════════════════
  async function fetchPalette(site) {
    const res = await fetch('/api/palette' + (site === 'rooftop' ? '?site=rooftop' : ''), { cache: 'no-store', credentials: 'same-origin' });
    if (!res.ok) throw new Error('HTTP ' + res.status);
    return toPair(await res.json());
  }
  saved = readCache();
  current = clonePair(saved);
  (async function load() {
    try {
      const [own, zahara] = await Promise.all([fetchPalette(ADMIN_SITE), IS_ROOFTOP ? fetchPalette('zahara') : null]);
      if (zahara) inherited = zahara;
      saved = own;
      if (!undoStack.length) current = clonePair(saved);
      writeCache(saved);
      refresh();
    } catch (err) {
      console.warn('[colors] could not load the saved palette', err);
      toast('Couldn’t reach the server — showing the last palette this browser saw.');
    }
  })();

  // ═══ SAVE / DISCARD ════════════════════════════════════════════════════════
  let saving = false;
  let bc = null; try { bc = new BroadcastChannel('zahara-colors'); } catch (_) {}
  async function save() {
    if (saving || !pendingList().length) return;
    saving = true;
    el.save.disabled = true; el.save.textContent = 'Saving…';
    try {
      const res = await fetch('/admin/colors/save', {
        method: 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'same-origin',
        body: JSON.stringify(current),
      });
      if (!res.ok) {
        let msg = 'HTTP ' + res.status;
        try { msg = (await res.json()).error || msg; } catch (_) {}
        throw new Error(msg);
      }
      saved = clonePair(current);
      writeCache(saved);
      if (bc) bc.postMessage({ type: 'colors-changed', site: ADMIN_SITE, overrides: saved });
      toast('Saved — ' + VENUE_NAME + ' shows these colours within a minute.');
      closeDrawer();
    } catch (err) {
      console.error('[colors] save failed', err);
      toast('Save failed: ' + err.message);
    } finally {
      saving = false; el.save.textContent = 'Save'; refresh();
    }
  }
  function discardAll() {
    const items = pendingList();
    if (!items.length) return;
    commit('Discard changes', items.map((i) => ({ mode: i.mode, tk: i.tk, value: savedValue(i.mode, i.tk) })));
    toast('Changes discarded', { label: 'Undo', run: undo });
  }
  window.addEventListener('beforeunload', (e) => {
    if (window.__zpLeaving || !pendingList().length) return;
    e.preventDefault(); e.returnValue = '';
  });

  // ═══ MODE ══════════════════════════════════════════════════════════════════
  function setMode(mode) {
    if (mode === activeMode) return;
    activeMode = mode;
    if (draft && draft.mode !== mode) { draft = null; hideNote(); }
    $$('[data-mode]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.mode === mode)));
    el.modeWord.textContent = mode;
    clearLocate();
    lockTheme();
    renderThemes();
    refresh();
  }
  $$('[data-mode]').forEach((b) => b.addEventListener('click', () => setMode(b.dataset.mode)));

  // ═══ PREVIEW FRAME ═════════════════════════════════════════════════════════
  const PAGES = [
    { id: 'home',    label: 'Home',    path: '/' },
    { id: 'menu',    label: 'Menu',    path: '/menu/' },
    { id: 'events',  label: 'Events',  path: '/events/' },
    { id: 'about',   label: 'About',   path: '/about/' },
    // One portal for both venues, always dark, always Zahara's palette.
    { id: 'reserve', label: 'Reserve', path: '/reserve/', zaharaOnly: true },
  ];
  const DESKTOP_W = 1280, PHONE_W = 390;
  let page = 'home', lang = 'he', device = 'desktop';
  let fwin = null, fdoc = null, frameReady = false, paletteStyle = null, stateStyle = null, themeObserver = null;
  let pendingLocate = null, stageScale = 1;
  const ownerThemePref = (() => { try { return localStorage.getItem('zahara-theme'); } catch (_) { return null; } })();

  const pageAvailable = (id) => !(IS_ROOFTOP && (PAGES.find((p) => p.id === id) || {}).zaharaOnly);
  function pageUrl(id, hash) {
    const p = PAGES.find((x) => x.id === id);
    const venue = IS_ROOFTOP && !p.zaharaOnly ? '/rooftop' : '';
    const langPart = lang === 'en' && id !== 'reserve' ? '/en' : '';
    return venue + langPart + p.path + '?zp=1' + (hash || '');
  }
  function renderPageTabs() {
    el.pages.innerHTML = PAGES.filter((p) => pageAvailable(p.id)).map((p) =>
      '<button type="button" role="tab" data-page="' + p.id + '" aria-selected="' + (p.id === page) + '">' + p.label + '</button>').join('');
  }
  el.pages.addEventListener('click', (e) => { const b = e.target.closest('[data-page]'); if (b) loadPage(b.dataset.page); });
  function loadPage(id, hash) {
    if (!pageAvailable(id)) return;
    page = id; frameReady = false; clearLocate();
    el.loading.classList.remove('is-done');
    el.frame.src = pageUrl(id, hash);
    renderPageTabs();
    $$('[data-overlay]').forEach((c) => { c.checked = false; });
    if (id === 'reserve' && activeMode === 'light') showNote('The reserve portal is always dark — switch to <strong>Dark</strong> to see changes to it.');
    else if (draft) showDraftNote(); else hideNote();
  }
  $$('[data-lang]').forEach((b) => b.addEventListener('click', () => {
    lang = b.dataset.lang;
    $$('[data-lang]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    loadPage(page);
  }));
  $$('[data-device-btn]').forEach((b) => b.addEventListener('click', () => {
    device = b.dataset.deviceBtn;
    $$('[data-device-btn]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    $('[data-overlay-phone-only]').hidden = device !== 'phone';
    layoutStage();
    // The page lays itself out for the new width; breakpoint rules change which
    // styles apply, so the usage index is rebuilt on the next "show".
    usage = null; clearLocate();
  }));

  /** Size the frame to a real desktop or phone width and scale it to fit. */
  function layoutStage() {
    const w = device === 'phone' ? PHONE_W : DESKTOP_W;
    const vw = el.view.clientWidth, vh = el.view.clientHeight;
    const pad = device === 'phone' ? 24 : 0;
    const scale = Math.min(1, (vw - pad * 2) / w);
    const h = device === 'phone' ? Math.min((vh - pad * 2) / scale, 860) : vh / scale;
    stageScale = scale;
    el.device.classList.toggle('is-phone', device === 'phone');
    el.device.style.width = w + 'px';
    el.device.style.height = h + 'px';
    el.device.style.transform = 'scale(' + scale + ')';
    el.device.style.left = Math.max(0, (vw - w * scale) / 2) + 'px';
    el.device.style.top = (device === 'phone' ? pad : 0) + 'px';
    el.hits.style.setProperty('--scale', String(scale));
    positionHits();
  }
  new ResizeObserver(layoutStage).observe(el.view);

  // Styles the editor adds inside the frame. Overlays that pop up on their own
  // (entry popup, cookie banner) stay out of the way unless asked for.
  const HELPER_CSS =
    'html:not([data-zp-popup]) #zahara-announce{display:none!important}' +
    'html[data-zp-popup] #zahara-announce{opacity:1!important}' +
    'html:not([data-zp-consent]) #zahara-consent{display:none!important}';

  el.frame.addEventListener('load', () => {
    try { fwin = el.frame.contentWindow; fdoc = el.frame.contentDocument; } catch (_) { fwin = fdoc = null; }
    // The frame's initial about:blank load is not a page.
    if (!fdoc || !fdoc.head || fwin.location.href === 'about:blank') { fdoc = null; return; }
    // Follow in-frame navigation (a tab, a link we let through) to the right tab.
    const path = fwin.location.pathname.replace(/^\/rooftop/, '').replace(/^\/en(?=\/)/, '');
    const match = PAGES.find((p) => p.path === path || p.path === path + '/');
    if (match && match.id !== page) { page = match.id; renderPageTabs(); }
    const helper = fdoc.createElement('style'); helper.id = 'zp-helper'; helper.textContent = HELPER_CSS;
    stateStyle = fdoc.createElement('style'); stateStyle.id = 'zp-states';
    paletteStyle = fdoc.createElement('style'); paletteStyle.id = 'zp-palette';
    fdoc.head.append(helper, stateStyle, paletteStyle);
    lockTheme();
    guardFrame();
    usage = null;
    frameReady = true;
    paintFrame();
    fwin.addEventListener('scroll', () => requestAnimationFrame(positionHits), { passive: true });
    fwin.addEventListener('resize', () => { usage = null; }, { passive: true });
    setTimeout(() => el.loading.classList.add('is-done'), 120);
    if (pendingLocate) { const t = pendingLocate; pendingLocate = null; setTimeout(() => locate(t, { arrived: true }), 900); }
  });

  function frameTheme() { return page === 'reserve' ? 'dark' : activeMode; }
  /** Keep the frame in the palette being edited — the site's own theme button
   *  would otherwise flip it (and the owner's own site preference with it). */
  function lockTheme() {
    if (!fdoc) return;
    const html = fdoc.documentElement;
    if (html.getAttribute('data-theme') !== frameTheme()) html.setAttribute('data-theme', frameTheme());
    if (themeObserver) themeObserver.disconnect();
    themeObserver = new fwin.MutationObserver(() => {
      if (html.getAttribute('data-theme') === frameTheme()) return;
      html.setAttribute('data-theme', frameTheme());
      try {
        if (ownerThemePref == null) localStorage.removeItem('zahara-theme');
        else localStorage.setItem('zahara-theme', ownerThemePref);
      } catch (_) {}
      toast('The preview follows the palette you’re editing — use Light / Dark at the top.');
    });
    themeObserver.observe(html, { attributes: true, attributeFilter: ['data-theme'] });
  }

  /** Links move the preview between its pages; forms never send. */
  function guardFrame() {
    fdoc.addEventListener('click', (e) => {
      const a = e.target.closest && e.target.closest('a[href]');
      if (!a) return;
      const href = a.getAttribute('href') || '';
      if (href.charAt(0) === '#') return;
      e.preventDefault(); e.stopImmediatePropagation();
      let url; try { url = new URL(a.href); } catch (_) { return; }
      if (url.origin !== location.origin) { toast('Links to other sites don’t open from the preview.'); return; }
      const path = url.pathname.replace(/^\/rooftop/, '').replace(/^\/en(?=\/)/, '');
      const target = PAGES.find((p) => p.path === path || p.path === path + '/');
      if (target && pageAvailable(target.id)) loadPage(target.id, url.hash);
      else toast('That page isn’t part of the preview.');
    }, true);
    fdoc.addEventListener('submit', (e) => {
      e.preventDefault(); e.stopImmediatePropagation();
      toast('Forms don’t send from the preview.');
    }, true);
  }

  function paletteCss() {
    const body = (mode) => TOKENS.map((t) => t.token + ':' + shown(mode, t.token)).join(';');
    return ':root{' + body('light') + '}html[data-theme="dark"]{' + body('dark') + '}';
  }
  function paintFrame() {
    if (!frameReady || !fdoc || !paletteStyle) return;
    const css = paletteCss();
    if (paletteStyle.textContent !== css) paletteStyle.textContent = css;
    // Stay the LAST style in <head>, so it beats the saved palette the page
    // came with — including one a save broadcasts into it later.
    if (fdoc.head.lastElementChild !== paletteStyle) fdoc.head.appendChild(paletteStyle);
    const html = fdoc.documentElement;
    if (html.getAttribute('data-theme') !== frameTheme()) html.setAttribute('data-theme', frameTheme());
    requestAnimationFrame(positionHits);
  }

  // Hold to compare with what's live.
  const startCompare = () => { comparing = true; el.compare.classList.add('is-holding'); paintFrame(); };
  const endCompare = () => { if (!comparing) return; comparing = false; el.compare.classList.remove('is-holding'); paintFrame(); };
  el.compare.addEventListener('pointerdown', startCompare);
  ['pointerup', 'pointerleave', 'pointercancel', 'blur'].forEach((ev) => el.compare.addEventListener(ev, endCompare));
  el.compare.addEventListener('keydown', (e) => { if (e.key === ' ' || e.key === 'Enter') { e.preventDefault(); startCompare(); } });
  el.compare.addEventListener('keyup', endCompare);

  // Overlays the site shows on its own terms.
  function setOverlay(kind, on) {
    if (!fdoc) return false;
    const html = fdoc.documentElement;
    if (kind === 'popup') {
      html.toggleAttribute('data-zp-popup', on);
      const root = fdoc.getElementById('zahara-announce');
      if (root) { root.hidden = !on; root.classList.toggle('is-open', on); }
      return !!root;
    }
    if (kind === 'consent') {
      html.toggleAttribute('data-zp-consent', on);
      const c = fdoc.getElementById('zahara-consent');
      if (c) { c.hidden = !on; c.classList.toggle('is-visible', on); }
      return !!c;
    }
    if (kind === 'a11y') {
      const panel = fdoc.getElementById('a11y-panel'), btn = fdoc.querySelector('[data-a11y-toggle]');
      if (panel && btn && panel.hidden === on) btn.click();
      return !!panel;
    }
    if (kind === 'menu') {
      const drawer = fdoc.getElementById('mobile-nav'), burger = fdoc.querySelector('.burger');
      if (drawer && burger && drawer.classList.contains('is-open') !== on) burger.click();
      return !!drawer;
    }
    if (kind === 'status') {
      const s = fdoc.getElementById('form-status');
      if (!s) return false;
      if (on) { s.className = 'form-status ok'; s.textContent = '✓ ' + (lang === 'he' ? 'תודה — נחזור אליכם בקרוב.' : 'Thanks — we’ll be in touch soon.'); }
      else { s.className = 'form-status'; s.textContent = ''; }
      return true;
    }
    return false;
  }
  function toggleMenu(btn, list, open) {
    const want = open == null ? list.hidden : open;
    list.hidden = !want; btn.setAttribute('aria-expanded', String(want));
  }
  el.overlays.addEventListener('click', (e) => { e.stopPropagation(); toggleMenu(el.overlays, el.overlaysMenu); });
  el.overlaysMenu.addEventListener('change', (e) => {
    const c = e.target.closest('[data-overlay]'); if (!c) return;
    if (!setOverlay(c.dataset.overlay, c.checked)) {
      c.checked = false;
      toast(c.dataset.overlay === 'status' ? 'Form messages are on the About and Events pages.' : 'That isn’t on this page.');
    }
  });

  // ═══ WHERE IS IT USED ══════════════════════════════════════════════════════
  let usage = null;           // Map token → [{ rule, selectors }]
  let loc = null;             // { tk, hits, i, stateEls }
  let locTimer = null;

  /** Split `a, b:is(c, d)` at top-level commas only. */
  function splitTop(text, sep) {
    const out = []; let depth = 0, quote = null, start = 0;
    for (let i = 0; i < text.length; i++) {
      const ch = text[i];
      if (quote) { if (ch === quote && text[i - 1] !== '\\') quote = null; continue; }
      if (ch === '"' || ch === "'") quote = ch;
      else if (ch === '(') depth++;
      else if (ch === ')') depth--;
      else if (ch === sep && depth === 0) { out.push(text.slice(start, i)); start = i + 1; }
    }
    out.push(text.slice(start));
    return out.map((s) => s.trim()).filter(Boolean);
  }
  const VAR_RE = /var\(\s*(--[\w-]+)/g;
  function buildUsage() {
    const rules = [];
    const walk = (list) => {
      for (const r of list) {
        if (r.selectorText != null && r.style) rules.push(r);
        else if (r.media && r.cssRules) { if (fwin.matchMedia(r.media.mediaText).matches) walk(r.cssRules); }
        else if (r.cssRules) walk(r.cssRules);
      }
    };
    for (const sheet of Array.from(fdoc.styleSheets)) {
      const owner = sheet.ownerNode && sheet.ownerNode.id;
      if (owner === 'zp-palette' || owner === 'zp-helper' || owner === 'zp-states') continue;
      let list; try { list = sheet.cssRules; } catch (_) { continue; }   // cross-origin fonts
      walk(list);
    }
    const aliases = new Map(), uses = [];
    rules.forEach((rule) => {
      splitTop(rule.style.cssText, ';').forEach((decl) => {
        const i = decl.indexOf(':'); if (i < 1) return;
        const prop = decl.slice(0, i).trim(), val = decl.slice(i + 1);
        const vars = []; let m; VAR_RE.lastIndex = 0;
        while ((m = VAR_RE.exec(val))) vars.push(m[1]);
        if (!vars.length) return;
        if (prop.indexOf('--') === 0) {
          const set = aliases.get(prop) || new Set(); vars.forEach((v) => set.add(v)); aliases.set(prop, set);
        } else uses.push({ rule, vars });
      });
    });
    const memo = new Map();
    const resolve = (v, seen) => {
      if (TOKEN[v]) return [v];
      if (memo.has(v)) return memo.get(v);
      if (seen.has(v)) return [];
      seen.add(v);
      const out = new Set();
      (aliases.get(v) || []).forEach((a) => resolve(a, seen).forEach((t) => out.add(t)));
      const arr = Array.from(out); memo.set(v, arr); return arr;
    };
    const index = new Map();
    uses.forEach((u) => {
      const toks = new Set();
      u.vars.forEach((v) => resolve(v, new Set()).forEach((t) => toks.add(t)));
      toks.forEach((t) => { if (!index.has(t)) index.set(t, new Set()); index.get(t).add(u.rule); });
    });
    return index;
  }

  const STATE_RE = /:(hover|focus-visible|focus-within|focus|active)(?![\w-])/g;
  const PSEUDO_EL_RE = /::?(before|after|marker|placeholder|first-line|first-letter|backdrop)(?![\w-])/g;
  function cleanSelector(sel) {
    if (/::selection/.test(sel)) return { css: '', kind: 'selection' };
    if (/::-webkit-scrollbar/.test(sel)) return { css: '', kind: 'scrollbar' };
    STATE_RE.lastIndex = 0;
    const state = STATE_RE.test(sel); STATE_RE.lastIndex = 0;
    const css = sel.replace(STATE_RE, '').replace(PSEUDO_EL_RE, '').trim();
    if (!css || /[>+~]$/.test(css)) return { css: '', kind: state ? 'state' : null };
    return { css, kind: state ? 'state' : null, raw: sel };
  }
  // Scroll-reveal wrappers start transparent and fade in as they're reached —
  // their contents ARE on the page, so transparency there doesn't count.
  const REVEAL_SEL = '.reveal-on-scroll, [data-word-reveal], [data-line-reveal], .fade-up, .stagger, .menu-tiles__item, .reveal--off';
  function visibleRect(node) {
    const r = node.getBoundingClientRect();
    if (r.width < 2 || r.height < 2) return null;
    if (r.right <= 0 || r.left >= fwin.innerWidth) return null;
    const cs = fwin.getComputedStyle(node);
    if (cs.visibility === 'hidden' || cs.display === 'none') return null;
    // Transparent and not waiting on a reveal: hidden for real (the floating
    // Reserve button before the page is scrolled, an inactive gallery slide).
    for (let n = node; n && n.nodeType === 1; n = n.parentElement) {
      if (parseFloat(fwin.getComputedStyle(n).opacity) < 0.05) {
        if (n.matches(REVEAL_SEL) || n.closest(REVEAL_SEL)) break;
        return null;
      }
    }
    return r;
  }
  function isPinned(node) {
    for (let n = node; n && n.nodeType === 1; n = n.parentElement) {
      const p = fwin.getComputedStyle(n).position;
      if (p === 'fixed' || p === 'sticky') return true;
    }
    return false;
  }

  function collect(tk) {
    if (!usage) usage = buildUsage();
    const rules = usage.get(tk) || new Set();
    const hits = new Map(), hidden = [], clones = new Set(), special = { selection: false, scrollbar: false, page: false };
    rules.forEach((rule) => {
      splitTop(rule.selectorText, ',').forEach((sel) => {
        const c = cleanSelector(sel);
        if (c.kind === 'selection') { special.selection = true; return; }
        if (c.kind === 'scrollbar') { special.scrollbar = true; return; }
        if (!c.css) return;
        let nodes; try { nodes = fdoc.querySelectorAll(c.css); } catch (_) { return; }
        nodes.forEach((node) => {
          if (node === fdoc.documentElement || node === fdoc.body) { special.page = true; return; }
          if (!visibleRect(node)) { hidden.push(node); return; }
          const prev = hits.get(node);
          if (!prev || (prev.state && !c.kind)) hits.set(node, { node, state: c.kind === 'state' });
          if (c.kind === 'state') {
            clones.add(c.raw.replace(STATE_RE, '[data-zp-state]') + '{' + rule.style.cssText + '}');
          }
        });
      });
    });
    return { hits: Array.from(hits.values()), hidden, clones: Array.from(clones), special };
  }

  /** Bring hidden uses into view: a menu tab, a wine type, an overlay, or the
   *  buttons that only appear once the page is scrolled. Returns how long to
   *  wait before looking again (0 = nothing to try). */
  function reveal(nodes) {
    for (const node of nodes) {
      if (node.matches('.floating-reserve, .scroll-top') && fwin.scrollY < fwin.innerHeight * 1.2) {
        fwin.scrollTo({ top: fwin.innerHeight * 1.4 });
        return 700;
      }
      const panel = node.closest('[role="tabpanel"][id]');
      if (panel) {
        const tab = fdoc.querySelector('[aria-controls="' + panel.id + '"]');
        if (tab && tab.getAttribute('aria-selected') !== 'true') { tab.click(); return 1100; }
      }
      const wine = node.closest('[data-wine-group][hidden]');
      if (wine) {
        const chip = fdoc.querySelector('[data-wine-chip="' + wine.getAttribute('data-wine-group') + '"]');
        if (chip) { chip.click(); return 500; }
      }
      if (node.closest('#zahara-announce')) { setOverlay('popup', true); $('[data-overlay="popup"]').checked = true; return 400; }
      if (node.closest('#zahara-consent')) { setOverlay('consent', true); $('[data-overlay="consent"]').checked = true; return 400; }
      if (node.closest('#a11y-panel')) { setOverlay('a11y', true); $('[data-overlay="a11y"]').checked = true; return 400; }
    }
    return 0;
  }

  async function locate(tk, opts) {
    opts = opts || {};
    if (!frameReady) { pendingLocate = tk; return; }
    clearLocate();
    if (tk === '--ok' || tk === '--err') {
      const s = fdoc.getElementById('form-status');
      if (s) {
        s.className = 'form-status ' + (tk === '--ok' ? 'ok' : 'err');
        s.textContent = tk === '--ok'
          ? '✓ ' + (lang === 'he' ? 'תודה — נחזור אליכם בקרוב.' : 'Thanks — we’ll be in touch soon.')
          : '✗ ' + (lang === 'he' ? 'משהו השתבש, נסו שוב.' : 'Something went wrong — please try again.');
        usage = null;
      }
    }
    let res = collect(tk);
    if (!res.hits.length && res.hidden.length && !opts.revealed) {
      const wait = reveal(res.hidden);
      if (wait) { usage = null; await new Promise((r) => setTimeout(r, wait)); return locate(tk, Object.assign({}, opts, { revealed: true })); }
    }
    // The menu page builds each category only when its tab opens — try the
    // other tabs before giving up (the wine list's separators, cocktail cards).
    if (!res.hits.length && page === 'menu' && !res.special.selection) {
      const tried = opts.tabs || [];
      const tab = $$('.menu-tab[data-tab-id]', fdoc).find((t) => t.getAttribute('aria-selected') !== 'true' && !tried.includes(t.dataset.tabId));
      if (tab && tried.length < 4) {
        showLocator(labelOf(tk) + ' — looking in the ' + tab.textContent.trim() + ' tab…', 0, 0);
        tab.click();
        await new Promise((r) => setTimeout(r, 1400));
        usage = null;
        return locate(tk, Object.assign({}, opts, { tabs: tried.concat(tab.dataset.tabId), revealed: false }));
      }
    }
    if (!res.hits.length && !res.special.selection && !opts.arrived) {
      const home = TOKEN[tk] && TOKEN[tk].page;
      if (home && home !== 'any' && home !== page && pageAvailable(home)) {
        pendingLocate = tk;
        showLocator(labelOf(tk) + ' — opening the ' + home + ' page…', 0, 0);
        loadPage(home);
        return;
      }
    }
    // Hover-only uses: force the hover style on for the demo.
    if (res.clones.length) {
      stateStyle.textContent = res.clones.join('\n');
      res.hits.forEach((h) => { if (h.state) h.node.setAttribute('data-zp-state', ''); });
    }
    if (res.special.selection) selectDemo();
    const y = (n) => n.getBoundingClientRect().top + fwin.scrollY;
    const hits = res.hits.sort((a, b) => (isPinned(a.node) - isPinned(b.node)) || (y(a.node) - y(b.node)));
    loc = { tk, hits, i: 0 };
    if (!hits.length) {
      const why = res.special.selection ? 'Shown on the selected text in the preview.'
        : res.special.scrollbar ? 'Used by the scrollbar at the right edge of the preview.'
        : res.special.page ? 'Used by the background behind the whole page.'
        : 'Not visible on this page. ' + (TOKEN[tk] ? TOKEN[tk].hint : '');
      showLocator(labelOf(tk) + ': ' + why, 0, 0);
      armLocTimer(7000);
      return;
    }
    // Start from the first use at or below where the owner is looking.
    const top = fwin.scrollY;
    const start = hits.findIndex((h) => !isPinned(h.node) && y(h.node) >= top - 10);
    loc.i = start < 0 ? 0 : start;
    drawHits(); focusHit(loc.i);
    const extra = [res.clones.length ? 'incl. hover' : '', res.special.page ? 'and the page background' : ''].filter(Boolean).join(', ');
    showLocator(labelOf(tk) + ' · ' + hits.length + (hits.length === 1 ? ' place' : ' places') + (extra ? ' (' + extra + ')' : ''), loc.i + 1, hits.length);
    armLocTimer(9000);
  }
  function selectDemo() {
    const target = fdoc.querySelector('main p, .page-intro p, p');
    if (!target) return;
    try { fwin.focus(); fwin.getSelection().selectAllChildren(target); } catch (_) {}
    const r = target.getBoundingClientRect();
    if (r.top < 0 || r.bottom > fwin.innerHeight) fwin.scrollTo({ top: fwin.scrollY + r.top - 120, behavior: 'smooth' });
  }
  function drawHits() {
    el.hits.innerHTML = '';
    if (!loc) return;
    loc.hits.slice(0, 80).forEach((h, i) => {
      const box = document.createElement('div');
      box.className = 'hit'; box.dataset.i = String(i);
      if (h.state) { const tag = document.createElement('span'); tag.className = 'hit__tag'; tag.textContent = 'on hover'; box.appendChild(tag); }
      el.hits.appendChild(box);
      h.box = box;
    });
    positionHits();
  }
  function positionHits() {
    if (!loc || !fwin) return;
    loc.hits.forEach((h) => {
      if (!h.box) return;
      const r = h.node.getBoundingClientRect();
      Object.assign(h.box.style, { left: (r.left - 3) + 'px', top: (r.top - 3) + 'px', width: (r.width + 6) + 'px', height: (r.height + 6) + 'px' });
    });
  }
  function focusHit(i) {
    if (!loc || !loc.hits.length) return;
    loc.i = (i + loc.hits.length) % loc.hits.length;
    loc.hits.forEach((h, n) => h.box && h.box.classList.toggle('is-focus', n === loc.i));
    const node = loc.hits[loc.i].node, r = node.getBoundingClientRect(), vh = fwin.innerHeight;
    if (!isPinned(node) && (r.top < 60 || r.bottom > vh - 60)) {
      fwin.scrollTo({ top: Math.max(0, fwin.scrollY + r.top - Math.max(80, (vh - r.height) / 2)), behavior: 'smooth' });
    }
    el.locPos.textContent = (loc.i + 1) + ' / ' + loc.hits.length;
    armLocTimer(9000);
  }
  function showLocator(text, pos, total) {
    el.locator.hidden = false;
    el.locText.textContent = text;
    el.locPos.textContent = total ? pos + ' / ' + total : '';
    $('[data-loc-prev]').hidden = $('[data-loc-next]').hidden = total < 2;
  }
  function armLocTimer(ms) { clearTimeout(locTimer); locTimer = setTimeout(clearLocate, ms); }
  function clearLocate() {
    clearTimeout(locTimer);
    el.hits.innerHTML = ''; el.locator.hidden = true;
    if (fdoc) {
      $$('[data-zp-state]', fdoc).forEach((n) => n.removeAttribute('data-zp-state'));
      if (stateStyle) stateStyle.textContent = '';
    }
    loc = null;
  }
  $('[data-loc-prev]').addEventListener('click', () => focusHit(loc ? loc.i - 1 : 0));
  $('[data-loc-next]').addEventListener('click', () => focusHit(loc ? loc.i + 1 : 0));
  $('[data-loc-close]').addEventListener('click', clearLocate);
  el.locator.addEventListener('pointerenter', () => clearTimeout(locTimer));

  // ═══ NOTE STRIP (previews that aren't applied yet) ═════════════════════════
  function showNote(html, buttons) {
    el.note.hidden = false;
    el.note.innerHTML = '<span>' + html + '</span>';
    (buttons || []).forEach((b) => {
      const btn = document.createElement('button');
      btn.type = 'button'; btn.className = 'btn btn--small' + (b.ghost ? ' btn--ghost' : '');
      btn.textContent = b.label; btn.addEventListener('click', b.run);
      el.note.appendChild(btn);
    });
    requestAnimationFrame(layoutStage);
  }
  function hideNote() { if (!el.note.hidden) { el.note.hidden = true; requestAnimationFrame(layoutStage); } }
  function showDraftNote() {
    if (!draft) return hideNote();
    if (draft.source === 'theme') showNote('Previewing <strong>' + esc(draft.label) + '</strong> — click the card to use it.');
    else showNote('Previewing your mix (not applied yet).', [
      { label: 'Apply', run: applyMix }, { label: 'Clear', ghost: true, run: clearMix },
    ]);
  }

  // ═══ THEMES ════════════════════════════════════════════════════════════════
  let mood = 'all';
  const presetMeta = (id) => PRESET_META.find((m) => m.id === id);

  /** Text on an accent fill: keep the theme's cream label where it reads,
   *  otherwise whichever of cream and dark reads better. */

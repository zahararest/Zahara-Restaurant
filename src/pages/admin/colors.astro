  // disappears (black-on-black is 1.0) — the one case worth interrupting for.
  // Between here and the AA target is a quality warning, listed but not
  // shouted about, so the owner is never trained to ignore a red badge.
  const SEVERE_BELOW = 2;

  // ── The pairings the SITE actually renders ────────────────────────────────
  // Each entry is "this ink sits on that ground, here". A row's badge reports
  // its WORST pairing and the legibility report lists every failure — so
  // setting a button fill to black can't silently swallow its own label.
  // Declared up here because the first renderMode() runs before the contrast
  // section below is evaluated.
  //   big:true → large/display text, where 3:1 is the AA threshold.
  const PAIRINGS = [
    { fg: '--ink',            bg: '--paper',            where: 'Headlines and body copy on the page' },
    { fg: '--ink-soft',       bg: '--paper',            where: 'Paragraph text on the page' },
    { fg: '--ink-muted',      bg: '--paper',            where: 'Eyebrows, labels and metadata' },
    { fg: '--ink',            bg: '--paper-card',       where: 'Text inside cards, forms and the popup' },

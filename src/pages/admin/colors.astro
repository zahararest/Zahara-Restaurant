    if (!cpopToken) return;
    commit(labelOf(cpopToken), [{ mode: activeMode, tk: cpopToken, value }], merge ? { merge: 'cpop:' + cpopToken } : null);
    if (!cpopLocated) { cpopLocated = true; locate(cpopToken); }
  }
  cp.color.addEventListener('input', () => cpopSet(cp.color.value, true));
  cp.hex.addEventListener('input', () => {
    const v = normHex(cp.hex.value);
    cp.hex.classList.toggle('is-invalid', !v);
    if (v) cpopSet(v, true);
  });
  cp.hex.addEventListener('blur', () => { cp.hex.classList.remove('is-invalid'); if (cpopToken) cp.hex.value = resolved(activeMode, cpopToken); });
  cp.swatches.addEventListener('click', (e) => { const b = e.target.closest('[data-pick]'); if (b) cpopSet(b.dataset.pick, false); });
  $('[data-cpop-locate]').addEventListener('click', () => cpopToken && locate(cpopToken));
  cp.reset.addEventListener('click', () => cpopSet(base(activeMode, cpopToken), false));

  // ═══ REVIEW DRAWER ═════════════════════════════════════════════════════════
  function openDrawer(focus) {
    renderDrawer(); el.scrim.hidden = false; el.drawer.hidden = false;
    if (focus === 'legibility') { const s = el.drawerBody.querySelector('[data-leg-section]'); if (s) s.scrollIntoView(); }
  }
  function closeDrawer() { el.scrim.hidden = true; el.drawer.hidden = true; }
  function renderDrawer() {
    const items = pendingList();
    let html = '';
    if (!items.length) html += '<p class="drawer__empty">No unsaved changes — the preview matches the live site.</p>';
    MODES.forEach((mode) => {
      const list = items.filter((i) => i.mode === mode);
      if (!list.length) return;
      html += '<section class="drawer__section"><h3>' + (mode === 'light' ? '☀︎ Light' : '☾ Dark') + ' palette · ' + list.length + '</h3>' +
        list.map((i) => {
          const from = savedValue(mode, i.tk), to = resolved(mode, i.tk);
          const vals = isScalar(i.tk)
            ? '<span>' + from + ' → ' + to + (TOKEN[i.tk].unit || '') + '</span>'
            : swatches([from]) + '<code>' + from + '</code><span class="diff__arrow">→</span>' + swatches([to]) + '<code>' + to + '</code>';
          return '<div class="change"><span class="change__label">' + esc(labelOf(i.tk)) + '<small>' + esc(TOKEN[i.tk].group) + '</small></span>' +
            '<span class="change__vals">' + vals + '</span>' +
            '<span><button type="button" class="btn btn--small btn--link" data-drawer-show="' + i.tk + '" data-mode-of="' + mode + '">Show</button>' +
            '<button type="button" class="btn btn--small btn--link" data-drawer-revert="' + i.tk + '" data-mode-of="' + mode + '">Revert</button></span></div>';
        }).join('') + '</section>';
    });
    const fails = failures('light').concat(failures('dark'));
    html += '<section class="drawer__section" data-leg-section><h3>Legibility</h3>' +
      (fails.length ? fails.map((f, n) => {
        const fix = fixToward(f.fgHex, f.bgHex, f.min);
        return '<div class="leg' + (f.severe ? ' is-severe' : '') + '"><span class="leg__sample" style="background:' + f.bgHex + ';color:' + f.fgHex + '">Aa</span>' +
          '<span><span class="leg__where">' + esc(f.where) + '</span><br><span class="leg__pair">' + (f.mode === 'light' ? '☀︎ ' : '☾ ') +
          esc(labelOf(f.fg)) + ' on ' + esc(labelOf(f.bg)) + ' · ' + f.ratio.toFixed(2) + ':1, needs ' + f.min + ':1</span></span>' +
          '<button type="button" class="btn btn--small" data-leg-fix="' + n + '" title="Set ' + esc(labelOf(f.fg)) + ' to ' + fix + '">' + swatches([fix], 'sw--sm') + ' Fix</button></div>';
      }).join('') : '<p class="leg__ok">Every pairing reads clearly in both palettes. ✓</p>') + '</section>';
    el.drawerBody.innerHTML = html;
    el.drawerBody._fails = fails;
    const saveBtn = $('[data-drawer-save]');
    saveBtn.disabled = !items.length || saving;
    saveBtn.textContent = items.length ? 'Save ' + items.length + ' change' + (items.length === 1 ? '' : 's') : 'Save';
    $('[data-discard]').disabled = !items.length;
  }
  el.drawerBody.addEventListener('click', (e) => {
    const show = e.target.closest('[data-drawer-show]');
    if (show) { setMode(show.dataset.modeOf); closeDrawer(); locate(show.dataset.drawerShow); return; }
    const rev = e.target.closest('[data-drawer-revert]');
    if (rev) { const mode = rev.dataset.modeOf, tk = rev.dataset.drawerRevert; commit('Revert ' + labelOf(tk), [{ mode, tk, value: savedValue(mode, tk) }]); return; }
    const fix = e.target.closest('[data-leg-fix]');
    if (fix) {
      const f = el.drawerBody._fails[Number(fix.dataset.legFix)];
      commit('Fix ' + labelOf(f.fg), [{ mode: f.mode, tk: f.fg, value: fixToward(f.fgHex, f.bgHex, f.min) }]);
    }
  });
  el.review.addEventListener('click', () => openDrawer());
  el.legib.addEventListener('click', () => openDrawer('legibility'));
  $('[data-drawer-close]').addEventListener('click', closeDrawer);
  el.scrim.addEventListener('click', () => { closeDrawer(); el.exportModal.hidden = true; });
  $('[data-drawer-save]').addEventListener('click', save);
  $('[data-discard]').addEventListener('click', discardAll);
  el.save.addEventListener('click', save);
  el.undo.addEventListener('click', undo);
  el.redo.addEventListener('click', redo);

  // ═══ MORE MENU + EXPORT ════════════════════════════════════════════════════
  el.more.addEventListener('click', (e) => { e.stopPropagation(); toggleMenu(el.more, el.moreMenu); });
  let exportKind = 'full';
  function exportCss() {
    const sel = activeMode === 'dark' ? 'html[data-theme="dark"]' : ':root';
    const lines = TOKENS.filter((t) => exportKind === 'full' || resolved(activeMode, t.token) !== CODE[activeMode][t.token])
      .map((t) => '  ' + (t.token + ':').padEnd(24) + resolved(activeMode, t.token) + ';');
    return lines.length ? sel + ' {\n' + lines.join('\n') + '\n}' : '/* Nothing differs from the defaults. */';
  }
  el.moreMenu.addEventListener('click', (e) => {
    const b = e.target.closest('[data-action]'); if (!b) return;
    toggleMenu(el.more, el.moreMenu, false);
    if (b.dataset.action === 'legibility') openDrawer('legibility');
    if (b.dataset.action === 'export') { el.exportText.value = exportCss(); el.scrim.hidden = false; el.exportModal.hidden = false; }
    if (b.dataset.action === 'reset-mode') {
      const tx = commit('Reset ' + activeMode + ' to defaults', TOKENS.map((t) => ({ mode: activeMode, tk: t.token, value: base(activeMode, t.token) })));
      toast(tx ? 'The ' + activeMode + ' palette is back to ' + (IS_ROOFTOP ? 'Zahara’s colours' : 'the defaults') + ' (not saved yet).' : 'Already at the defaults.', tx ? { label: 'Undo', run: undo } : null);
    }
  });
  $$('[data-export-kind]').forEach((b) => b.addEventListener('click', () => {
    exportKind = b.dataset.exportKind;
    $$('[data-export-kind]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    el.exportText.value = exportCss();
  }));
  $('[data-export-close]').addEventListener('click', () => { el.exportModal.hidden = true; el.scrim.hidden = true; });
  $('[data-export-copy]').addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(el.exportText.value); toast('Copied'); } catch (_) { el.exportText.select(); }
  });

  // ═══ TABS ══════════════════════════════════════════════════════════════════
  function setTab(id) {
    $$('[data-tab]').forEach((b) => b.setAttribute('aria-selected', String(b.dataset.tab === id)));
    $$('[data-panel]').forEach((p) => { p.hidden = p.dataset.panel !== id; });
    closeCpop(); closeSrcPick();
    if (id === 'mix') previewMix();
    else if (draft && draft.source === 'mix') showDraftNote();
  }
  $$('[data-tab]').forEach((b) => b.addEventListener('click', () => setTab(b.dataset.tab)));

  // ═══ GLOBAL KEYS + CLICK-AWAY ══════════════════════════════════════════════
  document.addEventListener('pointerdown', (e) => {
    if (!el.cpop.hidden && !el.cpop.contains(e.target) && !e.target.closest('[data-swatch]')) closeCpop();
    if (!el.srcpick.hidden && !el.srcpick.contains(e.target) && !e.target.closest('[data-src-open]')) closeSrcPick();
    if (!el.moreMenu.hidden && !el.moreMenu.contains(e.target) && e.target !== el.more) toggleMenu(el.more, el.moreMenu, false);
    if (!el.overlaysMenu.hidden && !el.overlaysMenu.contains(e.target) && e.target !== el.overlays) toggleMenu(el.overlays, el.overlaysMenu, false);
  });
  document.addEventListener('keydown', (e) => {
    const meta = e.metaKey || e.ctrlKey;
    const typing = e.target.matches && e.target.matches('input[type="text"], input[type="search"], textarea');
    if (meta && e.key.toLowerCase() === 's') { e.preventDefault(); save(); return; }
    if (meta && e.key.toLowerCase() === 'z' && !typing) { e.preventDefault(); if (e.shiftKey) redo(); else undo(); return; }
    if (e.key === 'Escape') {
      if (!el.cpop.hidden) closeCpop();
      else if (!el.srcpick.hidden) closeSrcPick();
      else if (!el.exportModal.hidden) { el.exportModal.hidden = true; el.scrim.hidden = true; }
      else if (!el.drawer.hidden) closeDrawer();
      else if (loc) clearLocate();
    }
  });

  // ═══ START ═════════════════════════════════════════════════════════════════
  renderPageTabs();
  renderThemes();
  refresh();
  layoutStage();
  loadPage('home');
})();
</script>
</body>
</html>

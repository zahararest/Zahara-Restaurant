  // ────────────────────────────────────────────────────────────────────────────
  // STATE & STORAGE
  //
  // Source of truth is the server (KV via /api/palette). localStorage is a
  // FAST CACHE so the editor doesn't blank-flash while the network round-trip
  // happens — we hydrate from cache instantly, then reconcile against the
  // server response a moment later.
  // ────────────────────────────────────────────────────────────────────────────
  const KEY        = 'zahara-color-overrides';
  // Which venue this editor edits, from the admin site-switch cookie (set by the
  // venue switch in the topbar / other /admin pages). The seed fetch is scoped
  // to it so we never seed from Zahara and then save into rooftop; the save
  // endpoint (/admin/colors/save) reads the same cookie server-side.
  const ADMIN_SITE = (document.cookie.match(/(?:^|;\s*)zahara_admin_site=(rooftop|zahara)/) || [])[1] || 'zahara';
  const SITE_Q     = ADMIN_SITE === 'rooftop' ? '?site=rooftop' : '';
  const SERVER_GET = '/api/palette' + SITE_Q;
  const SERVER_PUT = '/admin/colors/save';
  const root       = document.documentElement;
  const rows       = Array.from(document.querySelectorAll('[data-row]'));

  // Which palette we're editing: 'light' or 'dark'. The preview pane reflects
  // this mode; Save persists BOTH. State shape everywhere is a pair:
  //   { light: { '--token': '#hex', … }, dark: { … } }
  let activeMode = 'light';

  let bc = null;
  try { bc = new BroadcastChannel('zahara-colors'); } catch (_) {}

  // ── Pair helpers ────────────────────────────────────────────────────────────
  function emptyPair() { return { light: {}, dark: {} }; }
  function clonePair(p) { return { light: Object.assign({}, p.light), dark: Object.assign({}, p.dark) }; }

  // Normalise any stored / fetched value into the pair shape, migrating an
  // old flat { '--token':'#hex' } record (light only).
  function toPair(raw) {
    const pair = emptyPair();
    if (!raw || typeof raw !== 'object') return pair;
    const looksFlat = Object.keys(raw).some((k) => k.indexOf('--') === 0);
    const src = looksFlat ? { light: raw } : raw;
    ['light', 'dark'].forEach((mode) => {
      const m = src[mode];
      if (m && typeof m === 'object') {
        for (const t in m) {
          if (t.indexOf('--') !== 0) continue;
          const v = m[t];
          if (typeof v !== 'string' && typeof v !== 'number') continue;
          pair[mode][t] = _norm(t, v);
        }
      }
    });
    return pair;
  }

  // Uppercase for hexes, plain integer string for scalars. Everything
  // downstream compares values with ===, so normalising in one place keeps
  // "modified?" and "pending?" honest.
  function _norm(token, v) {
    return isScalar(token) ? String(v).trim() : String(v).toUpperCase();
  }

  function defaultFor(mode, token) {
    const v = (mode === 'dark' ? darkDefaults[token] : defaults[token]) || defaults[token] || '';
    return _norm(token, v);
  }
  function rowDefault(row) {
    return _norm(row.dataset.token, activeMode === 'dark' ? row.dataset.defaultDark : row.dataset.default);
  }
  function curMap() { return currentState[activeMode]; }
  function resolved(mode, token) {
    return _norm(token, currentState[mode][token] || defaultFor(mode, token));
  }

  function loadCache() {
    try { return toPair(JSON.parse(localStorage.getItem(KEY) || '{}')); } catch { return emptyPair(); }
  }
  function writeCache(o) {
    try { localStorage.setItem(KEY, JSON.stringify(o)); } catch (_) {}
  }

  // savedState: last value confirmed against the SERVER.
  // currentState: live state including unsaved edits.
  // Start optimistically from the cache; reconcile with the server below.
  let savedState   = loadCache();
  let currentState = clonePair(savedState);
  let serverSyncedAt = 0;  // becomes >0 once /api/palette has returned

  // ────────────────────────────────────────────────────────────────────────────
  // UI REFS
  // ────────────────────────────────────────────────────────────────────────────
  const toastEl      = document.querySelector('[data-toast]');
  const undoBtn      = document.querySelector('[data-undo]');
  const saveBtn      = document.querySelector('[data-save]');
  const discardBtn   = document.querySelector('[data-discard]');
  const pendingBadge = document.querySelector('[data-pending-badge]');
  // Looked up here rather than beside the legibility code below: the first
  // renderMode() runs before that block is evaluated, and would otherwise hit
  // these consts in their temporal dead zone.
  const legBadge     = document.querySelector('[data-legibility-badge]');
  const legModal     = document.querySelector('[data-legibility-modal]');
  const legList      = document.querySelector('[data-legibility-list]');

  // ── Render the active mode onto :root + the rows ──────────────────────────────
  // We ALWAYS set an explicit value for every token (never removeProperty):
  // the admin page carries no data-theme attribute, so relying on the cascade
  // would fall back to the LIGHT default even while editing dark.
  function renderMode() {
    rows.forEach((row) => {
      const val = resolved(activeMode, row.dataset.token);
      root.style.setProperty(row.dataset.token, val);
      _syncRowUI(row, val, { skipHistory: true });
    });
    _refreshAllContrast();
    _updatePendingUI();
  }

  // ────────────────────────────────────────────────────────────────────────────
  // INIT — render cached state immediately (zero flash), then reconcile
  // against the canonical server state.
  // ────────────────────────────────────────────────────────────────────────────
  renderMode();

  // Fire-and-forget reconciliation. We deliberately don't `await` this at
  // the top level — the editor renders from cache immediately, and the
  // server response slides values into place a moment later.
  (async function reconcileWithServer() {
    let serverPair;
    try {
      const res = await fetch(SERVER_GET, { cache: 'no-store', credentials: 'same-origin' });
      if (!res.ok) throw new Error('HTTP ' + res.status);
      serverPair = toPair(await res.json());
    } catch (err) {
      console.warn('[colors] /api/palette failed — staying on cached state', err);
      return;
    }
    serverSyncedAt = Date.now();

    // Server is canonical for savedState. Pending edits stay pending.
    savedState = serverPair;
    writeCache(savedState);

    // If the user hasn't started editing yet, bring currentState in line with
    // the server so the picker UI matches what's actually saved.
    if (history.length === 0) {
      currentState = clonePair(savedState);
      renderMode();
    } else {
      _refreshAllDots();
      _updatePendingUI();
    }
  })();

  // ────────────────────────────────────────────────────────────────────────────
  // UNDO HISTORY
  // ────────────────────────────────────────────────────────────────────────────
  const history = [];

  function _pushHistory(token, from, to) {
    history.push({ mode: activeMode, token, from, to });
    if (history.length > 50) history.shift();
    undoBtn.disabled = false;
  }

  function undo() {
    const last = history.pop();
    if (!last) { undoBtn.disabled = true; return; }
    if (last.mode !== activeMode) setMode(last.mode);
    applyToken(last.token, last.from, { silent: true });
    if (history.length === 0) undoBtn.disabled = true;
  }

  undoBtn.addEventListener('click', undo);

  // ────────────────────────────────────────────────────────────────────────────
  // PENDING TRACKING
  // ────────────────────────────────────────────────────────────────────────────
  function isPendingIn(mode, token) {
    const cur = _norm(token, currentState[mode][token] || defaultFor(mode, token));
    const sav = _norm(token, savedState[mode][token]   || defaultFor(mode, token));
    return cur !== sav;
  }
  function _isPending(token) { return isPendingIn(activeMode, token); }

  // Counts rows that differ from saved in EITHER mode, so the Save button
  // and "N unsaved" badge reflect edits made across both palettes.
  function _countPending() {
    return rows.filter((r) =>
      isPendingIn('light', r.dataset.token) || isPendingIn('dark', r.dataset.token)
    ).length;
  }

  function _updatePendingUI() {
    const n = _countPending();
    if (n > 0) {
      pendingBadge.textContent = n + ' unsaved';
      pendingBadge.hidden = false;
    } else {
      pendingBadge.hidden = true;
    }
    saveBtn.disabled    = n === 0;
    discardBtn.disabled = n === 0;
  }

  // ────────────────────────────────────────────────────────────────────────────
  // SAVE — POST currentState to the server. Server is canonical; only on a
  // 2xx do we update savedState (so a network failure leaves the editor
  // still showing "N unsaved" and the user can retry).
  // ────────────────────────────────────────────────────────────────────────────
  let saving = false;

  async function save() {
    if (saving) return;
    if (_countPending() === 0) return;
    saving = true;
    const label = saveBtn.textContent;
    saveBtn.disabled = true;
    saveBtn.textContent = 'Saving…';

    try {
      const res = await fetch(SERVER_PUT, {
        method:      'POST',
        headers:     { 'Content-Type': 'application/json' },
        credentials: 'same-origin',
        body:        JSON.stringify(currentState),
      });
      if (!res.ok) {
        let msg = 'HTTP ' + res.status;
        try { msg = (await res.json()).error || msg; } catch (_) {}
        throw new Error(msg);
      }
      savedState = clonePair(currentState);
      writeCache(savedState);
      if (bc) bc.postMessage({ type: 'colors-changed', overrides: savedState });
      showToast('Saved to server ✓');
    } catch (err) {
      console.error('[colors] save failed', err);
      showToast('Save failed: ' + err.message);
    } finally {
      saving = false;
      saveBtn.textContent = label;
      _updatePendingUI();
      _refreshAllDots();
    }
  }

  saveBtn.addEventListener('click', save);

  // ────────────────────────────────────────────────────────────────────────────
  // DISCARD
  // ────────────────────────────────────────────────────────────────────────────
  function discard() {
    // Revert both palettes to the last saved state and repaint the active mode.
    currentState = clonePair(savedState);
    renderMode();
    history.length = 0;
    undoBtn.disabled = true;
    showToast('Changes discarded');
  }

  discardBtn.addEventListener('click', () => {
    if (_countPending() === 0 || !confirm('Discard all unsaved changes?')) return;
    discard();
  });

  // ────────────────────────────────────────────────────────────────────────────
  // APPLY TOKEN — applies to :root immediately (preview updates), tracks
  // the change as "pending" but does NOT write to localStorage.
  // ────────────────────────────────────────────────────────────────────────────
  function applyToken(token, value, opts) {
    opts = opts || {};
    const row = rows.find((r) => r.dataset.token === token);
    if (!row) return;
    const normalised = isScalar(token) ? _normaliseScalar(row, value) : _normaliseHex(value);
    if (normalised == null) return;

    const modeDefault = rowDefault(row);
    const prev = _norm(token, curMap()[token] || modeDefault);
    if (!opts.silent && prev !== normalised) {
      _pushHistory(token, prev, normalised);
    }

    // Track override-vs-default in state, but ALWAYS paint :root explicitly
    // (the admin page has no data-theme, so removeProperty would fall back to
    // the light default even in dark mode).
    if (normalised === modeDefault) delete curMap()[token];
    else                            curMap()[token] = normalised;
    root.style.setProperty(token, normalised);

    _syncRowUI(row, normalised, opts);
    _refreshAllContrast();
    if (!opts.silent) _highlight(token);
    _updatePendingUI();
  }

  // ────────────────────────────────────────────────────────────────────────────
  // SYNC ROW UI (picker + hex + dots)
  // ────────────────────────────────────────────────────────────────────────────
  function _syncRowUI(row, value, opts) {
    opts = opts || {};
    const picker = row.querySelector('[data-picker]');   // colour rows only
    const range  = row.querySelector('[data-range]');    // scalar rows only
    const hexEl  = row.querySelector('[data-hex]');
    const dot    = row.querySelector('[data-modified-dot]');

    if (picker && picker.value.toUpperCase() !== value) picker.value = value;
    if (range && range.value !== value && document.activeElement !== range) range.value = value;
    if (!opts.skipHexSync && document.activeElement !== hexEl) {
      hexEl.value = value;
    }
    hexEl.classList.remove('is-invalid');

    // Dot: orange = modified from the active mode's default; blue = unsaved.
    const isModified = value !== rowDefault(row);
    const isPend     = _isPending(row.dataset.token);
    dot.classList.toggle('is-modified', isModified && !isPend);
    dot.classList.toggle('is-pending',  isPend);
    dot.title = isPend ? 'Unsaved change' : (isModified ? 'Modified from default' : '');
  }

  function _refreshAllDots() {
    rows.forEach((row) => {
      const val = resolved(activeMode, row.dataset.token);
      _syncRowUI(row, val, { skipHexSync: true, skipHistory: true });
    });
  }

  // ────────────────────────────────────────────────────────────────────────────
  // WIRE EACH ROW
  // ────────────────────────────────────────────────────────────────────────────
  rows.forEach((row) => {
    const token    = row.dataset.token;
    const picker   = row.querySelector('[data-picker]');
    const range    = row.querySelector('[data-range]');
    const hexEl    = row.querySelector('[data-hex]');
    const showBtn  = row.querySelector('[data-show]');
    const copyBtn  = row.querySelector('[data-copy]');
    const resetBtn = row.querySelector('[data-reset-one]');
    const parse    = (v) => (isScalar(token) ? _normaliseScalar(row, v) : _normaliseHex(v));

    if (picker) picker.addEventListener('input', () => applyToken(token, picker.value));
    // Dragging a slider fires a stream of inputs; collapse them into one
    // history entry so a single drag is one undo, not fifty.
    if (range) {
      range.addEventListener('input', () => applyToken(token, range.value, { silent: true }));
      range.addEventListener('change', () => applyToken(token, range.value));
    }

    let hexTimer = null;
    hexEl.addEventListener('input', () => {
      const v = parse(hexEl.value);
      if (v == null) { hexEl.classList.add('is-invalid'); return; }
      hexEl.classList.remove('is-invalid');
      clearTimeout(hexTimer);
      hexTimer = setTimeout(() => applyToken(token, v), 160);
    });
    hexEl.addEventListener('blur', () => {
      const v = parse(hexEl.value);
      hexEl.value = v == null ? resolved(activeMode, token) : v;
      hexEl.classList.remove('is-invalid');
    });
    hexEl.addEventListener('focus', () => hexEl.select());

    showBtn.addEventListener('click', () => {
      _highlight(token);
      showBtn.classList.remove('is-pulsing');
      requestAnimationFrame(() => showBtn.classList.add('is-pulsing'));
      setTimeout(() => showBtn.classList.remove('is-pulsing'), 1300);
    });

    copyBtn.addEventListener('click', async () => {
      const val = resolved(activeMode, token);
      try { await navigator.clipboard.writeText(val); } catch (_) {}
      showToast('Copied ' + val);
    });

    resetBtn.addEventListener('click', () => {
      applyToken(token, rowDefault(row));
    });
  });

  // ────────────────────────────────────────────────────────────────────────────
  // MODE TOGGLE (light / dark)
  // ────────────────────────────────────────────────────────────────────────────
  function setMode(mode) {
    if (mode !== 'light' && mode !== 'dark') return;
    activeMode = mode;
    document.querySelectorAll('[data-mode-btn]').forEach((b) => {
      const on = b.dataset.modeBtn === mode;
      b.classList.toggle('is-active', on);
      b.setAttribute('aria-pressed', on ? 'true' : 'false');
    });
    renderMode();   // repaint :root + rows + contrast for the new mode
    _applyFilter(); // "modified only" is mode-sensitive
  }
  document.querySelectorAll('[data-mode-btn]').forEach((b) => {
    b.addEventListener('click', () => setMode(b.dataset.modeBtn));
  });

  // ────────────────────────────────────────────────────────────────────────────
  // RESET ALL — resets the ACTIVE mode's tokens to their defaults.
  // ────────────────────────────────────────────────────────────────────────────
  document.querySelector('[data-reset]').addEventListener('click', () => {
    if (!confirm('Reset every token in ' + activeMode + ' mode to its default? This marks them as unsaved.')) return;
    rows.forEach((r) => { delete curMap()[r.dataset.token]; });
    renderMode();
    history.length = 0;
    undoBtn.disabled = true;
    showToast('Reset ' + activeMode + ' to defaults (not yet saved)');
  });

  // ────────────────────────────────────────────────────────────────────────────
  // PRESETS
  //
  // Applying a preset always produces a COMPLETE palette. Tokens the preset
  // doesn't carry are derived from the ones it does, so the events band and
  // the page background harmonise with the theme being loaded instead of
  // lingering from whatever was applied before.
  // ────────────────────────────────────────────────────────────────────────────
  function derivedFrom(palette) {
    const pick = (tk) => (palette[tk] != null ? palette[tk] : defaultFor(activeMode, tk));
    return {
      '--events-band-from':    pick('--paper-deep'),
      '--events-band-to':      pick('--paper'),
      '--events-band-text':    pick('--ink-soft'),
      '--events-band-num':     pick('--accent'),
      '--events-band-divider': pick('--rule'),
      '--bg-wash-from':        pick('--paper'),
      '--bg-wash-to':          pick('--paper-deep'),
      '--bg-glow':             pick('--accent'),
    };
  }

  /** Apply a full token map (preset or mix) across every editable row. */
  function applyPalette(palette, label) {
    const derived = derivedFrom(palette);
    rows.forEach((row) => {
      const tk = row.dataset.token;
      // Sliders carry no colour identity — a preset must not reset the
      // owner's grain/glow strengths behind their back.
      if (isScalar(tk)) return;
      const val = (palette[tk] != null) ? palette[tk]
                : (derived[tk] != null) ? derived[tk]
                : defaultFor(activeMode, tk);
      applyToken(tk, val);
    });
    showToast(label + ' → ' + activeMode + ' (not saved)');
  }

  // ── Preset picker modal ─────────────────────────────────────────────────────
  const presetModal  = document.querySelector('[data-preset-modal]');
  const presetGrid   = document.querySelector('[data-preset-grid]');
  const presetSub    = document.querySelector('[data-preset-sub]');
  const presetHint   = document.querySelector('[data-preset-hint]');
  const presetMixChk = document.querySelector('[data-preset-mix]');
  const presetFoot   = document.querySelector('[data-preset-foot]');
  const presetRecipe = document.querySelector('[data-preset-recipe]');

  let presetTab = 'light';
  // The mix under construction: { partId: presetId }.
  let mixRecipe = {};

  // Swatches shown on each card, in reading order: the two surfaces, the
  // three inks, then accent and highlight — enough to recognise a theme.
  const CARD_SWATCHES = ['--paper', '--paper-deep', '--ink', '--ink-soft', '--ink-muted', '--accent', '--gold'];

  function presetValue(id, token) {
    const p = PRESETS[id];
    if (!p) return '#000000';
    if (p[token] != null) return p[token];
    // `default: defaults` covers everything, so this only fires for a preset
    // that genuinely omits the token — fall back to its mode's default.
    return defaultFor(PRESET_META.find((m) => m.id === id).mode, token) || '#000000';
  }

  function renderPresetGrid() {
    const list = PRESET_META.filter((m) => m.mode === presetTab);
    const mixing = presetMixChk.checked;
    presetGrid.innerHTML = list.map((m) => {
      const dots = CARD_SWATCHES
        .map((tk) => '<span class="preset-card__dot" style="background:' + presetValue(m.id, tk) + '"></span>')
        .join('');
      const parts = mixing ? PRESET_PARTS.map((part) =>
        '<button type="button" class="preset-part' + (mixRecipe[part.id] === m.id ? ' is-on' : '') + '"' +
        ' data-mix-preset="' + m.id + '" data-mix-part="' + part.id + '">' + part.label + '</button>'
      ).join('') : '';
      return '' +
        '<div class="preset-card' + (mixing ? ' is-mixing' : '') + '">' +
          '<button type="button" class="preset-card__main" data-preset-pick="' + m.id + '">' +
            '<span class="preset-card__dots">' + dots + '</span>' +
            '<span class="preset-card__name">' + m.name + '</span>' +
            '<span class="preset-card__note">' + m.note + '</span>' +
          '</button>' +
          (mixing ? '<div class="preset-card__parts">' + parts + '</div>' : '') +
        '</div>';
    }).join('');
  }

  function renderRecipe() {
    const entries = Object.entries(mixRecipe);
    presetFoot.hidden = !presetMixChk.checked || entries.length === 0;
    if (presetFoot.hidden) return;
    presetRecipe.innerHTML = entries.map(([partId, presetId]) => {
      const part = PRESET_PARTS.find((p) => p.id === partId);
      const meta = PRESET_META.find((m) => m.id === presetId);
      return '<span class="preset-recipe__chip"><strong>' + part.label + '</strong> ← ' + meta.name + '</span>';
    }).join('');
  }

  function syncPresetChrome() {
    presetSub.textContent = 'Loads into your ' + activeMode + ' palette. Nothing is saved until you press Save.';
    presetHint.textContent = presetMixChk.checked
      ? 'Pick which part each preset contributes, then Apply mix. Parts you leave unset stay as they are.'
      : "Click a preset to load it into the palette you're editing.";
    document.querySelectorAll('[data-preset-tab]').forEach((b) => {
      const on = b.dataset.presetTab === presetTab;
      b.classList.toggle('is-active', on);
      b.setAttribute('aria-pressed', on ? 'true' : 'false');
    });
  }

  function openPresetModal() {
    // Default the tab to the palette being edited — loading a dark preset
    // into the light palette is almost always a mistake.
    presetTab = activeMode;
    syncPresetChrome();
    renderPresetGrid();
    renderRecipe();
    presetModal.hidden = false;
  }
  function closePresetModal() { presetModal.hidden = true; }

  document.querySelector('[data-preset-open]').addEventListener('click', openPresetModal);
  document.querySelector('[data-preset-close]').addEventListener('click', closePresetModal);
  presetModal.addEventListener('click', (e) => { if (e.target === presetModal) closePresetModal(); });

  document.querySelectorAll('[data-preset-tab]').forEach((b) => {
    b.addEventListener('click', () => {
      presetTab = b.dataset.presetTab;
      syncPresetChrome();
      renderPresetGrid();
    });
  });

  presetMixChk.addEventListener('change', () => {
    if (!presetMixChk.checked) mixRecipe = {};
    syncPresetChrome();
    renderPresetGrid();
    renderRecipe();
  });

  presetGrid.addEventListener('click', (e) => {
    const part = e.target.closest('[data-mix-part]');
    if (part) {
      const { mixPart, mixPreset } = part.dataset;
      // Clicking the part already assigned to this preset unassigns it.
      if (mixRecipe[mixPart] === mixPreset) delete mixRecipe[mixPart];
      else mixRecipe[mixPart] = mixPreset;
      renderPresetGrid();
      renderRecipe();
      return;
    }
    const pick = e.target.closest('[data-preset-pick]');
    if (!pick) return;
    const id = pick.dataset.presetPick;
    if (presetMixChk.checked) {
      // In mix mode the card body assigns EVERY part to this preset — a fast
      // "start from this one, then swap a part or two".
      PRESET_PARTS.forEach((p) => { mixRecipe[p.id] = id; });
      renderPresetGrid();
      renderRecipe();
      return;
    }
    applyPalette(PRESETS[id], PRESET_META.find((m) => m.id === id).name);
    closePresetModal();
  });

  document.querySelector('[data-preset-clear]').addEventListener('click', () => {
    mixRecipe = {};
    renderPresetGrid();
    renderRecipe();
  });

  document.querySelector('[data-preset-apply]').addEventListener('click', () => {
    const merged = {};
    Object.entries(mixRecipe).forEach(([partId, presetId]) => {
      PRESET_PARTS.find((p) => p.id === partId).tokens.forEach((tk) => {
        merged[tk] = presetValue(presetId, tk);
      });
    });
    // Tokens belonging to a part the owner DIDN'T choose keep their current
    // value rather than snapping back to the default — a mix is additive, not
    // a reset. Tokens outside every part (the events band, the page
    // background) are deliberately left absent so applyPalette re-derives them
    // from the merged surfaces; filling them in here would freeze them at the
    // previous theme's values.
    const partTokens = new Set(PRESET_PARTS.flatMap((p) => p.tokens));
    partTokens.forEach((tk) => {
      if (merged[tk] == null) merged[tk] = resolved(activeMode, tk);
    });
    applyPalette(merged, 'Mixed palette');
    mixRecipe = {};
    renderPresetGrid();
    renderRecipe();
    closePresetModal();
  });

  // ────────────────────────────────────────────────────────────────────────────
  // SEARCH / FILTER
  // ────────────────────────────────────────────────────────────────────────────
  const searchInput      = document.querySelector('[data-search]');
  const modifiedOnlyChk  = document.querySelector('[data-modified-only]');

  function _applyFilter() {
    const q    = searchInput.value.trim().toLowerCase();
    const mOnly = modifiedOnlyChk.checked;
    rows.forEach((r) => {
      const matchQ = !q || r.dataset.searchKey.includes(q);
      const matchM = !mOnly || (curMap()[r.dataset.token] !== undefined &&
                                curMap()[r.dataset.token].toUpperCase() !== rowDefault(r));
      r.classList.toggle('is-hidden', !(matchQ && matchM));
    });
    document.querySelectorAll('[data-group]').forEach((g) => {
      const visible = g.querySelectorAll('[data-row]:not(.is-hidden)').length;
      g.style.display = visible ? '' : 'none';
    });
  }

  searchInput.addEventListener('input', _applyFilter);
  modifiedOnlyChk.addEventListener('change', _applyFilter);

  // ────────────────────────────────────────────────────────────────────────────
  // GROUP COLLAPSE / EXPAND
  // ────────────────────────────────────────────────────────────────────────────
  document.querySelectorAll('[data-group-toggle]').forEach((toggle) => {
    toggle.addEventListener('click', () => {
      toggle.closest('[data-group]').classList.toggle('is-collapsed');
    });
  });

  // ────────────────────────────────────────────────────────────────────────────
  // PALETTE POPUP
  // ────────────────────────────────────────────────────────────────────────────
  const palettePopup = document.querySelector('[data-palette-popup]');
  const paletteGrid  = document.querySelector('[data-palette-grid]');
  let activePaletteRow = null;

  function _openPalettePopup(btn, targetRow) {
    activePaletteRow = targetRow;

    // Populate swatches with all current COLOUR token values (scalars have
    // no swatch to offer).
    paletteGrid.innerHTML = '';
    rows.forEach((r) => {
      const tk  = r.dataset.token;
      if (isScalar(tk)) return;
      const val = resolved(activeMode, tk);
      const label = r.querySelector('.row__name').firstChild.textContent.trim();
      const sw = document.createElement('button');
      sw.className = 'palette-swatch';
      sw.style.background = val;
      sw.title = label + '\n' + val;
      sw.setAttribute('data-swatch-value', val);
      sw.setAttribute('aria-label', label + ': ' + val);
      paletteGrid.appendChild(sw);
    });

    // Position near button
    const rect = btn.getBoundingClientRect();
    const top  = rect.bottom + window.scrollY + 4;
    const left = Math.min(rect.left + window.scrollX, window.innerWidth - 230);
    palettePopup.style.top  = top  + 'px';
    palettePopup.style.left = left + 'px';
    palettePopup.hidden = false;
  }

  rows.forEach((row) => {
    const btn = row.querySelector('[data-palette-btn]');   // scalar rows have none
    if (!btn) return;
    btn.addEventListener('click', function (e) {
      if (!palettePopup.hidden && activePaletteRow === row) {
        palettePopup.hidden = true; activePaletteRow = null; return;
      }
      _openPalettePopup(this, row);
      e.stopPropagation();
    });
  });

  paletteGrid.addEventListener('click', (e) => {
    const sw = e.target.closest('.palette-swatch');
    if (!sw || !activePaletteRow) return;
    applyToken(activePaletteRow.dataset.token, sw.dataset.swatchValue);
    palettePopup.hidden = true;
    activePaletteRow = null;
  });

  document.addEventListener('click', (e) => {
    if (!palettePopup.hidden && !palettePopup.contains(e.target)) {
      palettePopup.hidden = true; activePaletteRow = null;
    }
  });

  // ────────────────────────────────────────────────────────────────────────────
  // KEYBOARD SHORTCUTS
  // ────────────────────────────────────────────────────────────────────────────
  document.addEventListener('keydown', (e) => {
    const meta = e.metaKey || e.ctrlKey;
    if (meta && !e.shiftKey && e.key === 's') {
      e.preventDefault();
      if (_countPending() > 0) save();
    }
    if (meta && !e.shiftKey && (e.key === 'z' || e.key === 'Z')) {
      e.preventDefault();
      undo();
    }
    if (e.key === 'Escape') {
      palettePopup.hidden = true;
      activePaletteRow = null;
      if (!exportModal.hidden)   exportModal.hidden = true;
      if (!presetModal.hidden)   closePresetModal();
      if (!legModal.hidden)      legModal.hidden = true;
    }
  });

  // ────────────────────────────────────────────────────────────────────────────
  // CONTRAST
  // ────────────────────────────────────────────────────────────────────────────
  function _relLum(hex) {
    const m = hex.replace('#','').match(/.{2}/g);
    if (!m) return 0;
    const [r, g, b] = m.map((s) => {
      let c = parseInt(s, 16) / 255;
      return c <= 0.03928 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4);
    });
    return 0.2126 * r + 0.7152 * g + 0.0722 * b;
  }
  function _contrastRatio(a, b) {
    const la = _relLum(a), lb = _relLum(b);
    const [lo, hi] = la > lb ? [lb, la] : [la, lb];
    return (hi + 0.05) / (lo + 0.05);
  }

  // (PAIRINGS is declared at the top of this IIFE — the first renderMode()
  // reads it before this point in the file.)

  /** Every failing pairing in a mode, worst first.
   *  Token names and resolved hexes are kept under SEPARATE keys — the Fix
   *  button needs the token to call applyToken, and the sample swatch needs
   *  the hex. */
  function _failures(mode) {
    const out = [];
    PAIRINGS.forEach((p) => {
      const fgHex = resolved(mode, p.fg);
      const bgHex = resolved(mode, p.bg);
      if (!fgHex || !bgHex || fgHex[0] !== '#' || bgHex[0] !== '#') return;
      const ratio = _contrastRatio(fgHex, bgHex);
      const min = p.big ? 3 : 4.5;
      if (ratio < min) {
        out.push({
          fgToken: p.fg, bgToken: p.bg, where: p.where,
          fgHex, bgHex, ratio, min, severe: ratio < SEVERE_BELOW,
        });
      }
    });
    return out.sort((a, b) => a.ratio - b.ratio);
  }

  function _refreshAllContrast() {
    // Per-row badge = the worst pairing that row's token takes part in.
    const worst = {};
    PAIRINGS.forEach((p) => {
      const fg = resolved(activeMode, p.fg);
      const bg = resolved(activeMode, p.bg);
      if (!fg || !bg || fg[0] !== '#' || bg[0] !== '#') return;
      const ratio = _contrastRatio(fg, bg);
      [p.fg, p.bg].forEach((tk) => {
        if (!worst[tk] || ratio < worst[tk].ratio) worst[tk] = { ratio, min: p.big ? 3 : 4.5, other: tk === p.fg ? p.bg : p.fg };
      });
    });

    rows.forEach((row) => {
      const badge = row.querySelector('[data-contrast]');
      const w = worst[row.dataset.token];
      if (!w) { badge.textContent = ''; badge.className = 'row__contrast'; badge.title = ''; return; }
      let band;
      if      (w.ratio < SEVERE_BELOW) band = 'lo';
      else if (w.ratio < w.min)        band = 'warn';
      else if (w.ratio >= 7)           band = 'aaa';
      else                             band = 'aa';
      badge.textContent = w.ratio.toFixed(1) + ':1';
      badge.className   = 'row__contrast row__contrast--' + band;
      badge.title = 'Worst pairing: against ' + w.other + ' (needs ' + w.min + ':1)';
    });

    _refreshLegibility();
  }

  // ── Legibility report (DOM refs live up in the UI REFS block) ───────────────
  function _refreshLegibility() {
    const fails  = _failures(activeMode);
    const severe = fails.filter((f) => f.severe).length;
    // Only an invisible-text pairing gets the loud badge; the softer warnings
    // wait quietly inside the report.
    legBadge.hidden = severe === 0 && fails.length === 0;
    legBadge.classList.toggle('is-severe', severe > 0);
    legBadge.textContent = severe > 0
      ? severe + (severe === 1 ? ' text is invisible' : ' texts are invisible')
      : fails.length + ' to check';
    if (!legModal.hidden) _renderLegibility();
  }

  /** Darken or lighten `hex` until it clears `ratio` against `bg`. Walks
   *  towards whichever end (black or white) the background isn't, so the
   *  suggestion keeps the owner's hue instead of snapping to a preset. */
  function _fixToward(hex, bg, ratio) {
    const bgLum = _relLum(bg);
    const toWhite = bgLum < 0.5;
    const m = hex.replace('#', '').match(/.{2}/g).map((s) => parseInt(s, 16));
    for (let step = 0; step <= 100; step++) {
      const t = step / 100;
      const rgb = m.map((c) => Math.round(toWhite ? c + (255 - c) * t : c * (1 - t)));
      const cand = '#' + rgb.map((c) => c.toString(16).padStart(2, '0')).join('').toUpperCase();
      if (_contrastRatio(cand, bg) >= ratio) return cand;
    }
    return toWhite ? '#FFFFFF' : '#000000';
  }

  function _renderLegibility() {
    const fails = _failures(activeMode);
    if (!fails.length) {
      legList.innerHTML = '<p class="legibility-ok">Everything reads clearly in ' + activeMode + ' mode. ✓</p>';
      return;
    }
    legList.innerHTML = fails.map((f, i) => {
      const fix = _fixToward(f.fgHex, f.bgHex, f.min);
      return '' +
        '<div class="legibility-row' + (f.severe ? ' is-severe' : '') + '">' +
          '<span class="legibility-row__sample" style="background:' + f.bgHex + ';color:' + f.fgHex + '">Aa</span>' +
          '<span class="legibility-row__meta">' +
            '<span class="legibility-row__where">' + f.where + '</span>' +
            '<span class="legibility-row__pair">' +
              (f.severe ? '<strong class="legibility-row__flag">Invisible</strong> ' : '') +
              '<code>' + f.fgToken + '</code> on <code>' + f.bgToken + '</code> · ' +
              f.ratio.toFixed(2) + ':1, needs ' + f.min + ':1</span>' +
          '</span>' +
          '<span class="legibility-row__fix">' +
            '<span class="legibility-row__swatch" style="background:' + fix + '"></span>' +
            // Name the token being changed: the fix always lightens/darkens
            // the FOREGROUND, which isn't always the one the owner just
            // edited, and silently moving a different colour is confusing.
            '<button type="button" class="btn btn-top btn-top--ghost" data-leg-fix="' + i + '"' +
              ' title="Sets ' + f.fgToken + ' to ' + fix + '"' +
              ' data-leg-token="' + f.fgToken + '" data-leg-value="' + fix + '">Fix ' +
              f.fgToken.replace(/^--/, '') + '</button>' +
          '</span>' +
        '</div>';
    }).join('');
  }

  legBadge.addEventListener('click', () => {
    _renderLegibility();
    legModal.hidden = false;
  });
  document.querySelector('[data-legibility-close]').addEventListener('click', () => { legModal.hidden = true; });
  legModal.addEventListener('click', (e) => { if (e.target === legModal) legModal.hidden = true; });
  legList.addEventListener('click', (e) => {
    const btn = e.target.closest('[data-leg-fix]');
    if (!btn) return;
    applyToken(btn.dataset.legToken, btn.dataset.legValue);
    _renderLegibility();
  });

  // ────────────────────────────────────────────────────────────────────────────
  // HIGHLIGHT PREVIEW FRAGMENTS
  // ────────────────────────────────────────────────────────────────────────────
  let highlightTimer = null;

  function _highlight(token) {
    const short = token.replace(/^--/, '');
    document.querySelectorAll('.preview-fragment.is-highlighted')
      .forEach((el) => el.classList.remove('is-highlighted'));
    requestAnimationFrame(() => {
      document.querySelectorAll('.preview-fragment').forEach((el) => {
        const uses = (el.dataset.uses || '').split(',').map((s) => s.trim());
        if (uses.includes(short)) el.classList.add('is-highlighted');
      });
    });
    clearTimeout(highlightTimer);
    highlightTimer = setTimeout(() => {
      document.querySelectorAll('.preview-fragment.is-highlighted')
        .forEach((el) => el.classList.remove('is-highlighted'));
    }, 1600);
  }

  // ────────────────────────────────────────────────────────────────────────────
  // TOAST
  // ────────────────────────────────────────────────────────────────────────────
  let toastTimer = null;
  function showToast(msg) {
    toastEl.textContent = msg;
    toastEl.classList.add('is-visible');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => toastEl.classList.remove('is-visible'), 1800);
  }

  // ────────────────────────────────────────────────────────────────────────────
  // EXPORT MODAL
  // ────────────────────────────────────────────────────────────────────────────
  const exportModal    = document.querySelector('[data-export-modal]');
  const exportTextarea = document.querySelector('[data-export-textarea]');
  let exportMode = 'full';

  function _buildCss(which) {
    // Exports the ACTIVE mode, wrapped in the selector it ships under:
    //   light → :root { … }    dark → html[data-theme="dark"] { … }
    const sel = activeMode === 'dark' ? 'html[data-theme="dark"]' : ':root';
    const lines = [];
    rows.forEach((row) => {
      const token = row.dataset.token;
      const value = resolved(activeMode, token);
      if (which === 'changed' && value === rowDefault(row)) return;
      lines.push('  ' + token.padEnd(22) + ': ' + value + ';');
    });
    if (which === 'changed' && lines.length === 0) return '/* No changes from default */';
    return sel + ' {\n' + lines.join('\n') + '\n}';
  }

  document.querySelector('[data-export]').addEventListener('click', () => {
    exportTextarea.value = _buildCss(exportMode);
    exportModal.hidden = false;
    exportTextarea.select();
  });

  document.querySelectorAll('[data-export-tab]').forEach((tab) => {
    tab.addEventListener('click', () => {
      exportMode = tab.dataset.exportTab;
      document.querySelectorAll('[data-export-tab]').forEach((t) =>
        t.classList.toggle('is-active', t === tab));
      exportTextarea.value = _buildCss(exportMode);
    });
  });

  document.querySelector('[data-export-close]').addEventListener('click', () => {
    exportModal.hidden = true;
  });

  document.querySelector('[data-export-copy]').addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(exportTextarea.value); }
    catch (_) { exportTextarea.select(); exportTextarea.setSelectionRange(0, 99999); }
    const btn = document.querySelector('[data-export-copy]');
    const orig = btn.textContent;
    btn.textContent = 'Copied!';
    setTimeout(() => { btn.textContent = orig; }, 1400);
  });

  exportModal.addEventListener('click', (e) => {
    if (e.target === exportModal) exportModal.hidden = true;
  });

  // ────────────────────────────────────────────────────────────────────────────
  // HELPERS
  // ────────────────────────────────────────────────────────────────────────────
  function _normaliseHex(v) {
    if (!v) return null;
    v = String(v).trim();
    if (!v.startsWith('#')) v = '#' + v;
    if (v.length === 4) v = '#' + v[1]+v[1] + v[2]+v[2] + v[3]+v[3];
    if (!/^#[0-9a-fA-F]{6}$/.test(v)) return null;
    return v.toUpperCase();
  }

  /** Clamp a slider value to its row's declared min/max. Returns a plain
   *  integer string — the same shape the server stores and the CSS reads. */
  function _normaliseScalar(row, v) {
    const n = Number(String(v).trim());
    if (!Number.isFinite(n)) return null;
    const range = row.querySelector('[data-range]');
    const lo = range ? Number(range.min) : 0;
    const hi = range ? Number(range.max) : 100;
    return String(Math.round(Math.min(hi, Math.max(lo, n))));
  }

})();
</script>
</body>
</html>
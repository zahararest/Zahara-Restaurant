---
// The opening of the two-venue events page — and, once a venue is chosen, its
// hero. ONE element in three states, driven by `data-venue` on the page root:
//
//   ''         The title in a band of its own, and under it two doors — side by
//              side on a desk, stacked on a phone — filling the rest of the
//              screen. Nothing else on the page is shown yet: the page asks
//              before it tells.
//   'zahara'   The band folds away, the chosen door widens into the full-width
//   'rooftop'  hero, and the other closes — to a slim spine on a desk (still a
//              door: press it to cross over), to nothing on a phone, where a
//              line at the foot of the photograph does that job instead.
//
// The move between states is a camera pan — the grid tracks slide, the
// photographs re-crop as their frames change — never a cut.
//
// The title has its own band rather than floating over the photographs: it is
// a full sentence ("private events at a kosher chef restaurant in Jerusalem,
// 24 to 100 guests"), and a band that grows with it can never be too small for
// it, whatever the screen or the owner's wording. It also leaves the
// photographs uncovered — they are the reason anyone books here.
//
// DESIGN NOTE — like /reserve/, this is a sanctioned break of pillar 1's "no
// half-and-half splits": the split is the content, two venues at equal weight.
// It lasts only until the visitor chooses; from then on the page has the
// single full-bleed photograph pillar 1 asks for.
//
// No-JS: `data-venue` is never set, the stage stays a static split, and each
// door is a plain link down to its venue's section — everything else on the
// page is simply shown.

import { PHOTOS } from '../../data/photos';
import { pick, events2Page } from '../../data/i18n';
import { resized, resizedCover, resizedSrcset, resizedMobileCoverSrcset, mediaSlot } from '../../lib/photo';
import type { Lang } from '../../data/i18n';
import { DOOR_WIDTHS, DOOR_MOBILE, DOOR_QUALITY, DOOR_SIZES } from './frames';

export interface Props { lang: Lang }
const { lang } = Astro.props;
const t = pick(events2Page, lang);

// The arrow points the way the line reads.
const arrow = lang === 'he' ? '←' : '→';

const doors = [
  {
    id: 'zahara', key: 'ev2Zahara', photo: PHOTOS.ev2Zahara, latin: lang === 'en',
    eyebrow: t.zDoorEyebrow, name: t.zName, line: t.zDoorLine, cta: t.zDoorCta,
  },
  {
    id: 'rooftop', key: 'ev2Rooftop', photo: PHOTOS.ev2Rooftop, latin: true,
    eyebrow: t.rDoorEyebrow, name: t.rName, line: t.rDoorLine, cta: t.rDoorCta,
  },
] as const;
---

<section class="ev2-stage" aria-labelledby="ev2-question" data-ev2-stage>
  {/* The title band — the page's <h1>. Folds away once a venue is chosen. */}
  <header class="ev2-stage__head" data-ev2-head>
    <p class="ev2-stage__eyebrow" data-content-key="events2.eyebrow">{t.eyebrow}</p>
    <h1 class="ev2-stage__title" id="ev2-question" data-content-key="events2.question">{t.question}</h1>
  </header>

  {doors.map((d, i) => (
    <div class={`ev2-door ev2-door--${d.id}`} data-door={d.id} style={`--stagger:${i * 140}ms`}>
      {/* A media slot: /admin/images can put a clip in either door. */}
      <div class="ev2-door__media"
           {...mediaSlot(d.key, d.photo.src, {
             poster: resized(d.photo.src, 1280, DOOR_QUALITY),
             className: 'ev2-door__photo', mobile: true, eager: true,
           })}>
        <picture>
          <source media="(max-width: 600px)"
                  srcset={resizedMobileCoverSrcset(d.photo.src, DOOR_MOBILE, DOOR_QUALITY)}
                  sizes="100vw" />
          <img
            class="ev2-door__photo"
            src={resized(d.photo.src, 1280, DOOR_QUALITY)}
            srcset={resizedSrcset(d.photo.src, DOOR_WIDTHS, DOOR_QUALITY)}
            sizes={DOOR_SIZES}
            alt=""
            width="1280" height="1600"
            loading="eager"
            decoding="async"
            fetchpriority={i === 0 ? 'high' : 'auto'}
            data-door-img
          />
        </picture>
      </div>
      <span class="ev2-door__scrim" aria-hidden="true"></span>

      <div class="ev2-door__body">
        <p class="ev2-door__eyebrow" data-content-key={`events2.${d.id}.doorEyebrow`}>{d.eyebrow}</p>
        <p class={`ev2-door__name${d.latin ? ' ev2-door__name--latin' : ''}`}
           data-content-key={`events2.${d.id}.name`}>{d.name}</p>
        <p class="ev2-door__line" data-content-key={`events2.${d.id}.doorLine`}>{d.line}</p>
        {/* The whole door answers the press — this link's ::after is stretched
            over it — but the link itself is drawn as a real button, a full
            44px tall, so it reads as the thing to press. Gone once its venue
            is open. */}
        <a class="ev2-door__cta" href={`#${d.id}`} data-venue-link={d.id} data-venue-via="door">
          <span data-content-key={`events2.${d.id}.doorCta`}>{d.cta}</span>
          <span class="ev2-door__arrow" aria-hidden="true">{arrow}</span>
        </a>
      </div>

      {/* What a closed door shows on a desk: its name, turned on its side like
          a book's spine. Decorative — the link above still names the door. */}
      <span class={`ev2-door__spine${d.latin ? ' ev2-door__spine--latin' : ''}`} aria-hidden="true"
            data-content-key={`events2.${d.id}.name`}>{d.name}</span>
    </div>
  ))}

  {/* Phones only: once a venue is open the other door has closed completely
      (a spine has no room on a narrow screen), so the way across is a button
      at the foot of the photograph — paper on the picture, with a glimpse of
      the other door in it, so it can't be taken for a caption. Each shows
      while the OTHER venue is. The glimpse is lazy: on a desk the button is
      never displayed, so it is never fetched. */}
  <div class="ev2-stage__other">
    <a href="#rooftop" data-venue-link="rooftop" data-venue-via="other" data-venue-only="zahara">
      <img class="ev2-stage__other-thumb" src={resizedCover(PHOTOS.ev2Rooftop.src, 132, 132, 72)}
           alt="" width="132" height="132" loading="lazy" decoding="async" />
      <span class="ev2-stage__other-text" data-content-key="events2.rooftop.switchTo">{t.rSwitchTo}</span>
      <span class="ev2-door__arrow" aria-hidden="true">{arrow}</span>
    </a>
    <a href="#zahara" data-venue-link="zahara" data-venue-via="other" data-venue-only="rooftop">
      <img class="ev2-stage__other-thumb" src={resizedCover(PHOTOS.ev2Zahara.src, 132, 132, 72)}
           alt="" width="132" height="132" loading="lazy" decoding="async" />
      <span class="ev2-stage__other-text" data-content-key="events2.zahara.switchTo">{t.zSwitchTo}</span>
      <span class="ev2-door__arrow" aria-hidden="true">{arrow}</span>
    </a>
  </div>
</section>

<style>
  /* ── The stage ────────────────────────────────────────────────────────
     Tucked under the header like every photo-first page; the title band
     starts behind it and pads itself clear. While choosing, the band takes
     the height its words need (`auto`) and the doors share the rest. To MOVE
     between states the page's script first pins the band's height in
     --head-h (`.is-measured`), because `auto` doesn't interpolate and these
     explicit tracks do: percentages, lengths and calc() on both sides of
     every change, which is what lets the doors slide rather than jump. */
  .ev2-stage {
    --ajar: 4.75rem;              /* a closed door's spine, on a desk */
    --stage-open: 74svh;          /* the hero, once a venue is chosen */
    --head-h: 10rem;              /* replaced by the measured band height */
    --pan: 1.1s var(--ease-out);
    position: relative;
    display: grid;
    grid-template-columns: 100%;
    grid-template-rows: auto 1fr 1fr;
    block-size: 100vh;
    /* The screen, less the cookie bar while it shows (--consent-h, kept by
       Chrome.astro): both doors and their buttons stay above it. */
    block-size: calc(100svh - var(--consent-h, 0px));
    min-block-size: 30rem;
    margin-block-start: calc(var(--header-h) * -1);
    overflow: hidden;
    /* Paper behind the photographs while they arrive: this page is light. */
    background: var(--paper-deep);
    transition:
      grid-template-rows var(--pan),
      grid-template-columns var(--pan),
      block-size var(--pan),
      min-block-size var(--pan);
  }
  .ev2-stage.is-measured {
    grid-template-rows: var(--head-h) calc((100% - var(--head-h)) / 2) calc((100% - var(--head-h)) / 2);
  }
  @media (min-width: 900px) {
    .ev2-stage {
      --stage-open: min(82svh, 58rem);
      grid-template-columns: 50% 50%;
      grid-template-rows: auto 1fr;
    }
    .ev2-stage.is-measured { grid-template-rows: var(--head-h) calc(100% - var(--head-h)); }
  }

  /* A venue is open: the band has folded away and one door is the hero. */
  :global(.ev2[data-venue='zahara']) .ev2-stage,
  :global(.ev2[data-venue='rooftop']) .ev2-stage {
    block-size: var(--stage-open);
    min-block-size: 26rem;
  }
  :global(.ev2[data-venue='zahara']) .ev2-stage  { grid-template-rows: 0px 100% 0%; }
  :global(.ev2[data-venue='rooftop']) .ev2-stage { grid-template-rows: 0px 0% 100%; }
  @media (min-width: 900px) {
    :global(.ev2[data-venue='zahara']) .ev2-stage,
    :global(.ev2[data-venue='rooftop']) .ev2-stage { grid-template-rows: 0px 100%; }
    :global(.ev2[data-venue='zahara']) .ev2-stage  { grid-template-columns: calc(100% - var(--ajar)) var(--ajar); }
    :global(.ev2[data-venue='rooftop']) .ev2-stage { grid-template-columns: var(--ajar) calc(100% - var(--ajar)); }
  }
  /* The closed door opens a crack under the pointer — an invitation, not a
     reveal. Same grid, so it slides like everything else. */
  @media (hover: hover) and (min-width: 900px) {
    :global(.ev2[data-venue='zahara']) .ev2-stage:has(.ev2-door--rooftop:hover),
    :global(.ev2[data-venue='rooftop']) .ev2-stage:has(.ev2-door--zahara:hover) { --ajar: 6.25rem; }
  }

  /* ── The title band ───────────────────────────────────────────────── */
  .ev2-stage__head {
    grid-column: 1 / -1;
    position: relative;
    z-index: 3;
    min-block-size: 0;
    overflow: hidden;
    display: grid;
    justify-items: center;
    align-content: end;
    gap: 0.5rem;
    padding: calc(var(--header-h) + clamp(0.9rem, 2.8vh, 2rem)) clamp(1rem, 5vw, 2.5rem) clamp(1.1rem, 3vh, 2.1rem);
    text-align: center;
    background: var(--paper);
    border-block-end: 1px solid var(--rule-soft);
    transition: opacity 0.4s var(--ease-out);
  }
  .ev2-stage__eyebrow {
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-size: var(--step--2);
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--ink-muted);
    font-weight: 600;
  }
  .ev2-stage__eyebrow::before,
  .ev2-stage__eyebrow::after {
    content: '';
    inline-size: 1.4rem;
    block-size: 1px;
    background: var(--accent);
  }
  /* Sized to the sentence it now holds: it steps down with the screen, wraps
     into balanced lines, and the band grows with it — there is no box for it
     to overflow. */
  .ev2-stage__title {
    margin: 0;
    max-inline-size: 26em;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.32rem, 0.98rem + 1.9vw, 2.45rem);
    line-height: 1.2;
    letter-spacing: -0.012em;
    color: var(--ink);
    text-wrap: balance;
    overflow-wrap: anywhere;
  }
  .ev2-stage__eyebrow:empty,
  .ev2-stage__title:empty { display: none; }
  /* Answered — folded away, but still the page's <h1> to a screen reader. */
  :global(.ev2[data-venue='zahara']) .ev2-stage__head,
  :global(.ev2[data-venue='rooftop']) .ev2-stage__head { opacity: 0; }

  /* ── One door ─────────────────────────────────────────────────────── */
  .ev2-door {
    position: relative;
    isolation: isolate;
    display: grid;
    place-items: center;
    min-block-size: 0;
    min-inline-size: 0;
    overflow: hidden;
    color: var(--paper-on-photo);
    transition: padding var(--pan);
    /* Each door measures itself, so its words fit whatever is left for it
       — the title above can take two lines or three, Hebrew or English, on
       a 320px phone or a desk. See the @container rules below. */
    container: door / size;
  }
  /* A hairline seam where the two photographs meet — a join, not a border. */
  .ev2-door + .ev2-door { box-shadow: inset 0 1px 0 color-mix(in srgb, var(--paper-on-photo) 30%, transparent); }
  @media (min-width: 900px) {
    .ev2-door + .ev2-door { box-shadow: inset 1px 0 0 color-mix(in srgb, var(--paper-on-photo) 30%, transparent); }
    :global(html[dir='rtl']) .ev2-door + .ev2-door { box-shadow: inset -1px 0 0 color-mix(in srgb, var(--paper-on-photo) 30%, transparent); }
  }
  /* Only an OPEN door carries padding — it clears the header that now sits
     over its photograph. A door's padding is part of its height, so a closed
     one with any could never close to nothing. While choosing, the band
     above has already cleared the header for both. */
  :global(.ev2[data-venue='zahara']) .ev2-door--zahara,
  :global(.ev2[data-venue='rooftop']) .ev2-door--rooftop { padding-block-start: var(--header-h); }

  .ev2-door__media {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .ev2-door__media picture { display: contents; }
  /* One rule for the still and the clip the middleware may put in its place. */
  .ev2-door__photo,
  .ev2-door__media :global(video) {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    filter: saturate(0.96);
    transition: transform 1.2s var(--ease-out), filter 0.8s var(--ease-out);
  }
  /* No blanket darkening — the room has to be seen. Just a soft pool of shade
     behind the words, and a breath at the foot of the frame; the words carry
     their own shadow for the rest. */
  .ev2-door__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(62% 46% at 50% 52%,
        color-mix(in srgb, var(--shadow) 36%, transparent), transparent 74%),
      linear-gradient(to top, color-mix(in srgb, var(--shadow) 26%, transparent), transparent 38%);
    transition: opacity 0.8s var(--ease-out);
  }

  .ev2-door__body {
    display: grid;
    justify-items: center;
    gap: 0.5rem;
    max-inline-size: 36rem;
    padding: clamp(1rem, 4vw, 2.5rem);
    text-align: center;
    text-shadow:
      0 1px 2px color-mix(in srgb, var(--shadow) 60%, transparent),
      0 0 24px color-mix(in srgb, var(--shadow) 45%, transparent);
    transition: opacity 0.45s var(--ease-out);
  }

  .ev2-door__eyebrow {
    margin: 0;
    font-size: var(--step--2);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--paper-on-photo);
  }
  /* The eyebrow's accent rule, above the word — pillar 2's kicker. */
  .ev2-door__eyebrow::before {
    content: '';
    display: block;
    inline-size: 1.6rem;
    block-size: 1px;
    margin: 0 auto 0.6rem;
    background: var(--accent);
  }
  .ev2-door__name {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.4rem, 1.5rem + 4.6vw, 5rem);
    line-height: 1.02;
    letter-spacing: -0.018em;
  }
  /* Latin runs optically larger than the Hebrew wordmark at one size. */
  .ev2-door__name--latin {
    font-size: clamp(2rem, 1.3rem + 3.4vw, 4rem);
  }
  .ev2-door__line {
    margin: 0;
    max-inline-size: 30ch;
    font-size: var(--step-0);
    line-height: 1.5;
    text-wrap: balance;
  }
  /* The door's button: words in a frame, a full 44px tall. */
  .ev2-door__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    min-block-size: 44px;
    margin-block-start: 0.6rem;
    margin-block-start: clamp(0.35rem, 2.4cqh, 0.9rem);
    padding: 0.55rem 1.25rem;
    font-size: var(--step--1);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--paper-on-photo);
    background: color-mix(in srgb, var(--shadow) 34%, transparent);
    border: 1px solid color-mix(in srgb, var(--paper-on-photo) 72%, transparent);
    border-radius: 2px;
    text-shadow: none;
    transition: background 0.3s var(--ease-out), border-color 0.3s var(--ease-out), color 0.3s var(--ease-out);
  }
  :global(html[lang='he']) .ev2-door__cta { letter-spacing: 0.04em; text-transform: none; font-weight: 700; }
  /* The stretched link — the whole door answers the press. */
  .ev2-door__cta::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
  }
  .ev2-door__cta:focus-visible { outline: none; }
  .ev2-door__cta:focus-visible::after {
    outline: 2px solid var(--accent);
    outline-offset: -6px;
  }
  .ev2-door__arrow { color: inherit; }

  .ev2-door__eyebrow:empty,
  .ev2-door__name:empty,
  .ev2-door__line:empty { display: none; }

  /* ── Open ─────────────────────────────────────────────────────────── */
  /* The door that became the hero stops being a link: pressing the room you
     are already in means nothing. */
  :global(.ev2[data-venue='zahara']) .ev2-door--zahara .ev2-door__cta,
  :global(.ev2[data-venue='rooftop']) .ev2-door--rooftop .ev2-door__cta { display: none; }

  /* ── Closed ───────────────────────────────────────────────────────── */
  /* Its words go first, and fast, so they never squeeze into a narrowing
     frame. Opacity, not visibility: the stretched link is still the way
     across. The photograph steps back a little so the spine reads on it. */
  :global(.ev2[data-venue='zahara']) .ev2-door--rooftop .ev2-door__body,
  :global(.ev2[data-venue='rooftop']) .ev2-door--zahara .ev2-door__body {
    opacity: 0;
    transition-duration: 0.25s;
  }
  :global(.ev2[data-venue='zahara']) .ev2-door--rooftop .ev2-door__photo,
  :global(.ev2[data-venue='rooftop']) .ev2-door--zahara .ev2-door__photo { filter: saturate(0.9) brightness(0.74); }
  /* On a phone a closed door is gone — out of the tab order too, once it has
     finished closing. */
  @media (max-width: 899px) {
    :global(.ev2[data-venue='zahara']) .ev2-door--rooftop,
    :global(.ev2[data-venue='rooftop']) .ev2-door--zahara {
      visibility: hidden;
      transition: padding var(--pan), visibility 0s linear 1.1s;
    }
  }

  .ev2-door__spine {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: none;
    place-items: center;
    /* Physical, on purpose: in a vertical writing mode "block-start" is the
       RIGHT edge, and a logical padding here pushed the name sideways out of
       its own spine instead of down past the header. */
    padding-top: var(--header-h);
    writing-mode: vertical-rl;
    font-family: var(--font-display);
    font-size: var(--step-1);
    letter-spacing: 0.04em;
    white-space: nowrap;
    color: var(--paper-on-photo);
    text-shadow: 0 1px 10px color-mix(in srgb, var(--shadow) 60%, transparent);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.6s var(--ease-out) 0.35s, color 0.4s var(--ease-out);
  }
  .ev2-door__spine--latin { font-size: var(--step--1); letter-spacing: 0.24em; text-transform: uppercase; }
  @media (min-width: 900px) {
    .ev2-door__spine { display: grid; }
    :global(.ev2[data-venue='zahara']) .ev2-door--rooftop .ev2-door__spine,
    :global(.ev2[data-venue='rooftop']) .ev2-door--zahara .ev2-door__spine { opacity: 1; }
  }

  /* ── The way across, on a phone ───────────────────────────────────── */
  .ev2-stage__other { display: none; }
  @media (max-width: 899px) {
    :global(.ev2[data-venue='zahara']) .ev2-stage__other,
    :global(.ev2[data-venue='rooftop']) .ev2-stage__other {
      position: absolute;
      inset-inline: 0;
      inset-block-end: 0;
      z-index: 3;
      display: flex;
      justify-content: center;
      padding: 0 1rem 1rem;
      animation: ev2-settle 0.8s var(--ease-out) 0.7s backwards;
    }
  }
  /* One link at a time: the way to whichever venue is NOT open. */
  :global(.ev2:not([data-venue='zahara'])) .ev2-stage__other a[data-venue-only='zahara'],
  :global(.ev2:not([data-venue='rooftop'])) .ev2-stage__other a[data-venue-only='rooftop'] { display: none; }
  /* Paper on the photograph — the one light thing on it, so the eye finds
     it — with the other door's picture at its start: a glimpse of where it
     leads. */
  .ev2-stage__other a {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-block-size: 54px;
    padding-block: 0.3rem;
    padding-inline: 0.3rem 1.1rem;
    font-size: var(--step--1);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 600;
    line-height: 1.2;
    color: var(--ink);
    background: color-mix(in srgb, var(--paper) 94%, transparent);
    border: 1px solid color-mix(in srgb, var(--paper-on-photo) 70%, transparent);
    border-radius: 2px;
    box-shadow: 0 14px 30px -16px color-mix(in srgb, var(--shadow) 80%, transparent);
    transition: background 0.25s ease, color 0.25s ease;
  }
  :global(html[lang='he']) .ev2-stage__other a { letter-spacing: 0.04em; text-transform: none; font-weight: 700; }
  .ev2-stage__other-thumb {
    flex: none;
    inline-size: 46px;
    block-size: 46px;
    object-fit: cover;
    border-radius: 1px;
    background: var(--paper-deep);
    filter: saturate(0.96);
  }
  .ev2-stage__other a .ev2-door__arrow { color: var(--accent); }
  @media (hover: hover) {
    .ev2-stage__other a:hover { background: var(--paper); color: var(--accent); }
  }
  .ev2-stage__other a:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

  /* ── Motion — a camera refocusing, nothing more ───────────────────── */
  /* While choosing, on a desk: a slow push-in on the room under the pointer,
     and the other room steps back half a stop. */
  @media (hover: hover) and (min-width: 900px) {
    :global(.ev2[data-venue='']) .ev2-door:hover .ev2-door__photo,

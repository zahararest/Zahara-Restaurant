---
// The enquiry — short on purpose: name, phone and email (the three things we
// need in order to reply) and one optional box for anything else. Everything
// an events coordinator would ask next — the date, the numbers, the occasion —
// is a conversation, and it happens on the phone, not in a form that has to be
// finished before it can be sent.
//
// Which venue the enquiry is for is not a question either: the page already
// knows (it is the venue being read about), so it rides along in a hidden
// field the page's script keeps in step, and the form's heading says it out
// loud. The server puts it at the head of the email's subject line.
//
// Set as the second half of a spread: a photograph of the venue, sticky on a
// desk while the form scrolls beside it, and the form itself raised as a card
// on ground of its own — the one part of the page that asks something of the
// reader should not blend into the paper everything else sits on.
//
// Sending goes to the thank-you page (/events2/thanks/), which shows the venue
// that was asked about. A visitor without JavaScript posts the form natively
// and the server sends them to the same page.

import { PHOTOS } from '../../data/photos';
import { pick, events2Page, contact } from '../../data/i18n';
import { resized, resizedSrcset, mediaSlot } from '../../lib/photo';
import { TURNSTILE_SITEKEY } from '../../data/restaurant';
import { VENUE } from '../../lib/venue';
import type { Lang } from '../../data/i18n';
import { SIDE_WIDTHS, SIDE_SIZES } from './frames';
import Talk from './Talk.astro';

export interface Props { lang: Lang }
const { lang } = Astro.props;
const t = pick(events2Page, lang);
const f = pick(contact, lang);
const thanks = lang === 'he' ? '/events2/thanks/' : '/en/events2/thanks/';

const sides = [
  { id: 'zahara',  key: 'ev2ZaharaForm',  photo: PHOTOS.ev2ZaharaForm },
  { id: 'rooftop', key: 'ev2RooftopForm', photo: PHOTOS.ev2RooftopForm },
] as const;
---

<section class="ev2-inquiry" id="inquiry" aria-labelledby="ev2-form-title" data-ev2-inquiry>
  <div class="ev2-inquiry__side" aria-hidden="true">
    <div class="ev2-inquiry__sticky">
      {sides.map((s) => (
        <div class="ev2-inquiry__frame" data-side={s.id}
             {...mediaSlot(s.key, s.photo.src, { poster: resized(s.photo.src, 1400), className: 'ev2-inquiry__img' })}>
          <img class="ev2-inquiry__img"
               src={resized(s.photo.src, 1400)}
               srcset={resizedSrcset(s.photo.src, SIDE_WIDTHS)}
               sizes={SIDE_SIZES}
               alt="" width="1400" height="1866"
               loading="lazy" decoding="async" />
        </div>
      ))}
    </div>
  </div>

  <div class="ev2-inquiry__panel">
    <div class="ev2-inquiry__inner" data-ev2-card>
      <header class="ev2-inquiry__head">
        <p class="eyebrow" data-venue-only="zahara" data-content-key="events2.zahara.formEyebrow">{t.zFormEyebrow}</p>
        <p class="eyebrow" data-venue-only="rooftop" data-content-key="events2.rooftop.formEyebrow">{t.rFormEyebrow}</p>
        <h2 class="display ev2-inquiry__title" id="ev2-form-title" tabindex="-1">
          <span data-venue-only="zahara" data-content-key="events2.zahara.formHeading">{t.zFormHeading}</span>
          <span data-venue-only="rooftop" data-content-key="events2.rooftop.formHeading">{t.rFormHeading}</span>
        </h2>
        <p class="ev2-inquiry__note" data-content-key="events2.formNote">{t.formNote}</p>
      </header>

      {/* novalidate: the script checks every field at once and marks them all;
          the browser's own bubble stops at the first. A no-JS send is still
          checked by the server. */}
      <form class="ev2-form" method="POST" action="/api/contact" novalidate data-ev2-form
            data-lang={lang}
            data-thanks={thanks}
            data-msg-sending={f.statusSending}
            data-msg-network={f.statusErrNetwork}
            data-msg-general={f.statusErrGeneral}
            data-msg-email={f.statusErrEmail}
            data-msg-required={f.statusErrRequired}>
        <input type="hidden" name="inquiry_type" value="event" />
        {/* Set by the page to the venue on show. Empty without JavaScript —
            then the page shows both venues, and the enquiry claims neither. */}
        <input type="hidden" name="venue" value="" data-venue-input />

        <div class="ev2-row">
          <div class="ev2-field">
            <label class="ev2-label" for="ev2-name">
              <span data-content-key="contact.fieldName">{f.fieldName}</span>
              <span class="field__req" aria-hidden="true">{f.requiredMark}</span>
            </label>
            <input id="ev2-name" name="name" type="text" required autocomplete="name" />
          </div>
          <div class="ev2-field">
            <label class="ev2-label" for="ev2-phone">
              <span data-content-key="contact.fieldPhone">{f.fieldPhone}</span>
              <span class="field__req" aria-hidden="true">{f.requiredMark}</span>
            </label>
            <input id="ev2-phone" name="phone" type="tel" required autocomplete="tel" inputmode="tel" />
          </div>
        </div>
        <div class="ev2-field">
          <label class="ev2-label" for="ev2-email">
            <span data-content-key="contact.fieldEmail">{f.fieldEmail}</span>
            <span class="field__req" aria-hidden="true">{f.requiredMark}</span>
          </label>
          <input id="ev2-email" name="email" type="email" required autocomplete="email" inputmode="email" />
        </div>
        <div class="ev2-field">
          <label class="ev2-label" for="ev2-message">
            <span data-content-key="events2.fieldNotes">{t.fieldNotes}</span>
            <span class="ev2-label__hint">· {f.optionalMark}</span>
          </label>
          <textarea id="ev2-message" name="message" rows="3" maxlength="5000"></textarea>
        </div>
        <p class="ev2-req-note" data-content-key="contact.requiredNote">{f.requiredNote}</p>

        <!-- Honeypot — filled by bots, never by people -->
        <div class="visually-hidden" aria-hidden="true">
          <label for="ev2-website">Leave this empty</label>
          <input id="ev2-website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>

        {/* Cloudflare Turnstile — the server verifies the token it writes into
            this form (functions/api/contact.ts). Fetched late; see below. */}
        {TURNSTILE_SITEKEY && (
          <div class="cf-turnstile ev2-form__turnstile" data-sitekey={TURNSTILE_SITEKEY}
               data-language={lang} data-theme="light"></div>
        )}

        <div class="ev2-form__submit">
          <button class="btn ev2-form__send" type="submit" data-ev2-submit
                  data-content-key="contact.submit">{f.submitEvent}</button>
          <p class="form-status" role="status" aria-live="polite" data-ev2-status></p>
        </div>
      </form>

      {/* The phone and WhatsApp, as words — on this page they live here, not
          as two unlabelled icons in the header. */}
      <Talk lang={lang} phone={VENUE.phone} whatsapp={VENUE.whatsapp} />
    </div>
  </div>
</section>

<style>
  .ev2-inquiry {
    border-block-start: 1px solid var(--rule-soft);
    /* The floating "send an inquiry" button lands here; leave the heading
       clear of the header when it does. */
    scroll-margin-top: var(--header-h);
  }

  /* ── The photograph ───────────────────────────────────────────────── */
  .ev2-inquiry__side { display: none; }
  @media (min-width: 1000px) {
    .ev2-inquiry {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
    .ev2-inquiry__side { display: block; position: relative; }
    .ev2-inquiry__sticky {
      position: sticky;
      inset-block-start: 0;
      block-size: 100vh;
      block-size: 100svh;
      overflow: hidden;
      background: var(--paper-deep);
    }
  }
  /* Both venues' photographs are stacked; the one being asked about shows.
     A cross-fade, like a slide changing in a dark room. */
  .ev2-inquiry__frame {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.9s var(--ease-out);
  }
  :global(.ev2:not([data-venue='rooftop'])) .ev2-inquiry__frame[data-side='zahara'],
  :global(.ev2[data-venue='rooftop']) .ev2-inquiry__frame[data-side='rooftop'] { opacity: 1; }
  .ev2-inquiry__img,
  .ev2-inquiry__frame :global(video) {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    filter: saturate(0.96);
  }

  /* ── The form's half ──────────────────────────────────────────────────
     Ground of its own rather than the paper everything else sits on: the
     events band — the warm field the owner tunes in /admin/colors — deepened
     a step toward --paper-edge, with a pool of accent light behind the form,
     and the form itself raised on it as a card with a gilt edge. */
  .ev2-inquiry__panel {
    position: relative;
    isolation: isolate;
    padding: clamp(3rem, 8vw, 6.5rem) clamp(0.85rem, 4vw, 2.5rem) clamp(3.5rem, 8vw, 6.5rem);
    background:
      radial-gradient(80% 62% at 50% 26%,
        color-mix(in srgb, var(--accent) 34%, transparent), transparent 74%),
      linear-gradient(165deg,
        color-mix(in srgb, var(--events-band-from) 45%, var(--paper-edge)),
        color-mix(in srgb, var(--events-band-to) 70%, var(--paper-edge)));
  }
  .ev2-inquiry__inner {
    max-inline-size: 34rem;
    margin-inline: auto;
    display: grid;
    gap: clamp(1.75rem, 3.5vw, 2.4rem);
    padding: clamp(1.4rem, 5vw, 3rem);
    background: var(--paper-card);
    border: 1px solid color-mix(in srgb, var(--accent) 34%, var(--rule));
    border-block-start: 2px solid var(--accent);
    box-shadow: var(--shadow-2);
  }
  @media (min-width: 1000px) {
    .ev2-inquiry__panel {
      display: grid;
      align-content: center;
      padding-inline: clamp(2.5rem, 5vw, 5.5rem);
    }
    .ev2-inquiry__inner { margin-inline: 0; }
  }
  /* The max-contrast mode the accessibility menu offers flattens the field
     and the glow — they are atmosphere, and it asks for none. */
  :global(html.a11y-contrast) .ev2-inquiry__panel { background: none; }
  :global(html.a11y-contrast) .ev2-inquiry__inner { box-shadow: none; }

  .ev2-inquiry__head { display: grid; gap: 0.7rem; }
  /* On a phone the card is narrow: a little less tracking keeps the venue's
     line ("… · NUCHA ROOFTOP") on one line. */
  @media (max-width: 520px) {
    .ev2-inquiry__head :global(.eyebrow) { letter-spacing: 0.18em; font-size: var(--step--2); }
  }
  .ev2-inquiry__title {
    margin: 0;
    font-size: var(--step-4);
    font-weight: 400;
    line-height: 1.05;
    text-wrap: balance;
  }
  .ev2-inquiry__title:focus { outline: none; }
  .ev2-inquiry__note {
    margin: 0;
    max-inline-size: 44ch;
    font-size: var(--step-0);
    line-height: 1.55;
    color: var(--ink-soft);
  }
  .ev2-inquiry__note:empty { display: none; }

  /* One venue's words at a time. With no script (the root carries no
     data-venue at all) Zahara's show. */
  :global(.ev2:not([data-venue='rooftop'])) .ev2-inquiry [data-venue-only='rooftop'],
  :global(.ev2[data-venue='rooftop']) .ev2-inquiry [data-venue-only='zahara'] { display: none; }

  /* ── The form ─────────────────────────────────────────────────────── */
  .ev2-form { display: grid; gap: clamp(1.4rem, 3vw, 1.75rem); }
  .ev2-row { display: grid; gap: clamp(1.4rem, 3vw, 1.75rem); }
  @media (min-width: 560px) { .ev2-row { grid-template-columns: 1fr 1fr; } }

  .ev2-field { display: grid; gap: 0.35rem; align-content: start; }

  /* Labels: the site's small tracked caps. */
  .ev2-label {
    font-size: var(--step--2);
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--ink-muted);
    font-weight: 600;
  }
  .ev2-label__hint { letter-spacing: 0.02em; text-transform: none; font-weight: 400; }

  /* Written on, not boxed: one rule under the answer, which warms to the
     accent while the field is being filled in. The answer is set in the
     serif — it reads as handwriting on the card, not a value in a widget. */
  .ev2-field input {
    inline-size: 100%;
    min-block-size: 48px;
    padding: 0.45rem 0 0.55rem;
    font-family: var(--font-display);
    font-size: var(--step-1);
    line-height: 1.3;
    color: var(--ink);
    background: transparent;
    border: 0;
    border-block-end: 1px solid var(--rule);
    border-radius: 0;
    -webkit-appearance: none;
    appearance: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  /* Phone numbers and addresses are read left to right, whatever the page. */
  .ev2-field input[type='tel'],
  .ev2-field input[type='email'] { direction: ltr; text-align: start; }
  :global(html[dir='rtl']) .ev2-field input[type='tel'],
  :global(html[dir='rtl']) .ev2-field input[type='email'] { text-align: right; }

  .ev2-field textarea {
    inline-size: 100%;
    min-block-size: 6.5rem;
    padding: 0.75rem 0.9rem;
    font: inherit;
    font-size: var(--step-0);
    line-height: 1.6;
    color: var(--ink);
    background: color-mix(in srgb, var(--paper) 55%, transparent);
    border: 1px solid var(--rule);
    border-radius: 0;
    resize: vertical;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .ev2-field input:focus,
  .ev2-field textarea:focus {
    /* Transparent, not none: forced-colours mode paints it. */
    outline: 2px solid transparent;
    border-color: var(--accent);
  }
  .ev2-field input:focus { box-shadow: 0 1px 0 0 var(--accent); }
  .ev2-field textarea:focus { box-shadow: 0 0 0 1px var(--accent); }

  .ev2-field input.is-invalid,
  .ev2-field textarea.is-invalid { border-color: var(--err); }
  .ev2-field input.is-invalid:focus { box-shadow: 0 1px 0 0 var(--err); }

  .ev2-req-note {
    margin: -0.4rem 0 0;
    font-size: var(--step--2);
    letter-spacing: 0.08em;
    color: var(--ink-muted);
  }

  /* ── Send ─────────────────────────────────────────────────────────── */
  .ev2-form__submit { display: grid; gap: 0.75rem; justify-items: start; }
  .ev2-form__send {
    min-inline-size: min(100%, 16rem);
    min-block-size: 50px;
    justify-content: center;
  }
  @media (max-width: 559px) { .ev2-form__send { inline-size: 100%; } }
</style>

{/* Cloudflare Turnstile, fetched LATE. It is by far the heaviest thing on a
    page carrying this form (~800 KiB, and a challenge run on the main
    thread), and the form sits at the bottom of a page nobody reaches in the
    first second — so it loads when the form scrolls into view or the moment
    a field is focused, whichever is first. Until a venue is chosen the form
    is not even displayed, so this costs nothing to anyone who never gets
    that far. The submit handler waits for the token either way. */}
{TURNSTILE_SITEKEY && (
  <script is:inline>
    (function () {
      var card = document.querySelector('[data-ev2-card]');
      var slot = card && card.querySelector('.cf-turnstile');
      if (!card || !slot) return;
      var done = false, io = null;
      function load() {
        if (done) return;
        done = true;
        if (io) io.disconnect();
        card.removeEventListener('focusin', load);
        var j = document.createElement('script');
        j.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js';
        j.async = true;
        j.defer = true;
        document.head.appendChild(j);
      }
      card.addEventListener('focusin', load);
      window.__zaharaLoadTurnstile = load;
      function watch() {
        if (done) return;
        if (!('IntersectionObserver' in window)) { load(); return; }
        io = new IntersectionObserver(function (entries) {
          if (entries.some(function (e) { return e.isIntersecting; })) load();
        });
        io.observe(card);
      }
      if (document.readyState === 'complete') watch();
      else window.addEventListener('load', watch, { once: true });
    })();
  </script>
)}

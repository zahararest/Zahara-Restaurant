---
// "Rather talk?" — the phone and WhatsApp as two real buttons with words on
// them, each a full 44px target. On the events pages they replace the header's
// two unlabelled icons (there is no room in a phone's header to name them),
// and they sit where the decision is made: under the form, and on the
// thank-you page. Tracking needs nothing here — BaseLayout's listener counts
// every tel: and wa.me link by its URL.

import { pick, events2Page } from '../../data/i18n';
import type { Lang } from '../../data/i18n';
import type { Phone } from '../../data/restaurant';

export interface Props {
  lang: Lang;
  phone: Phone;
  whatsapp: string;
  /** Centre the row (the thank-you page) instead of starting it at the edge. */
  center?: boolean;
  /** "Rather talk?" and its two buttons on one line, where there is room
   *  (under the form — every line saved is less to scroll). */
  row?: boolean;
}
const { lang, phone, whatsapp, center = false, row = false } = Astro.props;
const t = pick(events2Page, lang);
const dial = lang === 'he' ? phone.dialHe : phone.dialEn;
---

<div class={`ev2-talk${center ? ' ev2-talk--center' : ''}${row ? ' ev2-talk--row' : ''}`}>
  <p class="ev2-talk__lead" data-content-key="events2.talkLead">{t.talkLead}</p>
  <div class="ev2-talk__actions">
    <a class="ev2-talk__btn" href={`tel:${dial}`}>
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.08 4.18 2 2 0 0 1 4.06 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z" />
      </svg>
      <span data-content-key="events2.talkCall">{t.talkCall}</span>
    </a>
    <a class="ev2-talk__btn" href={whatsapp} target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" class="ev2-talk__fill">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.885-9.885 9.885m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
      </svg>
      <span data-content-key="events2.talkWhatsapp">{t.talkWhatsapp}</span>
    </a>
  </div>
</div>

<style>
  .ev2-talk {
    display: grid;
    gap: 0.7rem;
    padding-block-start: clamp(1.25rem, 3vw, 1.6rem);
    border-block-start: 1px solid var(--rule-soft);
  }
  .ev2-talk--center { justify-items: center; text-align: center; }
  .ev2-talk--row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    padding-block-start: clamp(0.75rem, 1.6vw, 0.9rem);
  }
  .ev2-talk__lead {
    margin: 0;
    font-size: var(--step--1);
    color: var(--ink-muted);
  }
  .ev2-talk__lead:empty { display: none; }
  .ev2-talk__actions { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .ev2-talk--center .ev2-talk__actions { justify-content: center; }
  .ev2-talk__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-block-size: 44px;
    padding: 0.5rem 1.1rem;
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--ink);
    border: 1px solid var(--rule);
    border-radius: 2px;
    background: color-mix(in srgb, var(--paper) 55%, transparent);
    transition: border-color 0.2s ease, color 0.2s ease, background 0.2s ease;
  }
  .ev2-talk__btn svg {
    inline-size: 1.1rem;
    block-size: 1.1rem;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }
  .ev2-talk__btn svg.ev2-talk__fill { fill: currentColor; stroke: none; }
  @media (hover: hover) {
    .ev2-talk__btn:hover { border-color: var(--ink); background: var(--paper); }
  }
  .ev2-talk__btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
</style>

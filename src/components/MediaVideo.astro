---
// Starts the videos the middleware swapped in for their stills.
//
// Where the two frames play DIFFERENT files the <video> arrives with no src —
// only `data-video-src` and `data-video-src-mobile`. One page is served to
// every screen, so that choice can only be made here, in the browser that
// knows how wide it is; setting the src rather than shipping it means exactly
// one file is ever fetched, with no phone downloading a landscape master to
// throw it away. Where ONE file serves both screens there is nothing to
// choose, so the server ships the src itself and the browser starts during
// parse — this script then only paces and frames what is already playing.
//
// A video that belongs to ONE frame only carries `data-video-only` ("desktop"
// or "mobile"). It sits over the still, which is what the other frame shows,
// and it is never loaded on the screen it isn't for — see MEDIA_CSS in
// functions/_middleware.ts for the layout half of that.
//
// Everything else is restraint. These are atmosphere behind text, not media the
// reader came for, so: muted and looping (a background video that makes noise
// is a bug), `playsinline` so iOS doesn't hijack the screen into fullscreen,
// paused when off-screen or when the tab is hidden so it costs nothing to
// scroll past, and never started at all under prefers-reduced-motion.
//
// ── A video frame shows video, or it shows nothing ──────────────────────────
//
// It never shows the photograph it replaced. MEDIA_CSS hides the still on a
// video's own frame from the first paint, and this script does not put it
// back: a clip that fails leaves the frame transparent and the page's own
// background showing through. Watching an old photograph appear for a second
// and then get yanked away as the video cuts in reads as the site loading the
// wrong thing and correcting itself, which is worse than a frame that simply
// fills when it is ready.
//
// The photograph is still in the markup, for the other breakpoint and for
// prefers-reduced-motion — where a still picture is the intended result, not a
// consolation — and `data-media-poster` on the wrapper is how this script
// reaches it in that one case.
//
// `data-video-showing` is now an internal flag only: it records that a frame
// has really decoded, which the stall watchdog and the breakpoint switch both
// need. Nothing in CSS reads it any more.
//
// ── …and a video that won't start has something to press ────────────────────
//
// A browser that CAN decode a clip and still refuses to start it on its own is
// the one case a photograph is the wrong answer: nothing is broken, the
// visitor just landed under iOS Low Power Mode, or Safari's "Auto-Play" set to
// never, or a data saver. None of that is visible from here and none of it can
// be overridden — but all of it yields to a real tap. So `offerTap` reveals
// the button the middleware shipped `hidden` beside every video, and a press
// starts the clip with a user gesture behind it. A clip that cannot be decoded
// never gets the button: there would be nothing behind the press.
---
<script is:inline>
  (function () {
    var vids = document.querySelectorAll('video[data-video-src]');
    if (!vids.length) return;

    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    var phone  = window.matchMedia('(max-width: 600px)');

    /** How long a clip may sit without producing a picture before we stop
     *  waiting and show the photograph. A background loop is a few hundred KB
     *  of an already-warm connection; anything this slow is not going to
     *  arrive in time to be atmosphere. Without this, a file that neither
     *  errors nor decodes — a container the browser half-understands, a range
     *  request that stalls — left the frame waiting forever. */
    var STALL_MS = 8000;

    /** Live watchdog timers, one per video.
     *
     *  Declared HERE, not beside the functions that use it, because `var` only
     *  hoists the declaration and not the assignment: a video whose src the
     *  server shipped can already have errored by the time this script runs,
     *  which calls giveUp() → clearWatchdog() on the very first pass below. A
     *  WeakMap that was still `undefined` at that point threw in the middle of
     *  giveUp, so the rooftop hero kept its dead src and never got its
     *  photograph back — the exact failure this whole file exists to prevent. */
    var timers = new WeakMap();

    /** The photograph this video replaced. It is no longer shipped as the
     *  video's poster — see the note in functions/_middleware.ts — so it lives
     *  on the wrapper until one of the cases below calls for it. */
    function photo(v) {
      var slot = v.parentElement;
      return (slot && slot.getAttribute('data-media-poster')) || '';
    }

    /** The button shipped beside this video, or null. */
    function tap(v) {
      var slot = v.parentElement;
      return slot ? slot.querySelector('[data-video-tap]') : null;
    }

    /** Put the photograph back. Reduced motion ONLY — it is the one case where
     *  a still picture is the intended result rather than a consolation. A
     *  video that fails shows the page behind it instead; see giveUp(). */
    function showPhoto(v) {
      var src = photo(v);
      if (src && v.getAttribute('poster') !== src) v.setAttribute('poster', src);
    }

    // Reduced motion: the photograph IS the picture.
    //
    // Restoring the poster is not enough on its own any more. Where one file
    // serves both screens the server ships `src` and `autoplay`, so the
    // browser has already STARTED the clip by the time this runs — the very
    // thing that makes the video instant for everyone else. So stop it, drop
    // the source and reload, which returns the element to its poster and ends
    // the download. (A one-frame video still has its photograph underneath;
    // MEDIA_CSS uncovers that under reduced motion.)
    if (reduce.matches) {
      Array.prototype.forEach.call(vids, function (v) {
        showPhoto(v);
        v.removeAttribute('data-video-showing');
        try { v.pause(); } catch (e) {}
        v.removeAttribute('autoplay');
        if (v.getAttribute('src')) {
          v.removeAttribute('src');
          try { v.load(); } catch (e) {}
        }
      });
      return;
    }

    // Failure handling is armed for EVERY video immediately, not inside
    // load(). A server-supplied src starts during parse, so a missing or
    // undecodable file fires `error` before this script has even run — the
    // listener load() used to attach arrived too late and the frame sat
    // blank instead of falling back to the photograph.
    Array.prototype.forEach.call(vids, function (v) {
      // Muted, as a PROPERTY, not just the attribute the server wrote. Every
      // browser blocks autoplay for a video it considers audible, and a few
      // have shipped bugs where the attribute alone did not set the property
      // — which turns a silent background loop into a clip that refuses to
      // start for a reason nothing on the page can see. The files themselves
      // carry no audio track at all (the uploader strips it), so this can
      // never silence anything a visitor wanted to hear.
      v.muted = true;
      v.defaultMuted = true;
      v.volume = 0;
      // The button is wired FIRST. A video that has already errored by the
      // time this runs is exactly the one whose button has to work, and
      // wiring it after an early return left it inert.
      var btn = tap(v);
      if (btn) btn.addEventListener('click', function () { pressed(v); });
      // Running is the only proof that there is nothing left to ask for.
      v.addEventListener('playing', function () {
        delete v.dataset.videoRefused;
        hideTap(v);
        if (v.videoWidth && v.videoHeight) v.setAttribute('data-video-showing', '');
      });
      if (v.error) { giveUp(v, 'source'); return; }
      v.addEventListener('error', function () { giveUp(v, 'source'); }, { once: true });
    });

    /** Is this video for the screen we're on? */
    function active(v) {
      var only = v.getAttribute('data-video-only');
      return !only || (only === 'mobile') === phone.matches;
    }

    function sourceFor(v) {
      var m = v.getAttribute('data-video-src-mobile');
      return (phone.matches && m) ? m : v.getAttribute('data-video-src');
    }

    /** Offer the play button. Only ever called for a clip the browser has
     *  loaded and declined to start by itself.
     *
     *  `videoRefused` outlives the offer on purpose: it means "this browser
     *  can play this, it just won't do it unasked". If the clip then STALLS,
     *  that refusal is the likeliest reason nothing arrived, so giveUp()
     *  reads this flag and keeps the button rather than taking away the one
     *  control that would have fixed the frame. */
    function offerTap(v) {
      if (v.dataset.videoFailed) return;
      v.dataset.videoRefused = '1';
      var btn = tap(v);
      if (btn) btn.hidden = false;
    }

    function hideTap(v) {
      var btn = tap(v);
      if (btn) btn.hidden = true;
    }

    // Stop, and leave the frame empty. There is nothing to uncover — the still
    // on this frame is hidden by MEDIA_CSS whatever happens — so what a failed
    // clip leaves behind is the page itself, plus a button to try again.
    function giveUp(v, why) {
      v.dataset.videoFailed = '1';
      v.removeAttribute('data-video-ready');
      v.removeAttribute('data-video-showing');
      clearWatchdog(v);
      v.removeAttribute('src');
      try { v.load(); } catch (e) {}
      // The button always stays up on a frame that gave up. There is no
      // photograph underneath any more — a video frame shows video or it shows
      // the page behind it — so the choice is not "button or picture", it is
      // "button or an empty rectangle the reader cannot do anything about".
      // A press re-arms the whole thing from scratch (see pressed()), which is
      // a real second chance on every cause except a file that is simply
      // broken. offerTap() won't touch a clip already marked failed, so the
      // button is revealed here directly.
      var btn = tap(v);
      if (btn) btn.hidden = false;
    }

    // ── The stall watchdog ──────────────────────────────────────────────────
    // `error` catches a file the browser rejects. This catches the file it
    // simply never finishes: no error, no frame, no end to waiting.
    // (Its WeakMap is declared at the top — see the note there.)
    function clearWatchdog(v) {
      var t = timers.get(v);
      if (t) { clearTimeout(t); timers.delete(v); }
    }
    function startWatchdog(v) {
      clearWatchdog(v);
      timers.set(v, setTimeout(function () {
        timers.delete(v);
        if (v.dataset.videoFailed || v.hasAttribute('data-video-showing')) return;
        // A picture did arrive, just too quietly to have been noticed — that
        // is not a stall, it is a `loadeddata` that went missing.
        if (v.videoWidth > 0 && v.videoHeight > 0) { ready(v); return; }
        giveUp(v, 'stall');
      }, STALL_MS));
    }

    // Speed, where the owner asked for one in /admin/images — per frame, since
    // a phone may be framed and timed differently. Re-applied after every
    // source change, since swapping src resets it in some browsers.
    function applyRate(v) {
      var m    = v.getAttribute('data-video-rate-mobile');
      var rate = parseFloat(phone.matches && m !== null ? m : v.getAttribute('data-video-rate')) || 1;
      try { v.playbackRate = rate; } catch (e) {}
    }

    // A file that LOADS but carries no picture — an audio-only file, or a video
    // track in a codec this browser can't decode — reports a perfectly healthy
    // readyState and fires no error. It just paints nothing, which on a
    // full-bleed hero reads as the site being broken. So a clip has to show a
    // measurable frame before it is allowed to cover the photograph.
    function ready(v) {
      if (v.dataset.videoFailed) return;
      if (!v.videoWidth || !v.videoHeight) { giveUp(v, 'source'); return; }
      clearWatchdog(v);
      v.setAttribute('data-video-ready', '');
      v.setAttribute('data-video-showing', '');
      applyRate(v);
      // Deliberately NOT hideTap(). A clip can decode perfectly and still be
      // refused a start — that is precisely the Low Power Mode case — and
      // hiding the button here left the visitor looking at a frozen first
      // frame with the one control that would have fixed it taken away. The
      // button comes down on `playing`, when there is really nothing left to
      // ask for. Trying again costs nothing and re-offers it if refused.
      play(v);
    }

    function load(v) {
      if (v.dataset.videoLoaded || v.dataset.videoFailed || !active(v)) return;
      v.dataset.videoLoaded = '1';
      applyRate(v);
      // `preload="none"` is how a lazy slot holds its bytes back, and it has
      // to come OFF at the moment a source is assigned: WebKit will not
      // autoplay a source it was told not to preload, so the clip loaded,
      // waited, and painted a play arrow instead of starting. The attribute
      // has done its job by now — nothing was fetched before this point.
      if (v.preload === 'none') v.preload = 'auto';
      // Where one file serves both screens the server already put the src in
      // the markup and the browser has been loading it since parse. Assigning
      // the same URL again would restart that, so only set what is missing or
      // wrong (the phone-cut case, which the server cannot choose).
      var want = sourceFor(v);
      if (want && v.getAttribute('src') !== want) v.src = want;
      // `error` is already armed for every video above; the watchdog covers
      // the file that neither errors nor arrives.
      startWatchdog(v);
      // A server-supplied src has been loading since parse, so `loadeddata`
      // may already be behind us — in which case the listener would never
      // fire and a picture-less file would never be caught.
      if (v.readyState >= 2) ready(v);
      else v.addEventListener('loadeddata', function () { ready(v); }, { once: true });
    }

    // Whether each video SHOULD be running — the intersection observer's
    // answer, kept separately from whether it IS running. Tabbing away pauses
    // without changing the answer, so tabbing back knows what to resume; the
    // observer would not fire again on its own, since nothing moved.
    function want(v)  { return v.dataset.videoOnScreen === '1'; }
    function play(v)  {
      if (!v.dataset.videoLoaded || v.dataset.videoFailed || document.hidden || !want(v) || !active(v)) return;
      var p;
      try { p = v.play(); } catch (e) { return handleRefusal(v, e); }
      if (p && p.catch) p.catch(function (e) { handleRefusal(v, e); });
    }
    function pause(v) { if (!v.paused) v.pause(); }

    /** A refused play(). The two reasons are not the same problem and must not
     *  get the same answer:
     *
     *    NotAllowedError — the browser can play this, it just won't do it
     *      unprompted. Offer the button; a tap clears it.
     *    AbortError      — a new load interrupted this play (a breakpoint
     *      change, a src swap). Nothing is wrong; the next play() follows.
     *    anything else   — the source itself. Show the photograph.
     *
     *  Swallowing all three, which is what a bare `.catch(function(){})` did,
     *  is how a phone ended up holding a play arrow over a hidden photograph
     *  with nothing listening for the press. */
    function handleRefusal(v, err) {
      var name = (err && err.name) || '';
      if (name === 'AbortError') return;
      if (name === 'NotAllowedError') { offerTap(v); return; }
      giveUp(v, 'source');
    }

    /** The button was pressed. This is a user gesture, so it beats every
     *  autoplay policy there is — and it is also the one chance to retry a
     *  clip we had already given up on, which is why it re-arms rather than
     *  just calling play(). */
    function pressed(v) {
      hideTap(v);
      var wasFailed = v.dataset.videoFailed;
      delete v.dataset.videoFailed;
      if (wasFailed) {
        delete v.dataset.videoLoaded;
        v.dataset.videoOnScreen = '1';
        load(v);
      }
      applyRate(v);
      var p;
      try { p = v.play(); } catch (e) { return giveUp(v, 'source'); }
      if (p && p.then) {
        p.then(function () {
          delete v.dataset.videoRefused;
          // Cover the still as soon as there is something to cover it with.
          if (v.videoWidth && v.videoHeight) {
            clearWatchdog(v);
            v.setAttribute('data-video-ready', '');
            v.setAttribute('data-video-showing', '');
            applyRate(v);
          } else {
            startWatchdog(v);
            v.addEventListener('loadeddata', function () { ready(v); }, { once: true });
          }
        }, function () {
          // Still refused with a gesture behind it — that is the source, not
          // a policy, and there is nothing further to offer.
          delete v.dataset.videoRefused;
          giveUp(v, 'source');
        });
      }
    }

    // Load on approach, play only while actually on screen. The hero is
    // already in view on load, so it starts immediately; a gallery frame five
    // screens down costs nothing until it is nearly there. A video for the
    // other frame is remembered as near but not loaded, so resizing across the
    // breakpoint can start it without waiting for another scroll.
    if ('IntersectionObserver' in window) {
      var near = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (!e.isIntersecting) return;
          e.target.dataset.videoNear = '1';
          load(e.target);
          if (e.target.dataset.videoLoaded) near.unobserve(e.target);
          play(e.target);
        });
      }, { rootMargin: '400px 0px' });
      var onScreen = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          e.target.dataset.videoOnScreen = e.isIntersecting ? '1' : '0';
          if (e.isIntersecting) play(e.target); else pause(e.target);
        });
      }, { threshold: 0.1 });
      Array.prototype.forEach.call(vids, function (v) { near.observe(v); onScreen.observe(v); });
    } else {
      Array.prototype.forEach.call(vids, function (v) {
        v.dataset.videoOnScreen = '1'; v.dataset.videoNear = '1'; load(v); play(v);
      });
    }

    // A backgrounded tab should not be decoding video.
    document.addEventListener('visibilitychange', function () {
      Array.prototype.forEach.call(vids, document.hidden ? pause : play);
    });

    // Crossing the phone breakpoint changes which cut is right, and whether a
    // one-frame video belongs on screen at all.
    var onBreakpoint = function () {
      Array.prototype.forEach.call(vids, function (v) {
        if (v.dataset.videoFailed) return;
        if (!active(v)) { pause(v); return; }
        if (!v.dataset.videoLoaded) {
          if (v.dataset.videoNear) { load(v); play(v); }
          return;
        }
        var src = sourceFor(v);
        if (src && v.getAttribute('src') !== src) {
          v.src = src;
          // A different file: it has no picture yet, so this one has to earn
          // `data-video-showing` again before it covers anything.
          startWatchdog(v);
          v.addEventListener('loadeddata', function () { ready(v); }, { once: true });
        }
        applyRate(v);
        play(v);
      });
    };
    if (phone.addEventListener) phone.addEventListener('change', onBreakpoint);
    else if (phone.addListener)  phone.addListener(onBreakpoint);
  })();
</script>

---
// ContactForm — one form, two modes.
//
// The toggle at the top swaps between a "general inquiry" mode (name,
// phone, email, message) and an "event inquiry" mode (adds date, type,
// guests). Submission goes to the same /api/contact endpoint; a hidden
// `inquiry_type` field tells the server how to subject-line the email.
//
// URL deep-link: /contact/?type=event lands the user directly on the
// event tab (used by the home page's "Inquire about events" CTA).

import { pick, contact as copy } from '../../data/i18n';
import type { Lang }            from '../../data/i18n';
import { TURNSTILE_SITEKEY }    from '../../data/restaurant';

export interface Props {
  lang: Lang;
  /** Which mode the form opens in. Defaults to general. */
  defaultMode?: 'general' | 'event';
  /** Show the general/event toggle. Hide it on the dedicated events page. */
  showToggle?: boolean;
}

const { lang, defaultMode = 'general', showToggle = true } = Astro.props;
const t        = pick(copy, lang);

const isEvent = defaultMode === 'event';

const eventTypes: { value: string; label: string }[] = [
  { value: '',           label: t.typeChoose     },
  { value: 'private',    label: t.typePrivate    },
  { value: 'business',   label: t.typeBusiness   },
  { value: 'birthday',   label: t.typeBirthday   },
  { value: 'barmitzvah', label: t.typeBarMitzvah },
  { value: 'wedding',    label: t.typeWedding    },
  { value: 'other',      label: t.typeOther      },
];

// Time-of-day for the event — multi-select, none pre-checked, and required
// in event mode (client check below + server check in functions/api/contact.ts).
const eventTimes: { value: string; label: string }[] = [
  { value: 'morning',   label: t.whenMorning   },
  { value: 'afternoon', label: t.whenAfternoon },
  { value: 'evening',   label: t.whenEvening   },
];
---

<section class="section-tight" id="contact">
  <div class="wrap wrap--tight">
    {/* Toggle — two buttons that switch the form between modes. The
        underlying form keeps every field; mode = 'event' just unhides
        the date/type/guests row. Hidden on the dedicated events page,
        which locks the form to event mode. */}
    {showToggle && (
      <div class="contact-toggle reveal-on-scroll" role="tablist" aria-label={t.eyebrow}>
        <button
          class={`contact-toggle__btn${isEvent ? '' : ' is-active'}`}
          type="button"
          role="tab"
          aria-selected={isEvent ? 'false' : 'true'}
          data-contact-mode="general"
          id="contact-mode-general"
        >
          <span class="contact-toggle__label">{t.modeGeneral}</span>
          <span class="contact-toggle__caption">{t.modeGeneralCaption}</span>
        </button>
        <button
          class={`contact-toggle__btn${isEvent ? ' is-active' : ''}`}
          type="button"
          role="tab"
          aria-selected={isEvent ? 'true' : 'false'}
          data-contact-mode="event"
          id="contact-mode-event"
        >
          <span class="contact-toggle__label">{t.modeEvent}</span>
          <span class="contact-toggle__caption">{t.modeEventCaption}</span>
        </button>
        <span class="contact-toggle__indicator" aria-hidden="true"></span>
      </div>
    )}

    <div class="form-card stagger reveal-on-scroll" data-contact-card>
      <header class="form-card__head">
        <p class="eyebrow" data-form-eyebrow data-eyebrow-general={t.formEyebrowGeneral} data-eyebrow-event={t.formEyebrowEvent}>
          {isEvent ? t.formEyebrowEvent : t.formEyebrowGeneral}
        </p>
        <h2
          class="display"
          data-form-heading
          data-heading-general={t.formHeadingGeneral}
          data-heading-event={t.formHeadingEvent}
          data-word-reveal
          data-word-reveal-delay="0.06"
          data-word-reveal-step="0.06"
        >{isEvent ? t.formHeadingEvent : t.formHeadingGeneral}</h2>
      </header>

      {/* novalidate: our submit handler validates every field at once and
          highlights all offenders — the browser's native bubble would stop
          at the first one. No-JS submissions are still gated by the server. */}
      <form class="form" method="POST" action="/api/contact" id="contact-form" novalidate>
        <input type="hidden" name="inquiry_type" value={isEvent ? 'event' : 'general'} data-inquiry-type />

        <div class="form__row form__row--2">
          <div class="field">
            <label for="name">{t.fieldName}</label>
            <input id="name" name="name" type="text" required autocomplete="name" />
          </div>
          <div class="field">
            <label for="phone">{t.fieldPhone}</label>
            <input id="phone" name="phone" type="tel" required autocomplete="tel" />
          </div>
        </div>

        <div class="field">
          <label for="email">{t.fieldEmail}</label>
          <input id="email" name="email" type="email" required autocomplete="email" />
        </div>

        {/* Event-only fields. Rendered only when the form can actually reach
            event mode (the dedicated events page, or a page that shows the
            general/event toggle). The general-only About form omits them. */}
        {(isEvent || showToggle) && (
          <div class="contact-event-fields" data-event-only hidden={!isEvent}>
            <div class="form__row form__row--2">
              <div class="field">
                <label for="event_date">{t.fieldDate}</label>
                <input id="event_date" name="event_date" type="date" required={isEvent} data-event-required />
              </div>
              <div class="field">
                <label for="guests">{t.fieldGuests}</label>
                <input id="guests" name="guests" type="number" min="2" max="80" />
              </div>
            </div>

            <div class="form__row form__row--2">
              <div class="field">
                <label for="event_type">{t.fieldType}</label>
                <span class="select-shell">
                  <select id="event_type" name="event_type">
                    {eventTypes.map(opt => <option value={opt.value}>{opt.label}</option>)}
                  </select>
                </span>
              </div>

              {/* Time of day — dressed as a select (same shell + caret as the
                  event-type field) that opens a multi-choice menu; the chosen
                  options are written out below the control. Ships as a plain
                  visible list and is upgraded by JS, so a no-JS visitor still
                  sees usable checkboxes. Mandatory in event mode: the submit
                  handler blocks the send until at least one is ticked (the
                  server re-checks for no-JS). */}
              <fieldset class="field field--when" data-when-group>
                <legend class="field__legend" id="event-time-label">
                  {t.fieldWhen}
                  <span class="field__hint">· {t.fieldWhenHint}</span>
                </legend>
                <span class="when-shell" data-when-shell>
                  <button
                    type="button"
                    class="when-trigger"
                    data-when-trigger
                    hidden
                    aria-haspopup="true"
                    aria-expanded="false"
                    aria-labelledby="event-time-label"
                  >{t.typeChoose}</button>
                  <ul class="when-list" data-when-menu>
                    {eventTimes.map(opt => (
                      <li class="when-list__item">
                        <label class="when-choice">
                          <input type="checkbox" name="event_time" value={opt.value} />
                          <span>{opt.label}</span>
                        </label>
                      </li>
                    ))}
                  </ul>
                </span>
              </fieldset>
            </div>
          </div>
        )}

        <div class="field">
          <label for="message">{t.fieldMessage}</label>
          <textarea id="message" name="message" rows="5" required={isEvent} data-event-required></textarea>
        </div>

        <!-- Honeypot — silently filled by bots, never by humans -->
        <div class="visually-hidden" aria-hidden="true">
          <label for="website">Leave this empty</label>
          <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>

        {/* Cloudflare Turnstile (CAPTCHA). Renders only when a site key is
            configured in src/data/restaurant.ts. The widget injects a hidden
            `cf-turnstile-response` input into this form, which the server
            verifies in functions/api/contact.ts. */}
        {TURNSTILE_SITEKEY && (
          <div
            class="cf-turnstile form__turnstile"
            data-sitekey={TURNSTILE_SITEKEY}
            data-language={lang}
            data-theme="auto"
          ></div>
        )}

        <div class="form-card__submit">
          <button
            class="btn"
            type="submit"
            data-submit
            data-submit-general={t.submitGeneral}
            data-submit-event={t.submitEvent}
          >{isEvent ? t.submitEvent : t.submitGeneral}</button>
          <p id="form-status" role="status" aria-live="polite" class="form-status"></p>
        </div>
      </form>
    </div>
  </div>
</section>

<style>
  /* Cloudflare Turnstile widget — breathing room above the submit button. */
  .form__turnstile { margin-block: 0.25rem 0.5rem; }

  /* Time-of-day group — a fieldset dressed as a .field. The legend mirrors
     the .field label treatment; the options are rows of a single bordered
     list in the same chrome as the inputs (paper-card fill, 1px rule),
     with square checkboxes that fill with the accent when ticked. */
  .field--when {
    /* Block flow, not the .field grid — browsers special-case <legend> in
       grid/flex fieldsets, so spacing comes from the legend margin instead. */
    display: block;
    border: 0;
    padding: 0;
    margin: 0;
    min-inline-size: 0;
  }
  .field__legend {
    padding: 0;
    margin-block-end: 0.5rem;
    font-size: var(--step--2);
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--ink-muted);
    font-weight: 600;
  }
  .field__hint {
    letter-spacing: 0.02em;
    text-transform: none;
    font-weight: 400;
  }
  /* The shell: JS promotes it to .select-shell (global caret) and swaps the
     visible list for the trigger + dropdown. Without JS it stays a plain
     bordered list of checkboxes. */
  .when-shell { position: relative; display: block; }

  /* Trigger — same chrome as .field select so the two controls in this row
     read as one family. Chosen options render inside it as ×-removable
     tokens; flex-wrap lets them spill to a second line if needed. */
  .when-trigger {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.3rem 1rem;
    width: 100%;
    font: inherit;
    text-align: start;
    padding: 0.95rem 1rem;
    padding-inline-end: 2.5rem;
    background: var(--paper-card);
    border: 1px solid var(--rule);
    border-radius: 0;
    color: var(--ink);
    cursor: pointer;
    -webkit-appearance: none;
    appearance: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  /* The button ships [hidden] and is revealed by JS — without this, our
     display:flex would override the UA's [hidden]{display:none} and show a
     dead button to no-JS visitors. */
  .when-trigger[hidden] { display: none; }
  .when-trigger:focus-visible {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 1px var(--accent);
  }
  .when-token {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .when-token__x {
    display: grid;
    place-items: center;
    inline-size: 1.15rem;
    block-size: 1.15rem;
    line-height: 1;
    color: var(--ink-muted);
    transition: color 0.2s ease;
  }
  .when-token__x:hover { color: var(--err); }

  .when-list {
    list-style: none;
    margin: 0;
    padding: 0;
    background: var(--paper-card);
    border: 1px solid var(--rule);
    transition: border-color 0.2s ease;
  }
  /* Enhanced: the list opens IN FLOW beneath the trigger — the section
     below moves down to make room rather than being covered. */
  .when-shell.is-enhanced .when-list { margin-block-start: 0.35rem; }
  .when-shell.is-enhanced .when-list[hidden] { display: none; }
  /* With the open menu in flow the shell grows, so the caret's top:50%
     would sink to the menu — pin it to the trigger's own centre line. */
  .when-shell.is-enhanced.is-open::after { top: 1.7rem; }
  .when-list__item + .when-list__item {
    border-block-start: 1px solid var(--rule-soft);
  }
  .when-choice {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.72rem 1rem;
    cursor: pointer;
    color: var(--ink);
    transition: background 0.2s ease;
  }
  .when-choice:hover {
    background: color-mix(in srgb, var(--ink) 4%, var(--paper-card));
  }
  /* [type="checkbox"] on every rule: Astro scopes with zero-specificity
     :where(), so these must outrank the global .field input chrome. */
  .when-choice input[type="checkbox"] {
    -webkit-appearance: none;
    appearance: none;
    inline-size: 1.15rem;
    block-size: 1.15rem;
    /* base.css gives every input min-height:44px for touch targets — that
       would stretch this square into a tall bar. The 44px tap area is the
       whole .when-choice row, so the box itself can stay small. */
    min-block-size: 0;
    min-inline-size: 0;
    padding: 0;
    margin: 0;
    flex: none;
    display: grid;
    place-content: center;
    background: var(--paper-card);
    border: 1px solid var(--rule);
    border-radius: 0;
    cursor: pointer;
    transition: border-color 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
  }
  .when-choice input[type="checkbox"]::before {
    content: '';
    inline-size: 0.62rem;
    block-size: 0.62rem;
    background: var(--paper-card);
    clip-path: polygon(14% 44%, 0 65%, 50% 100%, 100% 16%, 80% 0%, 43% 62%);
    transform: scale(0);
    transition: transform 0.15s var(--ease-out, ease-out);
  }
  .when-choice input[type="checkbox"]:checked {
    background: var(--accent);
    border-color: var(--accent);
  }
  .when-choice input[type="checkbox"]:checked::before { transform: scale(1); }
  .when-choice input[type="checkbox"]:focus-visible {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 1px var(--accent);
  }

  .field--when.is-error .when-list    { border-color: var(--err); }
  .field--when.is-error .when-trigger { border-color: var(--err); }
  .field--when.is-error .when-choice input[type="checkbox"] { border-color: var(--err); }
  @media (prefers-reduced-motion: reduce) {
    .when-choice input[type="checkbox"],
    .when-choice input[type="checkbox"]::before { transition: none; }
  }
</style>

{/* Cloudflare Turnstile loader — only when a site key is configured. The
    site CSP sets only frame-ancestors, so the challenge iframe/script load
    without any allow-list change. */}
{TURNSTILE_SITEKEY && (
  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
)}

<script define:vars={{
  msgSending:    t.statusSending,
  msgSuccess:    t.statusSuccess,
  msgErrNetwork: t.statusErrNetwork,
  msgErrGeneral: t.statusErrGeneral,
  msgErrEmail:   t.statusErrEmail,
  msgErrWhen:    t.statusErrWhen,
  pageLang:      lang,
}}>
  // ── Mode toggle (general / event) ─────────────────────────────────────────
  const toggleBtns   = Array.from(document.querySelectorAll('[data-contact-mode]'));
  const eventFields  = document.querySelector('[data-event-only]');
  const eyebrow      = document.querySelector('[data-form-eyebrow]');
  const heading      = document.querySelector('[data-form-heading]');
  const submitBtn    = document.querySelector('[data-submit]');
  const inquiryInput = document.querySelector('[data-inquiry-type]');

  function setMode(mode) {
    toggleBtns.forEach((b) => {
      const active = b.dataset.contactMode === mode;
      b.classList.toggle('is-active', active);
      b.setAttribute('aria-selected', active ? 'true' : 'false');
    });
    if (eventFields) eventFields.hidden = mode !== 'event';
    if (eyebrow) eyebrow.textContent = mode === 'event'
      ? eyebrow.dataset.eyebrowEvent : eyebrow.dataset.eyebrowGeneral;
    if (heading) {
      heading.textContent = mode === 'event'
        ? heading.dataset.headingEvent : heading.dataset.headingGeneral;
      // Re-arm the word-mask reveal so the new copy animates in.
      heading.removeAttribute('data-word-reveal-ready');
      if (typeof window.__zaharaArmReveals === 'function') {
        window.__zaharaArmReveals(heading.parentElement);
      }
    }
    if (submitBtn) submitBtn.textContent = mode === 'event'
      ? submitBtn.dataset.submitEvent : submitBtn.dataset.submitGeneral;
    if (inquiryInput) inquiryInput.value = mode;
    // Date is mandatory only for event inquiries — a hidden required field
    // would silently block the general form, so requiredness follows the mode.
    document.querySelectorAll('[data-event-required]').forEach((el) => {
      el.required = mode === 'event';
    });
    // Reposition the sliding indicator under the new active tab.
    requestAnimationFrame(positionIndicator);
  }

  toggleBtns.forEach((b) => b.addEventListener('click', () => setMode(b.dataset.contactMode)));

  // Sliding indicator under the active toggle button.
  const indicator = document.querySelector('.contact-toggle__indicator');
  function positionIndicator() {
    const wrap   = document.querySelector('.contact-toggle');
    const active = wrap?.querySelector('.contact-toggle__btn.is-active');
    if (!wrap || !indicator || !active) return;
    const wrapRect = wrap.getBoundingClientRect();
    const btnRect  = active.getBoundingClientRect();
    // Logical inset so the underline lands under the active button in both
    // LTR and RTL (the site default is Hebrew). In RTL inset-inline-start
    // anchors to the right edge, so measure the offset from the right.
    const rtl = getComputedStyle(wrap).direction === 'rtl';
    const inlineStart = rtl
      ? (wrapRect.right - btnRect.right)
      : (btnRect.left   - wrapRect.left);
    indicator.style.width            = btnRect.width + 'px';
    indicator.style.insetInlineStart = inlineStart + 'px';
  }
  window.addEventListener('resize', positionIndicator, { passive: true });
  if (document.fonts?.ready) document.fonts.ready.then(positionIndicator).catch(() => {});
  requestAnimationFrame(positionIndicator);

  // Deep-link via ?type=event (used by home page's "Inquire about events" CTA).
  const params = new URLSearchParams(window.location.search);
  if (params.get('type') === 'event') setMode('event');

  // ── Submission ────────────────────────────────────────────────────────────
  const form   = document.getElementById('contact-form');
  const status = document.getElementById('form-status');

  if (status) {
    if (params.get('submitted') === '1') {
      status.textContent = msgSuccess;
      status.className   = 'form-status ok';
      history.replaceState({}, '', window.location.pathname);
    } else if (params.get('error') === '1') {
      status.textContent = msgErrGeneral;
      status.className   = 'form-status err';
      history.replaceState({}, '', window.location.pathname);
    }
  }

  // ── Time-of-day dropdown (progressive enhancement over the plain list) ────
  const whenShell   = document.querySelector('[data-when-shell]');
  const whenTrigger = document.querySelector('[data-when-trigger]');
  const whenMenu    = document.querySelector('[data-when-menu]');
  let renderWhenSelected = () => {};
  if (whenShell && whenTrigger && whenMenu) {
    whenShell.classList.add('select-shell', 'is-enhanced');
    whenTrigger.hidden = false;
    whenMenu.hidden    = true;

    const boxes       = Array.from(whenMenu.querySelectorAll('input[name="event_time"]'));
    const placeholder = whenTrigger.textContent.trim();

    // The chosen options live inside the trigger itself, each with a small
    // × that unpicks it. Built with DOM nodes, not innerHTML.
    renderWhenSelected = () => {
      whenTrigger.textContent = '';
      const chosen = boxes.filter((b) => b.checked);
      if (!chosen.length) {
        whenTrigger.textContent = placeholder;
        return;
      }
      chosen.forEach((b) => {
        const token = document.createElement('span');
        token.className = 'when-token';
        token.append((b.closest('label')?.textContent || b.value).trim());
        const x = document.createElement('span');
        x.className = 'when-token__x';
        x.textContent = '×';
        x.setAttribute('data-when-remove', b.value);
        x.setAttribute('aria-hidden', 'true');
        token.append(x);
        whenTrigger.append(token);
      });
    };
    const setOpen = (open) => {
      whenMenu.hidden = !open;
      whenShell.classList.toggle('is-open', open);
      whenTrigger.setAttribute('aria-expanded', open ? 'true' : 'false');
    };
    whenTrigger.addEventListener('click', (e) => {
      // × on a token unpicks that option without toggling the menu. The
      // real checkbox stays the source of truth (and what the form posts).
      const remove = e.target.closest ? e.target.closest('[data-when-remove]') : null;
      if (remove) {
        const box = boxes.find((b) => b.value === remove.getAttribute('data-when-remove'));
        if (box) {
          box.checked = false;
          box.dispatchEvent(new Event('change', { bubbles: true }));
        }
        return;
      }
      setOpen(whenMenu.hidden);
    });
    document.addEventListener('click', (e) => {
      if (!whenShell.contains(e.target)) setOpen(false);
    });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });
    boxes.forEach((b) => b.addEventListener('change', renderWhenSelected));
    renderWhenSelected();
  }

  if (form && status) {
    const whenGroup = form.querySelector('[data-when-group]');

    // Fixing a field clears its highlight immediately; ticking any
    // time-of-day box clears the group's error state.
    form.querySelectorAll('input, select, textarea').forEach((el) => {
      const clear = () => el.classList.remove('is-invalid');
      el.addEventListener('input',  clear);
      el.addEventListener('change', clear);
    });
    form.querySelectorAll('input[name="event_time"]').forEach((box) => {
      box.addEventListener('change', () => {
        whenGroup?.classList.remove('is-error');
        if (status.textContent === msgErrWhen) {
          status.textContent = '';
          status.className   = 'form-status';
        }
      });
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const mode = inquiryInput ? inquiryInput.value : 'general';

      // Validate every field in one pass and highlight ALL offenders — the
      // form carries `novalidate`, so the browser's stop-at-the-first bubble
      // never runs. The server re-validates everything; this is the fast,
      // visible layer.
      const invalid = [];
      form.querySelectorAll('input, select, textarea').forEach((el) => {
        if (el.type === 'hidden' || el.type === 'checkbox' || el.disabled) return;
        if (el.closest('[hidden]') || el.closest('.visually-hidden')) return;
        el.classList.remove('is-invalid');
        let bad = !el.checkValidity();
        // Stricter email shape than the browser's (mirrors the server check).
        if (el.id === 'email' && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test((el.value || '').trim())) {
          bad = true;
        }
        if (bad) { invalid.push(el); el.classList.add('is-invalid'); }
      });

      // Time-of-day group — no native "one of these" constraint exists for
      // checkboxes, so it's validated as a unit in event mode.
      const whenBoxes = Array.from(form.querySelectorAll('input[name="event_time"]'));
      const whenBad   = mode === 'event' && whenBoxes.length > 0 && !whenBoxes.some((b) => b.checked);
      whenGroup?.classList.toggle('is-error', whenBad);

      if (invalid.length || whenBad) {
        // One combined message; if a single field is wrong, say which kind.
        let msg = msgErrRequired;
        if (!invalid.length && whenBad) {
          msg = msgErrWhen;
        } else if (!whenBad && invalid.length === 1 && invalid[0].id === 'email' && invalid[0].value.trim()) {
          msg = msgErrEmail;
        }
        status.textContent = msg;
        status.className   = 'form-status err';
        // First offender gets focus; for the time group that's the trigger
        // (the checkboxes sit inside the closed dropdown).
        (invalid[0] || (whenTrigger && !whenTrigger.hidden ? whenTrigger : whenBoxes[0]))?.focus();
        return;
      }

      status.textContent = msgSending;
      status.className   = 'form-status';

      try {
        const res = await fetch('/api/contact', { method: 'POST', body: new FormData(form) });
        if (res.ok) {
          status.textContent = msgSuccess;
          status.className   = 'form-status ok';
          // GA4 — a *successful* send, unlike the auto-collected form_submit
          // which fires on the attempt. Queued via dataLayer so it works
          // regardless of script order and respects Consent Mode.
          try {
            window.dataLayer = window.dataLayer || [];
            function gtag(){ dataLayer.push(arguments); }
            gtag('event', 'contact_form_submit', {
              inquiry_type: mode,
              page_lang:    pageLang,
            });
          } catch { /* analytics must never break the form */ }
          form.reset();
          renderWhenSelected();
        } else {
          const text = await res.text();
          status.textContent = text || msgErrGeneral;
          status.className   = 'form-status err';
        }
      } catch {
        status.textContent = msgErrNetwork;
        status.className   = 'form-status err';
      }
    });
  }
</script>

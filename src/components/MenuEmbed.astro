---
import { pick, menu as labels }  from '../data/i18n';
import { menuHe }               from '../data/menu-he';
import { MENU_CATEGORIES }      from '../data/menu-spec';
import { WINE_TYPES }          from '../data/wine-types';
import { SITE_QUERY }           from '../lib/base';
import type { Lang }            from '../data/i18n';
import type { MenuKind }        from '../data/menu-spec';

export interface Props { lang?: Lang }

const { lang = 'he' } = Astro.props;
const t = pick(labels, lang);

// Materialize the tab list for this language from the canonical category spec.
interface Tab {
  id:    'food' | 'dessert' | 'wine' | 'cocktails' ;
  slug:  string;
  label: string;
  kind:  MenuKind;
}

const tabs: Tab[] = MENU_CATEGORIES.map(c => ({ 
  id:    c.id,
  slug:  c.slugs[lang],
  label: t[c.labelKey],
  kind:  c.kind,
}));

// Server-render the HE food panel from static data for instant first paint.
// All other panels (and EN food) load lazily from /api/menu/[slug].
const initialFood = lang === 'he' ? menuHe : [];

const bottleLabel = t.priceBottle;
const glassLabel  = t.priceGlass;
const updatedLbl  = t.updatedLabel;

// Wine-type switcher: ids + match patterns travel to the client script, which
// labels each chip with the document's own heading and falls back to these.
const wineTypes = WINE_TYPES.map(w => ({ id: w.id, test: w.test, label: w.label[lang] }));
---

<div class="menu-embed" id="menu-embed" data-lang={lang}>

  {/* Sticky side-rail: hidden on mobile, fades in on desktop when the
      tab bar scrolls out of view. Populated entirely by JS so it stays
      in sync with the tab state without any duplicate server markup. */}
  <nav
    class="menu-embed-rail"
    id="menu-embed-rail"
    aria-label={t.categoryNavigation}
    aria-hidden="true"
  ></nav>

  <div class="menu-embed-main">
  <nav class="menu-tabs" role="tablist" aria-label={t.menuCategories}>
    {tabs.map((tab, i) => (
      <button
        class={`menu-tab${i === 0 ? ' is-active' : ''}`}
        role="tab"
        aria-selected={i === 0 ? 'true' : 'false'}
        aria-controls={`panel-${tab.id}`}
        id={`tab-${tab.id}`}
        data-index={i}
        data-tab-id={tab.id}
        data-slug={tab.slug}
        data-kind={tab.kind}
      >{tab.label}</button>
    ))}
    <span class="menu-tabs__indicator" aria-hidden="true"></span>
  </nav>

  {tabs.map((tab, i) => (
    <div
      class={`menu-panel${i === 0 ? ' is-active' : ''}`}
      role="tabpanel"
      id={`panel-${tab.id}`}
      aria-labelledby={`tab-${tab.id}`}
      data-panel={i}
      data-tab-id={tab.id}
      data-slug={tab.slug}
      data-kind={tab.kind}
    >
      <div class="menu-meta"    data-meta-for={tab.slug}></div>
      <div class="menu-content" data-content-for={tab.slug}>
        {i === 0 && initialFood.length > 0 ? (
          <div class="menu-inline">
            {initialFood.map((section) => (
              <div class="menu-section-group">
                <h2
                  class="menu-section-heading"
                  data-word-reveal
                  data-word-reveal-delay="0.05"
                  data-word-reveal-step="0.05"
                >{section.title}</h2>
                <ul class="menu-items-list">
                  {section.items.map(item => (
                    <li class="menu-item-row">
                      <div class="menu-item__main">
                        <strong class="menu-item__name">{item.name}</strong>
                        {item.description && <span class="menu-item__desc">{item.description}</span>}
                      </div>
                      <span class="menu-item__price">{item.price}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        ) : (
          <div class="menu-coming-soon"><p>{t.notReady}</p></div>
        )}
      </div>
    </div>
  ))}
  </div>{/* end .menu-embed-main */}
</div>

{/* Categories this venue doesn't use. The middleware injects the list as
    <script id="zahara-menus">; this runs while the block is still parsing,
    so a dropped tab never paints. Whatever survives keeps working normally —
    the main script below queries the DOM after this has run. */}
<script is:inline>
  (function () {
    var tag = document.getElementById('zahara-menus');
    if (!tag) return;
    var off;
    try { off = (JSON.parse(tag.textContent || '{}').off) || []; } catch (e) { return; }
    if (!off.length) return;
    var embed = document.getElementById('menu-embed');
    if (!embed) return;
    off.forEach(function (id) {
      var tab = embed.querySelector('.menu-tab[data-tab-id="' + id + '"]');
      var pan = embed.querySelector('.menu-panel[data-tab-id="' + id + '"]');
      if (tab) tab.remove();
      if (pan) pan.remove();
    });
    // Renumber, and make sure something is still selected.
    var tabs   = embed.querySelectorAll('.menu-tab');
    var panels = embed.querySelectorAll('.menu-panel');
    for (var i = 0; i < tabs.length; i++) tabs[i].setAttribute('data-index', String(i));
    for (var j = 0; j < panels.length; j++) panels[j].setAttribute('data-panel', String(j));
    if (tabs.length && !embed.querySelector('.menu-tab.is-active')) {
      tabs[0].classList.add('is-active');
      tabs[0].setAttribute('aria-selected', 'true');
      if (panels[0]) panels[0].classList.add('is-active');
    }
  })();
</script>

<script define:vars={{ pageLang: lang, updatedLbl, bottleLabel, glassLabel, menuTitle: t.eyebrow, noCocktailsLabel: t.noCocktails, menuUnavailableLabel: t.notReady, siteParam: SITE_QUERY, wineTypes, wineNavLabel: t.wineTypes }}>
  // ── HTML escape ─────────────────────────────────────────────
  const esc = s => String(s ?? '')
    .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');

  // ── GA4 ─────────────────────────────────────────────────────
  // Queued through dataLayer so it works whatever the script order, is a
  // no-op when no Google tag is configured, and respects Consent Mode.
  function gaEvent() {
    try {
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push(arguments);
    } catch { /* analytics must never break the menu */ }
  }
  // Someone opened the menu — explicit event (page_view exists too, but this
  // one is easy to mark as a key event and carries the language).
  gaEvent('event', 'menu_view', { page_lang: pageLang });

  // ── Date format ─────────────────────────────────────────────
  function formatDate(iso) {
    if (!iso) return '';
    const d = new Date(iso);
    if (isNaN(d.getTime())) return iso;
    const locale = pageLang === 'he' ? 'he-IL' : 'en-GB';
    try {
      return new Intl.DateTimeFormat(locale, { day: 'numeric', month: 'long', year: 'numeric' }).format(d);
    } catch {
      return iso;
    }
  }

  // ── Helpers ─────────────────────────────────────────────────
  const hasHebrew = s => /[֐-׿]/.test(s || '');

  // Word draws the dividers between menu blocks as a row of dots. The parser
  // drops them now, but data synced before that still carries them — so strip
  // them here too rather than wait for the next sync.
  const RULER = /[.…·_-]{6,}/g;
  const clean = v => String(v ?? '').replace(RULER, ' ').replace(/\s+/g, ' ').trim();

  function sanitizeSections(sections) {
    return (sections || [])
      .map(s => ({
        ...s,
        title: clean(s.title),
        items: (s.items || [])
          .map(it => ({ ...it, name: clean(it.name), description: clean(it.description), note: clean(it.note) }))
          .filter(it => it.name),
      }))
      .filter(s => s.items.length);
  }

  /** Split a two-part wine price into { bottle, glass }; null if it's a single
   *  figure. The two languages' documents list the pair in opposite orders
   *  ("215 / 54" vs "54₪ / 215₪"), so the BIGGER number is the bottle — which
   *  is true of every wine on the list and needs no per-language rule. */
  function splitWinePrice(p) {
    const m = String(p || '').match(/^\s*([^/]+?)\s*\/\s*([^/]+?)\s*$/);
    if (!m) return null;
    const a = parseFloat(m[1]), b = parseFloat(m[2]);
    if (!isFinite(a) || !isFinite(b)) return null;
    return a >= b ? { bottle: m[1], glass: m[2] } : { bottle: m[2], glass: m[1] };
  }

  function renderPrice(price, kind) {
    if (kind !== 'wine') return `<span class="menu-item__price">${esc(price)}</span>`;
    const split = splitWinePrice(price);
    if (!split) return `<span class="menu-item__price">${esc(price)}</span>`;
    return `<span class="menu-item__price menu-item__price--double" aria-label="${esc(bottleLabel)} ${esc(split.bottle)} / ${esc(glassLabel)} ${esc(split.glass)}">
      <span class="menu-item__price-bottle">${esc(split.bottle)}</span>
      <span class="menu-item__price-sep">/</span>
      <span class="menu-item__price-glass">${esc(split.glass)}</span>
    </span>`;
  }

  // ── Wine ────────────────────────────────────────────────────
  // The list arrives flat and in document order: a wine-type heading, the
  // wines poured by the glass under it, then a tasting-note heading for each
  // block of bottle-only wines — and again for the next type. We fold that
  // back into one group per type so the page can offer them as a switcher,
  // in OUR order (red first) rather than the document's.
  let wineGroups = [];        // [{ id, label, sections }] for the open panel
  let activeWineGroup = '';

  /** Which wine type a section heading names, or null for a tasting note.
   *  Type headings are one word plus, at most, the word "wine(s)"; tasting
   *  notes are phrases ("Crisp, sharp and mineral"), so the word count is
   *  what keeps a note that happens to say "red" from becoming a type. */
  const WINE_GENERIC = /^(?:wines?|bottles?|יינות|יין|בקבוקים)$/i;
  function wineTypeOf(title) {
    const words = String(title || '')
      .replace(/[^\p{L}\s]/gu, ' ')
      .split(/\s+/)
      .filter(w => w && !WINE_GENERIC.test(w));
    if (!words.length || words.length > 2) return null;
    const t = words.join(' ');
    for (const wt of wineTypes) {
      if (new RegExp(wt.test, 'iu').test(t)) return wt.id;
    }
    return null;
  }

  function groupWine(sections) {
    const order  = wineTypes.map(w => w.id);
    const groups = [];
    const byId   = new Map();
    let current  = null;

    for (const s of sections || []) {
      const items = s.items || [];
      const id    = wineTypeOf(s.title);
      if (id) {
        current = byId.get(id);
        if (!current) {
          current = { id, label: String(s.title || '').trim(), sections: [] };
          byId.set(id, current);
          groups.push(current);
        }
        // The type heading's own wines are the by-the-glass block — the chip
        // already says "Red", so the heading isn't repeated above them.
        if (items.length) current.sections.push({ title: '', items });
      } else {
        if (!current) {
          current = { id: 'other', label: String(s.title || '').trim(), sections: [] };
          byId.set('other', current);
          groups.push(current);
        }
        if (items.length) current.sections.push(s);
      }
    }

    const rank = g => { const i = order.indexOf(g.id); return i < 0 ? order.length : i; };
    return groups
      .filter(g => g.sections.length)
      .map(g => ({ ...g, label: g.label || (wineTypes.find(w => w.id === g.id) || {}).label || '' }))
      .sort((a, b) => rank(a) - rank(b));
  }

  function renderWineItem(item) {
    const split = splitWinePrice(item.price);
    const meta  = [];
    if (item.note)        meta.push(`<em class="menu-item__note">${esc(item.note)}</em>`);
    if (item.description) meta.push(`<span class="menu-item__region">${esc(item.description)}</span>`);

    const price = split
      ? `<span class="wine-price" aria-label="${esc(bottleLabel)} ${esc(split.bottle)}, ${esc(glassLabel)} ${esc(split.glass)}">
           <span class="wine-price__bottle">${esc(split.bottle)}</span>
           <span class="wine-price__glass">${esc(split.glass)}</span>
         </span>`
      : `<span class="wine-price"><span class="wine-price__bottle">${esc(item.price)}</span></span>`;

    return `<li class="menu-item-row">
      <div class="menu-item__main">
        <strong class="menu-item__name">${esc(item.name)}</strong>
        ${meta.length ? `<span class="menu-item__meta">${meta.join('')}</span>` : ''}
      </div>
      ${price}
    </li>`;
  }

  function renderWineGroup(group, isActive) {
    // One column layout decision per group, so every price below a heading
    // lines up with the ones above it.
    const twoCol = group.sections.some(s => (s.items || []).some(it => splitWinePrice(it.price)));
    const head   = twoCol
      ? `<li class="menu-item-row wine-cols" aria-hidden="true">
           <span></span>
           <span class="wine-price">
             <span class="wine-price__bottle">${esc(bottleLabel)}</span>
             <span class="wine-price__glass">${esc(glassLabel)}</span>
           </span>
         </li>`
      : '';

    // One paper card per TYPE, with the tasting-note blocks running flat
    // inside it — a wine list reads as one column, not as five stacked boxes.
    const body = group.sections.map((s, i) => {
      const heading = s.title
        ? `<h2 class="wine-subhead" data-word-reveal data-word-reveal-delay="0.05" data-word-reveal-step="0.05">${esc(s.title)}</h2>`
        : '';
      const items = (s.items || []).map(renderWineItem).join('');
      return `<div class="menu-section-group is-flat">${heading}
        <ul class="menu-items-list menu-items-list--wine${twoCol ? ' is-two-col' : ''}">${i === 0 ? head : ''}${items}</ul>
      </div>`;
    }).join('');

    return `<section class="wine-group" data-wine-group="${esc(group.id)}"${isActive ? '' : ' hidden'}>${body}</section>`;
  }

  function renderWine(sections) {
    wineGroups = groupWine(sections);
    if (!wineGroups.length) return '';
    if (!wineGroups.some(g => g.id === activeWineGroup)) activeWineGroup = wineGroups[0].id;

    const nav = wineGroups.length > 1
      ? `<nav class="wine-nav" aria-label="${esc(wineNavLabel)}">${wineGroups.map(g => `
          <button type="button" class="wine-nav__chip${g.id === activeWineGroup ? ' is-active' : ''}"
                  data-wine-chip="${esc(g.id)}" aria-pressed="${g.id === activeWineGroup}">${esc(g.label)}</button>`).join('')}
         </nav>`
      : '';

    return `<div class="menu-inline">${nav}${
      wineGroups.map(g => renderWineGroup(g, g.id === activeWineGroup)).join('')
    }</div>`;
  }

  /** Show one wine type. Called by the chips and by the side rail. */
  function showWineGroup(id, root) {
    const scope = root || document;
    activeWineGroup = id;
    scope.querySelectorAll('[data-wine-group]').forEach(sec => {
      const on = sec.getAttribute('data-wine-group') === id;
      sec.hidden = !on;
      if (on) armReveals(sec);
    });
    scope.querySelectorAll('[data-wine-chip]').forEach(chip => {
      const on = chip.getAttribute('data-wine-chip') === id;
      chip.classList.toggle('is-active', on);
      chip.setAttribute('aria-pressed', on ? 'true' : 'false');
    });
    renderRail();
    gaEvent('event', 'menu_wine_type', { wine_type: id, page_lang: pageLang });
  }

  function wireWineNav(root) {
    root.querySelectorAll('[data-wine-chip]').forEach(chip => {
      chip.addEventListener('click', () => showWineGroup(chip.getAttribute('data-wine-chip'), root));
    });
  }

  // ── Renderers per kind ──────────────────────────────────────
  function renderList(sections, kind) {
    if (!sections || sections.length === 0) return '';

    const body = sections.map((s) => {
      const items = (s.items ?? []).map(item => {
        const desc = item.description
          ? `<span class="menu-item__desc">${esc(item.description)}</span>`
          : '';
        return `<li class="menu-item-row">
          <div class="menu-item__main">
            <strong class="menu-item__name">${esc(item.name)}</strong>
            ${desc}
          </div>
          ${renderPrice(item.price, kind)}
        </li>`;
      }).join('');
      const heading = s.title ? `<h2 class="menu-section-heading" data-word-reveal data-word-reveal-delay="0.05" data-word-reveal-step="0.05">${esc(s.title)}</h2>` : '';
      return `<div class="menu-section-group">${heading}<ul class="menu-items-list">${items}</ul></div>`;
    }).join('');

    return `<div class="menu-inline">${body}</div>`;
  }

  function renderCocktails(sections) {
    if (!sections || sections.length === 0) return '';
    return sections.map((s) => {
      const cards = (s.items ?? []).map(item => {
        const desc  = String(item.description || '');
        const parts = desc.split(/\s*·\s*/).map(p => p.trim()).filter(Boolean);

        let enLine = '', heLine = '';
        if (parts.length >= 2) {
          if      (hasHebrew(parts[1]) && !hasHebrew(parts[0])) { enLine = parts[0];                   heLine = parts.slice(1).join(' · '); }
          else if (hasHebrew(parts[0]) && !hasHebrew(parts[1])) { heLine = parts[0];                   enLine = parts.slice(1).join(' · '); }
          else                                                   { enLine = parts.filter(p => !hasHebrew(p)).join(' · ');
                                                                    heLine = parts.filter(p =>  hasHebrew(p)).join(' · '); }
        } else if (parts.length === 1) {
          if (hasHebrew(parts[0])) heLine = parts[0]; else enLine = parts[0];
        }

        const enHtml = enLine ? `<p class="cocktail-card__line">${esc(enLine)}</p>` : '';
        const heHtml = heLine ? `<p class="cocktail-card__line cocktail-card__line--he">${esc(heLine)}</p>` : '';

        return `<article class="cocktail-card">
          <header class="cocktail-card__head">
            <h3 class="cocktail-card__name">${esc(item.name)}</h3>
            <span class="cocktail-card__price">${esc(item.price)}</span>
          </header>
          <div class="cocktail-card__body">${enHtml}${heHtml}</div>
        </article>`;
      }).join('');

      const heading = s.title ? `<h2 class="menu-section-heading" data-word-reveal data-word-reveal-delay="0.05" data-word-reveal-step="0.05">${esc(s.title)}</h2>` : '';
      return `<div class="menu-section-group">${heading}<div class="cocktail-grid">${cards}</div></div>`;
    }).join('');
  }

  // ── Reveal-on-scroll ───────────────────────────────────────
  // We delegate to the global Motion runtime (see /components/Motion.astro):
  //   • Initial server-rendered .menu-section-group elements are picked up by
  //     Motion's setup() automatically.
  //   • For dynamically-inserted content (panel swaps), we call
  //     window.__zaharaArmReveals so the new nodes join the same bidirectional
  //     observer that drives every other reveal on the page.
  function armReveals(root) {
    if (root && typeof window.__zaharaArmReveals === 'function') {
      window.__zaharaArmReveals(root);
    }
  }

  // ── Render orchestration ────────────────────────────────────
  function renderMeta(metaEl, dateIso) {
    if (!metaEl) return;
    const formatted = formatDate(dateIso);
    metaEl.innerHTML = formatted
      ? `${updatedLbl} · <span class="menu-meta__date">${esc(formatted)}</span>`
      : '';
  }

  function applyPayload(slug, kind, payload) {
    const sections = sanitizeSections(Array.isArray(payload) ? payload : (payload?.sections ?? []));
    const date     = Array.isArray(payload) ? null   : (payload?.date     ?? null);
    const content  = document.querySelector(`[data-content-for="${slug}"]`);
    const meta     = document.querySelector(`[data-meta-for="${slug}"]`);
    const html     = kind === 'cocktails' ? renderCocktails(sections)
                   : kind === 'wine'      ? renderWine(sections)
                   :                        renderList(sections, kind);

    if (content) {
      if (html) content.innerHTML = html;
      else {
        const empty = kind === 'cocktails'
          ? noCocktailsLabel
          : menuUnavailableLabel;
        content.innerHTML = `<div class="menu-coming-soon"><p>${esc(empty)}</p></div>`;
      }
      if (html && kind === 'wine') { wireWineNav(content); renderRail(); }
      armReveals(content);
    }
    renderMeta(meta, date);
  }

  async function loadSlug(slug, kind) {
    try {
      // siteParam ('?site=rooftop' on the rooftop build) scopes the menu read
      // to this venue; the root /api/menu route falls back to Zahara then the
      // built-in default when rooftop hasn't published this menu yet.
      const res = await fetch(`/api/menu/${slug}${siteParam}`, { cache: 'default' });
      if (!res.ok) return;
      const data = await res.json();
      applyPayload(slug, kind, data);
    } catch { /* keep whatever is already rendered */ }
  }

  // ── Tab wiring ──────────────────────────────────────────────
  const tabBtns = Array.from(document.querySelectorAll('.menu-tab'));
  const panels  = Array.from(document.querySelectorAll('.menu-panel'));
  const loaded  = new Set();

  // Central switch function used by both tab clicks and rail button clicks.
  // scrollBack: when true, smooth-scrolls the tab bar into view. Both tab
  // and rail clicks pass true — the rail is a quick category jumper, so
  // landing the user at the start of the freshly-switched category is the
  // expected behaviour.
  function switchToTab(idx, scrollBack) {
    const btn  = tabBtns[idx];
    if (!btn) return;
    const slug = btn.dataset.slug ?? '';
    const kind = btn.dataset.kind ?? 'list';

    // GA4 — the visitor moved to another menu. Only on a real change:
    // re-clicking the already-active tab is not a switch.
    if (!btn.classList.contains('is-active')) {
      gaEvent('event', 'menu_category_change', {
        menu_category: btn.dataset.tabId || slug,
        page_lang:     pageLang,
      });
    }

    // Sync tab bar active state.
    tabBtns.forEach((t, i) => {
      t.classList.toggle('is-active', i === idx);
      t.setAttribute('aria-selected', i === idx ? 'true' : 'false');
    });

    // Rail follows the tabs (and grows wine types under the wine tab).
    renderRail();

    // Swap the visible panel with entrance animation.
    panels.forEach((p, i) => p.classList.toggle('is-active', i === idx));
    const activePanel = panels[idx];
    if (activePanel) {
      activePanel.classList.remove('is-switching');
      void activePanel.offsetWidth; // force reflow
      activePanel.classList.add('is-switching');
      armReveals(activePanel);
    }

    // Scroll to tab bar only when triggered from a tab click.
    if (scrollBack) {
      const tabsBar = document.querySelector('.menu-tabs');
      if (tabsBar) {
        const top = tabsBar.getBoundingClientRect().top + window.scrollY - 80;
        window.scrollTo({ top, behavior: 'smooth' });
      }
    }

    if (!loaded.has(slug)) {
      loaded.add(slug);
      loadSlug(slug, kind);
    }
  }

  tabBtns.forEach((btn, i) => {
    btn.addEventListener('click', () => switchToTab(i, true));
  });

  // Arm reveals on the initially-active panel (server-rendered HE food).
  const firstPanel = panels.find(p => p.classList.contains('is-active'));
  if (firstPanel) armReveals(firstPanel);

  // Eagerly refresh the first (food) panel from the API
  const firstBtn = tabBtns[0];
  if (firstBtn) {
    const slug = firstBtn.dataset.slug;
    const kind = firstBtn.dataset.kind ?? 'list';
    loaded.add(slug);
    loadSlug(slug, kind);
  }

  // ── Side rail ─────────────────────────────────────────────────
  // Build rail buttons from the same tab data. The rail appears (fades in)
  // via IntersectionObserver when the tab bar scrolls out of view, giving
  // quick category access without scrolling back to the top.
  // Rebuilt on every tab / wine-type change: while the wine panel is open the
  // rail nests the wine types under it, so a long red list can be swapped
  // without scrolling back to the chips at the top.
  function renderRail() {
    const rail = document.getElementById('menu-embed-rail');
    if (!rail || !rail.dataset.ready) return;

    const list = rail.querySelector('.menu-embed-rail__list');
    if (!list) return;
    list.innerHTML = '';

    function railBtn(text, isActive, onClick, cls) {
      const rb = document.createElement('button');
      rb.type      = 'button';
      rb.className = (cls || 'menu-embed-rail__btn') + (isActive ? ' is-active' : '');
      rb.setAttribute('aria-label', text);

      const label = document.createElement('span');
      label.className   = 'menu-embed-rail__label';
      label.textContent = text;

      const tick = document.createElement('span');
      tick.className = 'menu-embed-rail__tick';
      tick.setAttribute('aria-hidden', 'true');

      rb.append(label, tick);
      rb.addEventListener('click', onClick);
      return rb;
    }

    tabBtns.forEach((btn, i) => {
      const isActive = btn.classList.contains('is-active');
      const li = document.createElement('li');
      li.appendChild(railBtn(btn.textContent.trim(), isActive, () => switchToTab(i, true)));

      // Wine types, one level in, only while that panel is the open one.
      if (isActive && btn.dataset.kind === 'wine' && wineGroups.length > 1) {
        const sub = document.createElement('ol');
        sub.className = 'menu-embed-rail__sub';
        wineGroups.forEach(g => {
          const subLi = document.createElement('li');
          subLi.appendChild(railBtn(
            g.label,
            g.id === activeWineGroup,
            () => {
              showWineGroup(g.id, document.querySelector('.menu-panel.is-active') || document);
              const tabsBar = document.querySelector('.menu-tabs');
              if (tabsBar) {
                window.scrollTo({ top: tabsBar.getBoundingClientRect().top + window.scrollY - 80, behavior: 'smooth' });
              }
            },
            'menu-embed-rail__btn menu-embed-rail__btn--sub',
          ));
          sub.appendChild(subLi);
        });
        li.appendChild(sub);
      }

      list.appendChild(li);
    });
  }

  (function buildRail() {
    const rail    = document.getElementById('menu-embed-rail');
    const tabsBar = document.querySelector('.menu-tabs');
    if (!rail || !tabsBar || window.matchMedia('(max-width: 879px)').matches) return;

    const titleEl = document.createElement('p');
    titleEl.className   = 'menu-embed-rail__title';
    titleEl.textContent = menuTitle;
    rail.appendChild(titleEl);

    const list = document.createElement('ol');
    list.className = 'menu-embed-rail__list';
    rail.appendChild(list);
    rail.dataset.ready = '1';
    renderRail();

    // Show the rail once the tab bar is fully out of view; hide it when
    // the tab bar re-enters the viewport (user scrolled back up).
    const io = new IntersectionObserver(
      ([entry]) => {
        const show = !entry.isIntersecting;
        rail.classList.toggle('is-visible', show);
        rail.setAttribute('aria-hidden', show ? 'false' : 'true');
      },
      { threshold: 0 },
    );
    io.observe(tabsBar);
  })();

  // ── Deep-link support ─────────────────────────────────────────
  // If the URL hash points at a tab (#tab-cocktails, etc.), activate it on
  // load without scrolling to the tab bar (user landed directly here).
  function activateByHash() {
    const hash = (window.location.hash || '').replace(/^#/, '');
    if (!hash) return;
    const m = hash.match(/^tab-(.+)$/);
    if (!m) return;
    const idx = tabBtns.findIndex(
      (b) => b.dataset.tabId === m[1] || b.id === `tab-${m[1]}`,
    );
    if (idx >= 0 && !tabBtns[idx].classList.contains('is-active')) {
      switchToTab(idx, false);
    }
  }
  activateByHash();
  window.addEventListener('hashchange', activateByHash);

  // Live updates from /admin (same-origin tabs)
  try {
    const bc = new BroadcastChannel('zahara-menu');
    bc.addEventListener('message', (ev) => {
      const slug = ev?.data?.slug;
      if (!slug) return;
      const btn  = tabBtns.find(b => b.dataset.slug === slug);
      const kind = btn?.dataset?.kind ?? 'list';
      loadSlug(slug, kind);
    });
  } catch { /* BroadcastChannel unsupported — page refresh shows the new data */ }
</script>

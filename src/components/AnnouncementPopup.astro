---
// Entry announcement — one owner-controlled notice, shown on every page load
// of every page (the owner wants it unmissable while it's on; there is no
// per-visitor dismissed state).
//
// Design note: pillar 6 ("deliberately absent") forbids entry modals; this
// exists because the owner explicitly asked for a temporary holiday
// announcement. So it takes the shape of a printed restaurant card rather
// than a UI dialog: a paper card with a double frame (1px rule edge + an
// inset accent hairline, like a letterpress invitation), a centered
// composition — brand kicker, serif display title, a hairline-and-diamond
// ornament, body copy — and quiet exits: the × in the corner, the backdrop,
// or Escape. Slow fade-up in (camera, not interface); reduced motion gets a
// plain short fade.
//
// The shell ships in every page's static HTML but stays hidden. It only
// activates when the middleware injected the #zahara-popup marker tag —
// i.e. the owner turned the popup on in /admin/content → Popup and any
// auto-hide window (N days) hasn't ended. Title/body carry data-content-key
// attributes, so the standard editable-copy overlay in BaseLayout applies
// the owner's saved text before this ever becomes visible.

import { pick, popup as copy } from '../data/i18n';
import { RESTAURANT } from '../data/restaurant';
import type { Lang } from '../data/i18n';

export interface Props { lang: Lang }
const { lang } = Astro.props;
const c = pick(copy, lang);
const brand = RESTAURANT.name[lang];
---

<div id="zahara-announce" class="announce" hidden>
  <div class="announce__scrim" data-announce-close></div>
  <aside class="announce__panel" role="dialog" aria-modal="true"
         aria-labelledby="announce-title" tabindex="-1">
    <button class="announce__close" type="button" data-announce-close
            aria-label={c.close}>&times;</button>
    {/* Optional popup photo (owner-chosen in /admin/content → Popup). Hidden
        by default; the inline script reveals it from the injected marker when
        the popup is in a photo/both mode and a photo is stored. */}
    <img class="announce__photo" data-announce-photo alt="" hidden />
    <div class="announce__frame" data-announce-frame>
      <p class="announce__kicker">{brand}</p>
      <h2 class="announce__title" id="announce-title" data-content-key="popup.title">{c.title}</h2>
      <span class="announce__ornament" aria-hidden="true"><i class="announce__gem"></i></span>
      <p class="announce__body" data-content-key="popup.body">{c.body}</p>
    </div>
  </aside>
</div>

<script is:inline>
  (function () {
    var root = document.getElementById('zahara-announce');
    if (!root) return;
    // Owner switch — the middleware only injects this tag while the popup is on.
    // No dismissed/seen state is kept: the owner wants the notice on EVERY
    // page load (refresh included), not once per visit.
    var marker = document.getElementById('zahara-popup');
    if (!marker) return;

    // The marker carries how to present the popup: mode (text/photo/both) and,
    // when a photo applies, its URL. Show the photo and, for photo-only mode,
    // hide the text card. A photo that fails to load falls back to the text.
    try {
      var cfg = JSON.parse(marker.textContent || '{}');
      if (cfg && cfg.image && (cfg.mode === 'photo' || cfg.mode === 'both')) {
        var photo = root.querySelector('[data-announce-photo]');
        var frame = root.querySelector('[data-announce-frame]');
        if (photo) {
          var photoOnly = cfg.mode === 'photo';
          photo.onload = function () {
            root.classList.add('announce--has-photo');
            if (photoOnly) root.classList.add('announce--photo-only');
            photo.hidden = false;
          };
          photo.onerror = function () {
            // Broken/missing photo — quietly keep the text card.
            photo.hidden = true;
            root.classList.remove('announce--has-photo', 'announce--photo-only');
            if (frame) frame.hidden = false;
          };
          photo.src = cfg.image;
        }
      }
    } catch (e) { /* malformed marker — fall back to the text card */ }

    var panel = root.querySelector('.announce__panel');
    var prevFocus = null, prevOverflow = '';

    function onKey(e) {
      if (e.key === 'Escape') { close(); return; }
      if (e.key !== 'Tab') return;
      // Minimal focus trap — keep Tab inside the dialog while it's open.
      var f = panel.querySelectorAll('button, a[href]');
      if (!f.length) return;
      var first = f[0], last = f[f.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
      else if (!panel.contains(document.activeElement)) { e.preventDefault(); first.focus(); }
    }

    function open() {
      prevFocus = document.activeElement;
      prevOverflow = document.body.style.overflow;
      document.body.style.overflow = 'hidden';
      root.hidden = false;
      // Two frames so the element is laid out before the fade-in runs.
      requestAnimationFrame(function () {
        requestAnimationFrame(function () {
          root.classList.add('is-open');
          panel.focus();
        });
      });
      document.addEventListener('keydown', onKey, true);
    }

    function close() {
      document.removeEventListener('keydown', onKey, true);
      document.body.style.overflow = prevOverflow;
      root.classList.remove('is-open');
      var done = function () { root.hidden = true; };
      // Drop from the a11y tree after the fade; fall back if no transition runs.
      var t = setTimeout(done, 900);
      root.addEventListener('transitionend', function () { clearTimeout(t); done(); }, { once: true });
      if (prevFocus && prevFocus.focus) { try { prevFocus.focus(); } catch (_) {} }
    }

    root.addEventListener('click', function (e) {
      if (e.target && e.target.closest && e.target.closest('[data-announce-close]')) close();
    });

    // Let the page paint and settle first, then fade the notice in.
    setTimeout(open, 600);
  })();
</script>

<style>
  .announce {
    position: fixed;
    inset: 0;
    /* Above the consent bar (70), below the accessibility toolkit (90+). */
    z-index: 85;
    display: grid;
    place-items: center;
    padding: var(--space-m);
  }
  .announce[hidden] { display: none; }

  .announce__scrim {
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--shadow) 52%, transparent);
    opacity: 0;
    transition: opacity 0.8s var(--ease-out);
  }

  /* The card — paper with a double frame: a 1px rule edge outside and an
     inset accent hairline inside, like a letterpress invitation. No shadow;
     the scrim provides all the separation the card needs. */
  .announce__panel {
    position: relative;
    width: min(27rem, 100%);
    max-height: min(90dvh, 42rem);
    overflow: auto;
    background: var(--paper-card);
    border: 1px solid var(--rule);
    border-radius: 2px;
    padding: 10px;
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity   0.8s var(--ease-out),
      transform 0.8s var(--ease-out);
  }
  .announce__panel:focus { outline: none; }

  .announce.is-open .announce__scrim { opacity: 1; }
  .announce.is-open .announce__panel { opacity: 1; transform: translateY(0); }

  .announce__frame {
    border: 1px solid color-mix(in srgb, var(--accent) 42%, transparent);
    padding: var(--space-m) var(--space-m) calc(var(--space-m) + 0.5rem);
    text-align: center;
  }

  /* ── Photo popup ──────────────────────────────────────────────────────
     The photo sits inside the panel's paper mat (its border stays, like a
     framed print). In 'both' mode the photo tops the text card; in 'photo'
     mode it IS the popup and the text frame is hidden. */
  .announce__photo {
    display: block;
    width: 100%;
    height: auto;
    max-height: 72dvh;
    object-fit: contain;
    background: var(--paper-deep, #000);
  }
  .announce__photo[hidden] { display: none; }
  .announce--has-photo .announce__panel { width: min(30rem, 100%); }
  /* 'both' — space between the photo and the text card beneath it. */
  .announce--has-photo:not(.announce--photo-only) .announce__photo {
    margin-block-end: 10px;
  }
  /* 'photo' — no text card; the photo carries the whole popup. */
  .announce--photo-only .announce__frame { display: none; }
  /* Keep the × legible over a photo. */
  .announce--has-photo .announce__close {
    background: color-mix(in srgb, var(--shadow) 42%, transparent);
    color: var(--paper);
    border-radius: 50%;
    inline-size: 2.2rem;
    block-size: 2.2rem;
  }
  .announce--has-photo .announce__close:hover {
    background: color-mix(in srgb, var(--shadow) 60%, transparent);
    color: #fff;
  }

  /* Brand kicker — the magazine masthead voice, small caps and wide air. */
  .announce__kicker {
    margin: 0 0 var(--space-xs);
    font-size: var(--step--1);
    letter-spacing: 0.34em;
    text-indent: 0.34em;   /* re-centres tracked type */
    text-transform: uppercase;
    font-weight: 500;
    color: var(--ink-muted);
  }
  html[dir="rtl"] .announce__kicker { letter-spacing: 0.18em; text-indent: 0.18em; }

  .announce__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.018em;
    color: var(--ink);
  }

  /* Hairline · diamond · hairline — the menu-card ornament. */
  .announce__ornament {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.9rem;
    margin-block: var(--space-xs);
  }
  .announce__ornament::before,
  .announce__ornament::after {
    content: '';
    width: 2.75rem;
    height: 1px;
    background: var(--rule);
  }
  .announce__gem {
    width: 5px;
    height: 5px;
    background: var(--accent);
    transform: rotate(45deg);
  }

  .announce__body {
    margin: 0 auto;
    max-width: 40ch;
    font-size: var(--step-0);
    font-weight: 300;
    line-height: 1.75;
    color: var(--ink-soft);
  }

  /* Floats transparently just inside the frame's corner (the frame's top
     padding leaves it clear of the kicker) so neither hairline is broken. */
  .announce__close {
    position: absolute;
    inset-block-start: 0.75rem;
    inset-inline-end: 0.75rem;
    z-index: 1;
    inline-size: 2.6rem;
    block-size: 2.6rem;
    display: grid;
    place-items: center;
    font: inherit;
    font-size: var(--step-1);
    line-height: 1;
    background: transparent;
    border: none;
    color: var(--ink-muted);
    cursor: pointer;
    transition: color 0.3s var(--ease-out);
  }
  .announce__close:hover { color: var(--ink); }
  .announce__close:focus-visible { outline: 2px solid var(--accent); outline-offset: -4px; }

  @media (max-width: 600px) {
    .announce { padding: var(--space-s); }
    .announce__frame { padding: var(--space-m) var(--space-s); }
  }

  /* Camera, not interface — honour reduced motion: no lift, just a short fade. */
  @media (prefers-reduced-motion: reduce) {
    .announce__scrim,
    .announce__panel {
      transform: none;
      transition: opacity 0.2s linear;
    }
  }
</style>

---
// /events2/ — the two-venue events page: Zahara's events and the rooftop's, on
// one page, while it is being judged. UNLISTED: noindex (meta + X-Robots-Tag
// in public/_headers), out of both sitemaps (astro.config.mjs), linked from
// nowhere, and the rooftop build's copy folds into this one (public/_redirects).
// It is built from Zahara's base only; everything on it that belongs to a venue
// is a SHARED photo slot or a SHARED `events2.` copy key, so it reads the same
// whichever venue the admin has open.
//
// It is pinned to the LIGHT theme: the photographs are the reason anyone books
// an event here, and on the site's default dark they sank. The header follows
// what is under it — on-photo over the photographs, paper everywhere else —
// rather than staying dark all the way down the page.
//
// ── How it moves ──────────────────────────────────────────────────────────────
// One piece of state: `data-venue` on the root — '' while the visitor chooses,
// 'zahara' or 'rooftop' once they have. CSS does all the showing and hiding
// from that attribute; the script below only ever changes it. It is set before
// first paint by the inline script at the top of the root (so a link that
// already names a venue — ?venue=rooftop — opens on it, with no flash of the
// doors), and changed afterwards by three things that all mean "this venue":
//
//   the doors            the opening choice                (Stage.astro)
//   the header switch    Zahara | Rooftop, always in reach (Header.astro)
//   the way across       a closed door's spine on a desk, a line under the
//                        photograph on a phone             (Stage.astro)
//
// Pressing the venue ALREADY on show in the header leaves for that venue's
// home page — the switch's ordinary meaning elsewhere on the site.
//
// One button floats: "send an inquiry", down to the form. The form knows the
// venue from the page (a hidden field), and a successful send lands on the
// thank-you page (/events2/thanks/?venue=…).
//
// The address follows with ?venue=, so a venue can be linked to, reloaded and
// shared; choosing pushes one history entry (Back returns to the doors) and
// switching replaces it (Back doesn't ping-pong between the two).
//
// No JavaScript: `data-venue` is never set, and the page is simply everything
// — the doors are links down to each venue's section, and the form below.

import BaseLayout   from '../../layouts/BaseLayout.astro';
import Chrome       from '../events2/Chrome.astro';
import Stage        from '../events2/Stage.astro';
import VenueStory   from '../events2/VenueStory.astro';
import VenueGallery from '../events2/VenueGallery.astro';
import Inquiry      from '../events2/Inquiry.astro';
import { pick, events2Page } from '../../data/i18n';
import { PHOTOS } from '../../data/photos';
import { resizedSrcset, resizedMobileCoverSrcset } from '../../lib/photo';
import { DOOR_WIDTHS, DOOR_MOBILE, DOOR_QUALITY, DOOR_SIZES } from '../events2/frames';
import type { Lang } from '../../data/i18n';

export interface Props { lang: Lang }
const { lang } = Astro.props;
const t = pick(events2Page, lang);

// The first door is the LCP on every screen while the visitor chooses — the
// same exact parameters Stage.astro renders it with, or the preload is a
// second download rather than a head start.
const lcp = PHOTOS.ev2Zahara;
---

<BaseLayout title={t.pageTitle} seoTitle={t.seoTitle} description={t.pageDescription}
            lang={lang} noindex theme="light" compactConsent floatingReserve={false}
            venueSwitch={{ zahara: '#zahara', rooftop: '#rooftop', active: null }}>
  <Fragment slot="head">
    {/* data-hero-preload lets the middleware drop these when the door is a
        video on every screen — nobody should download a photo nobody sees. */}
    <link rel="preload" as="image" fetchpriority="high" data-hero-preload="ev2Zahara"
          imagesrcset={resizedMobileCoverSrcset(lcp.src, DOOR_MOBILE, DOOR_QUALITY)}
          imagesizes="100vw" media="(max-width: 600px)" />
    <link rel="preload" as="image" fetchpriority="high" data-hero-preload="ev2Zahara"
          imagesrcset={resizedSrcset(lcp.src, DOOR_WIDTHS, DOOR_QUALITY)}
          imagesizes={DOOR_SIZES} media="(min-width: 601px)" />
  </Fragment>

  <Chrome />

  <div class="ev2" data-ev2>
    {/* Runs before anything below it is parsed: the state is right on the
        very first paint, including the header above. */}
    <script is:inline>
      (function () {
        var root = document.currentScript && document.currentScript.parentElement;
        if (!root) return;
        function known(v) { return v === 'zahara' || v === 'rooftop'; }
        var url = new URL(location.href);
        var q = url.searchParams.get('venue');
        var h = url.hash.slice(1);
        var v = known(q) ? q : (known(h) ? h : '');
        root.setAttribute('data-venue', v);
        if (v) {
          // Arriving on a venue: show it open, not opening.
          root.setAttribute('data-ev2-instant', '');
          // A door opened in a new tab arrives as #venue. Trade the fragment
          // for ?venue= before the browser can scroll to it, so the page
          // opens on the venue's photograph rather than halfway down.
          if (url.hash) {
            url.hash = '';
            url.searchParams.set('venue', v);
            history.replaceState(null, '', url.href);
          }
        }
        // The header: over a photograph (a venue's hero) it takes the
        // on-photo treatment; over the title band it stays paper.
        var header = document.getElementById('site-header');
        if (header) header.classList.toggle('is-on-photo', !!v);
        // The header switch: the venue on show is lit, and — as everywhere
        // else on the site — its segment is a link to that venue's home.
        var segs = document.querySelectorAll('.site-switch [data-venue-link]');
        for (var i = 0; i < segs.length; i++) {
          var sv = segs[i].getAttribute('data-venue-link');
          var on = sv === v;
          segs[i].classList.toggle('is-active', on);
          if (on) segs[i].setAttribute('aria-current', 'true');
          else segs[i].removeAttribute('aria-current');
          var home = segs[i].getAttribute('data-venue-home');
          segs[i].setAttribute('href', on && home ? home : '#' + sv);
        }
      })();
    </script>

    <Stage lang={lang} />

    <div class="ev2-venue ev2-venue--zahara" id="zahara" data-venue-panel="zahara">
      <VenueStory lang={lang} venue="zahara" />
      <VenueGallery lang={lang} venue="zahara" />
    </div>

    <div class="ev2-venue ev2-venue--rooftop" id="rooftop" data-venue-panel="rooftop">
      <VenueStory lang={lang} venue="rooftop" />
      <VenueGallery lang={lang} venue="rooftop" />
    </div>

    <Inquiry lang={lang} />

    {/* The one floating button — down to the form. In the corner the site's
        floating Reserve pill uses elsewhere (it is off here: this page asks
        for an event, not a table). It appears once the hero is behind the
        reader and steps aside while the form is on screen. */}
    <a class="ev2-fab" href="#inquiry" data-ev2-fab data-to-form>
      <svg class="ev2-fab__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M4 5h16a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Z" />
        <path d="m3.5 6 8.5 7 8.5-7" />
      </svg>
      <span data-content-key="events2.fabLabel">{t.fabLabel}</span>
    </a>
  </div>
</BaseLayout>

<script>
  import { DOOR_SIZES_OPEN } from '../events2/frames';

  type Venue = 'zahara' | 'rooftop';
  type Via = 'door' | 'header' | 'other' | 'history';

  const root = document.querySelector<HTMLElement>('[data-ev2]');
  if (root) init(root);

  function init(root: HTMLElement) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    const isVenue = (v: unknown): v is Venue => v === 'zahara' || v === 'rooftop';
    const current = (): Venue | '' => (isVenue(root.dataset.venue) ? root.dataset.venue : '');

    const stage   = root.querySelector<HTMLElement>('[data-ev2-stage]');
    const head    = root.querySelector<HTMLElement>('[data-ev2-head]');
    const inquiry = root.querySelector<HTMLElement>('[data-ev2-inquiry]');
    const form    = root.querySelector<HTMLFormElement>('[data-ev2-form]');
    const venueIn = root.querySelector<HTMLInputElement>('[data-venue-input]');
    const fab     = root.querySelector<HTMLElement>('[data-ev2-fab]');
    const header  = document.getElementById('site-header');
    const panels: Record<Venue, HTMLElement | null> = {
      zahara:  root.querySelector('[data-venue-panel="zahara"]'),
      rooftop: root.querySelector('[data-venue-panel="rooftop"]'),
    };

    // The first frame is painted in its arrival state; from here on, every
    // change moves.
    requestAnimationFrame(() => requestAnimationFrame(() => root.removeAttribute('data-ev2-instant')));

    // ── Scrolling ────────────────────────────────────────────────────────
    // The site sets `scroll-behavior: smooth` on <html>, so a jump has to
    // step around it explicitly.
    function jumpTo(y: number) {
      const html = document.documentElement;
      const prev = html.style.scrollBehavior;
      html.style.scrollBehavior = 'auto';
      window.scrollTo(0, y);
      html.style.scrollBehavior = prev;
    }
    function glideTo(y: number) {
      if (reduce.matches) jumpTo(y);
      else window.scrollTo({ top: y, behavior: 'smooth' });
    }

    // ── The header: on-photo over photographs, paper everywhere else ─────
    // It sits over the title band while the visitor chooses (paper), over the
    // hero once a venue is open (on-photo), and over paper again once the
    // hero has scrolled away.
    function placeHeader() {
      if (!header || !stage) return;
      const hh   = header.offsetHeight;
      const box  = stage.getBoundingClientRect();
      const band = current() || !head ? 0 : head.getBoundingClientRect().height;
      const onPhoto = box.top + band <= hh / 2 && box.bottom > hh;
      header.classList.toggle('is-on-photo', onPhoto);
    }

    // ── Everything outside the stage that shows the venue ────────────────
    function syncChrome(v: Venue | '') {
      document.querySelectorAll<HTMLAnchorElement>('.site-switch [data-venue-link]').forEach((a) => {
        const on = a.dataset.venueLink === v;
        a.classList.toggle('is-active', on);
        if (on) a.setAttribute('aria-current', 'true');
        else a.removeAttribute('aria-current');
        // The venue on show links to its home; the other, to its own events.
        a.setAttribute('href', on && a.dataset.venueHome ? a.dataset.venueHome : `#${a.dataset.venueLink}`);
      });
      // The form asks no "where": the venue on show rides along with it.
      if (venueIn) venueIn.value = v;
      // The open door fills the screen now: let it fetch the cut for that.
      // Only ever widened — narrowing it back would just be a second download
      // of a smaller copy of a picture the browser already has.
      if (v) {
        const img = root.querySelector<HTMLImageElement>(`[data-door="${v}"] [data-door-img]`);
        if (img && img.sizes !== DOOR_SIZES_OPEN) img.sizes = DOOR_SIZES_OPEN;
      }
    }

    // Motion revealed everything inside the hidden venues at boot — a hidden
    // element sits at the very top of the page as far as layout knows — so a
    // venue that opens later would appear already settled. Put its reveals
    // back to waiting; they rise into view like the rest of the site.
    function rearm(panel: HTMLElement) {
      const arm = (window as unknown as { __zaharaArmReveals?: (el: Element) => void }).__zaharaArmReveals;
      if (typeof arm !== 'function') return;
      const els = Array.from(panel.querySelectorAll<HTMLElement>('.reveal-on-scroll, .stagger'));
      els.forEach((el) => el.classList.remove('is-in-view'));
      arm(panel);
      // Motion holds anything in the bottom 8% of the screen until it is
      // scrolled further in — wrong here: the top of the venue that just
      // opened is exactly what peeks out under the photograph. Whatever is
      // already on screen rises now.
      requestAnimationFrame(() => {
        const fold = window.innerHeight;
        els.forEach((el) => {
          if (el.getBoundingClientRect().top < fold) {
            el.classList.remove('reveal--off');
            el.classList.add('is-in-view');
          }
        });
      });
    }

    // While choosing, the title band takes whatever height its words need
    // (`auto`). `auto` doesn't animate, so before the stage MOVES the band's
    // height is pinned (--head-h, .is-measured) — the tracks are then explicit
    // on both sides of the change and slide. Back at the doors, it lets go
    // again once the move has finished, so a later resize can't clip it.
    function pinHead() {
      if (!stage || !head) return;
      stage.style.setProperty('--head-h', `${head.scrollHeight}px`);
      stage.classList.add('is-measured');
    }
    stage?.addEventListener('transitionend', (e) => {
      if (e.target === stage && !current()) stage.classList.remove('is-measured');
    });
    window.addEventListener('resize', () => {
      if (stage && !current()) stage.classList.remove('is-measured');
    }, { passive: true });

    // ── The state change ─────────────────────────────────────────────────
    function setVenue(v: Venue | '', via: Via) {
      const was = current();
      if (v === was) {
        if (v) glideTo(0);
        return;
      }

      const apply = () => {
        if (!was || !v) {
          // The band is about to fold away (or come back): pin it first, and
          // let the pinned height take effect before the state changes.
          pinHead();
          if (stage) void stage.offsetHeight;
        }
        root.dataset.venue = v;
        syncChrome(v);
        placeHeader();
        if (!v) return;
        const panel = panels[v];
        if (panel) rearm(panel);
        confirmOptionalFrames();
        updateRails();
      };

      const deep = stage ? window.scrollY > stage.offsetHeight * 0.6 : false;
      if (fab) fab.classList.remove('is-visible');
      if (was && v && deep && !reduce.matches) {
        // Deep inside one venue: a short fade, a cut to the top, and the other
        // venue fades in with its photograph still panning across.
        root.classList.add('is-leaving');
        window.setTimeout(() => {
          apply();
          jumpTo(0);
          requestAnimationFrame(() => root.classList.remove('is-leaving'));
        }, 260);
      } else {
        apply();
        if (window.scrollY > 0) glideTo(0);
      }

      // The address: ?venue=, and one history entry per visit to the doors.
      if (via !== 'history') {
        const url = new URL(window.location.href);
        url.hash = '';
        if (v) url.searchParams.set('venue', v); else url.searchParams.delete('venue');
        if (!was && v) history.pushState({ ev2: v }, '', url.href);
        else history.replaceState({ ev2: v }, '', url.href);
      }

      // A door was the thing focused, and it has just stopped being a link:
      // carry keyboard focus into the venue that opened, without scrolling.
      if (via === 'door' && v) {
        const title = document.getElementById(`ev2-${v}-title`);
        if (title) requestAnimationFrame(() => title.focus({ preventScroll: true }));
      }

      track(v, via);
    }

    // ── What asks for a venue ────────────────────────────────────────────
    document.addEventListener('click', (e) => {
      const target = e.target as Element | null;
      const a = target && target.closest ? target.closest<HTMLAnchorElement>('[data-venue-link]') : null;
      if (!a) return;
      // A modified click is someone opening it in a new tab — let it.
      if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      const v = a.dataset.venueLink;
      if (!isVenue(v)) return;
      const via = (a.dataset.venueVia as Via) || 'header';
      // The header's segment for the venue ALREADY on show is a request for
      // the venue itself: its href is that venue's home page (syncChrome), so
      // the browser simply follows it. (While still choosing, neither segment
      // is "on show" — both choose.)
      if (via === 'header' && v === current() && a.dataset.venueHome) return;
      e.preventDefault();
      setVenue(v, via);
    });

    window.addEventListener('popstate', () => {
      const q = new URL(window.location.href).searchParams.get('venue');
      setVenue(isVenue(q) ? q : '', 'history');
    });

    // "Send an inquiry" (the floating button) and "to the inquiry form" (under
    // the facts) — down to the form, without writing #inquiry into the
    // address, and focus on its heading so the next Tab is the first field.
    root.querySelectorAll<HTMLAnchorElement>('[data-to-form]').forEach((a) => a.addEventListener('click', (e) => {
      if (!inquiry || !current()) return;
      e.preventDefault();
      const top = inquiry.getBoundingClientRect().top + window.scrollY;
      // On a desk the form's half starts level with the photograph; on a phone
      // the heading wants to sit just under the header.
      const offset = window.innerWidth >= 1000 ? 0 : (header ? header.offsetHeight : 0);
      glideTo(top - offset);
      const heading = document.getElementById('ev2-form-title');
      if (heading) heading.focus({ preventScroll: true });
    }));

    // ── Scroll-driven bits: the header, and the floating button ──────────
    let queued = false;
    function onScroll() {
      queued = false;
      placeHeader();
      if (fab && stage) {
        // Not over the form (there it would ride on top of a phone's keyboard,
        // over the very field being typed in) and not before the hero is
        // behind the reader.
        const box = inquiry ? inquiry.getBoundingClientRect() : null;
        const atForm = !!box && box.top < window.innerHeight * 0.75 && box.bottom > 0;
        const on = !!current() && !atForm && window.scrollY > stage.offsetHeight * 0.6;
        fab.classList.toggle('is-visible', on);
      }
    }
    window.addEventListener('scroll', () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(onScroll);
    }, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });

    // ── The galleries ────────────────────────────────────────────────────
    const railStates = Array.from(root.querySelectorAll<HTMLElement>('[data-ev2-gallery]')).map(setupRail);
    function updateRails() { requestAnimationFrame(() => railStates.forEach((s) => s())); }

    function setupRail(section: HTMLElement) {
      const rail  = section.querySelector<HTMLElement>('[data-rail]');
      // Two sets of arrows — at the heading on a desk, under the rail on a
      // phone — and CSS shows the one that fits. Both drive the same rail.
      const navs  = Array.from(section.querySelectorAll<HTMLElement>('[data-rail-nav]'));
      const btns  = Array.from(section.querySelectorAll<HTMLButtonElement>('[data-rail-step]'));
      const pos   = Array.from(section.querySelectorAll<HTMLElement>('[data-rail-pos]'));
      const total = Array.from(section.querySelectorAll<HTMLElement>('[data-rail-total]'));
      if (!rail || !navs.length) return () => {};
      const rtl = () => getComputedStyle(rail).direction === 'rtl';
      const frames = () => Array.from(rail.querySelectorAll<HTMLElement>('[data-frame]:not([hidden])'));

      function state() {
        if (!rail) return;
        const max = rail.scrollWidth - rail.clientWidth;
        navs.forEach((n) => { n.hidden = max <= 4; });
        // RTL scrollers count from 0 towards the negative.
        const at = Math.abs(rail.scrollLeft);
        btns.forEach((b) => {
          b.disabled = Number(b.dataset.railStep) < 0 ? at <= 2 : at >= max - 2;
        });
        // Where you are: the frame nearest the middle of the rail (on a
        // phone, the centred one).
        const list = frames();
        const box  = rail.getBoundingClientRect();
        const mid  = box.left + box.width / 2;
        let best = 0;
        let bestDist = Infinity;
        list.forEach((f, i) => {
          const r = f.getBoundingClientRect();
          const d = Math.abs(r.left + r.width / 2 - mid);
          if (d < bestDist) { bestDist = d; best = i; }
        });
        pos.forEach((el) => { el.textContent = String(best + 1); });
        total.forEach((el) => { el.textContent = String(list.length); });
      }
      btns.forEach((b) => b.addEventListener('click', () => {
        const frame = frames()[0];
        const gap   = parseFloat(getComputedStyle(rail).columnGap) || 0;
        const step  = frame ? frame.getBoundingClientRect().width + gap : rail.clientWidth * 0.8;
        rail.scrollBy({
          left: Number(b.dataset.railStep) * step * (rtl() ? -1 : 1),
          behavior: reduce.matches ? 'auto' : 'smooth',
        });
      }));
      let railQueued = false;
      rail.addEventListener('scroll', () => {
        if (railQueued) return;
        railQueued = true;
        requestAnimationFrame(() => { railQueued = false; state(); });
      }, { passive: true });
      window.addEventListener('resize', state, { passive: true });
      return state;
    }

    // Frames 5–8 ship empty. Ask once which of them hold a photograph (or a
    // clip) before fetching any of them — the same answer the home gallery
    // uses — and only when a venue is actually on show.
    let asked = false;
    function confirmOptionalFrames() {
      if (asked) return;
      asked = true;
      const optional = Array.from(root.querySelectorAll<HTMLElement>('[data-frame][data-optional]'));
      if (!optional.length) return;
      const videoKind = (el: HTMLElement) =>
        el.querySelector<HTMLElement>('[data-media-slot]')?.dataset.mediaIsVideo || '';
      fetch('/api/gallery', { headers: { Accept: 'application/json' } })
        .then((r) => (r.ok ? r.json() : { filenames: [] }))
        .then((data: { filenames?: string[] }) => {
          const have = new Set(data && data.filenames ? data.filenames : []);
          optional.forEach((el) => {
            const kind = videoKind(el);
            if (!have.has(el.dataset.filename || '') && !kind) { el.remove(); return; }
            el.hidden = false;
            if (kind === '1') return;          // a clip on every screen fills it
            const img = el.querySelector<HTMLImageElement>('img[data-src]');
            if (!img) return;
            // If the file turns out not to be servable after all, take the
            // frame back out rather than leave a broken image in the rail.
            img.addEventListener('error', () => {
              if (kind) img.remove(); else el.remove();
              updateRails();
            }, { once: true });
            if (img.dataset.srcset) img.srcset = img.dataset.srcset;
            img.src = img.dataset.src || '';
          });
          updateRails();
        })
        .catch(() => { /* leave them out rather than risk a broken frame */ });
    }

    // ── Analytics — the same dataLayer shim the rest of the site uses, so it
    // queues before the tag loads and respects Consent Mode. ──────────────
    function gtag(..._args: unknown[]) {
      const w = window as unknown as { dataLayer?: unknown[] };
      w.dataLayer = w.dataLayer || [];
      // The Arguments object itself, not an array — gtag.js reads it that way.
      w.dataLayer.push(arguments);
    }
    function track(v: Venue | '', via: Via) {
      if (!v || via === 'history') return;
      try { gtag('event', 'events2_venue', { venue: v, via }); } catch { /* never break the page */ }
    }

    // ── The form ─────────────────────────────────────────────────────────
    if (form) setupForm(form);

    function setupForm(form: HTMLFormElement) {
      const status = form.querySelector<HTMLElement>('[data-ev2-status]');
      const submit = form.querySelector<HTMLButtonElement>('[data-ev2-submit]');
      const msg = {
        sending:  form.dataset.msgSending  || '',
        network:  form.dataset.msgNetwork  || '',
        general:  form.dataset.msgGeneral  || '',
        email:    form.dataset.msgEmail    || '',
        required: form.dataset.msgRequired || '',
      };

      // Fixing a field clears its mark at once.
      form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input, textarea').forEach((el) => {
        const clear = () => el.classList.remove('is-invalid');
        el.addEventListener('input', clear);
        el.addEventListener('change', clear);
      });

      function say(text: string, err: boolean) {
        if (!status) return;
        status.textContent = text;
        status.className = err ? 'form-status err' : 'form-status';
      }

      // Turnstile is fetched late (Inquiry.astro), so a fast send — autofill,
      // then straight to the button — can beat its token. Wait for it rather
      // than lose a real enquiry to "verification failed"; post anyway after
      // a while and let the server decide.
      function waitForTurnstile(): Promise<void> {
        if (!form.querySelector('.cf-turnstile')) return Promise.resolve();
        const token = () =>
          (form.querySelector<HTMLInputElement>('[name="cf-turnstile-response"]') || { value: '' }).value;
        if (token()) return Promise.resolve();
        try {
          (window as unknown as { __zaharaLoadTurnstile?: () => void }).__zaharaLoadTurnstile?.();
        } catch { /* not on this page */ }
        return new Promise((resolve) => {
          const started = Date.now();
          const tick = () => {
            if (token() || Date.now() - started > 8000) resolve();
            else window.setTimeout(tick, 150);
          };
          tick();
        });
      }

      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        // Every field in one pass, every offender marked. The server checks
        // it all again; this is the fast, visible layer.
        const invalid: (HTMLInputElement | HTMLTextAreaElement)[] = [];
        form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input, textarea').forEach((el) => {
          const type = el.getAttribute('type') || '';
          if (type === 'hidden' || el.disabled) return;
          if (el.closest('.visually-hidden')) return;
          el.classList.remove('is-invalid');
          let bad = !el.checkValidity();
          if (type === 'email' && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(el.value.trim())) bad = true;
          if (bad) { invalid.push(el); el.classList.add('is-invalid'); }
        });
        if (invalid.length) {
          const onlyEmail = invalid.length === 1 && invalid[0].getAttribute('type') === 'email' && invalid[0].value.trim();
          say(onlyEmail ? msg.email : msg.required, true);
          invalid[0].focus();
          return;
        }

        say(msg.sending, false);
        if (submit) submit.disabled = true;
        await waitForTurnstile();

        try {
          const res = await fetch('/api/contact', { method: 'POST', body: new FormData(form) });
          if (res.ok) {
            const venue = venueIn ? venueIn.value : '';
            // A SUCCESSFUL send — unlike GA4's own form_submit, which counts
            // the attempt.
            try {
              gtag('event', 'contact_form_submit', {
                inquiry_type: 'event', page_lang: form.dataset.lang || '', venue,
              });
            } catch { /* analytics must never break the form */ }
            // The thank-you page, showing the venue that was asked about. A
            // beat's pause lets the event above leave before the page does.
            const to = new URL(form.dataset.thanks || '/events2/thanks/', window.location.origin);
            if (venue) to.searchParams.set('venue', venue);
            window.setTimeout(() => { window.location.assign(to.href); }, 150);
          } else {
            say((await res.text()) || msg.general, true);
            if (submit) submit.disabled = false;
          }
        } catch {
          say(msg.network, true);
          if (submit) submit.disabled = false;
        }
      });
    }

    // Arrived with a venue already open (a shared link, a reload). The inline
    // script above could set the state and the header, but the form below it
    // had not been parsed yet — bring its hidden venue (and the open door's
    // full-width cut) in step now, or an enquiry sent from a rooftop link
    // would go out labelled for no venue at all.
    syncChrome(current());
    placeHeader();
    // …and its extra frames and rail arrows need the same start a choice
    // would give them.
    if (current()) {
      confirmOptionalFrames();
      if (document.readyState === 'complete') updateRails();
      else window.addEventListener('load', updateRails, { once: true });
    }
  }
</script>

